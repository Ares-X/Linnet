#!/usr/bin/env bash

# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

user_home="${HOME:-}"
app_path="${user_home}/Library/Input Methods/Linnet.app"
support_root="${user_home}/Library/Application Support/Linnet"
preferences_root="${user_home}/Library/Preferences"
host_bundle_id="io.github.ares-x.inputmethod.Linnet"
settings_bundle_id="${host_bundle_id}.settings"
receipts=(
  io.github.ares-x.inputmethod.Linnet.update.core.pkg
  io.github.ares-x.inputmethod.Linnet.complete.core.pkg
  io.github.ares-x.inputmethod.Linnet.complete.data.chinese.pkg
  io.github.ares-x.inputmethod.Linnet.complete.data.english.pkg
  io.github.ares-x.inputmethod.Linnet.complete.data.lts.pkg
  io.github.ares-x.inputmethod.Linnet.complete.data.extended.pkg
  io.github.ares-x.inputmethod.Linnet.complete.profile.pkg
  # Shipped payload receipts are retired from installers, not forgotten during
  # an upgrade. Uninstall still removes their current-user bookkeeping.
  io.github.ares-x.inputmethod.Linnet.core.pkg
  io.github.ares-x.inputmethod.Linnet.data.chinese.pkg
  io.github.ares-x.inputmethod.Linnet.data.english.pkg
  io.github.ares-x.inputmethod.Linnet.data.lts.pkg
  io.github.ares-x.inputmethod.Linnet.data.extended.pkg
  io.github.ares-x.inputmethod.Linnet.profile.pkg
)
generated_names=(Data Runtime Build Downloads State Profiles)
purge_user_data=0
print_plan=0
current_uid="$(/usr/bin/id -u)"

usage() {
  cat <<'EOF'
Usage: uninstall-linnet [--purge-user-data] [--print-plan]

By default Linnet removes the user-level App, immutable language packs,
generated runtime/build data and Installer receipts. Personal dictionaries,
learning, verified backups and preferences remain for a later reinstall.

  --purge-user-data  also erase all Linnet-owned persistent user data
  --print-plan       print exact targets without changing the user account
EOF
}

require_owned_directory_boundary() {
  local path="$1"
  local label="$2"
  if [[ -L "${path}" || ( -e "${path}" && ! -d "${path}" ) ]]; then
    echo "Uninstall Linnet: unsafe ${label}" >&2
    exit 1
  fi
}

require_recursive_delete_target() {
  local path="$1"
  local parent="$2"
  local label="$3"
  local identity owner device parent_identity parent_owner parent_device
  require_owned_directory_boundary "${parent}" "${label} parent"
  require_owned_directory_boundary "${path}" "${label}"
  [[ -e "${path}" ]] || return 0
  [[ -d "${parent}" && ! -L "${parent}" ]] || {
    echo "Uninstall Linnet: ${label} parent is unavailable" >&2
    return 1
  }
  identity="$(/usr/bin/stat -f '%u %d' "${path}")" || {
    echo "Uninstall Linnet: cannot inspect ${label}" >&2
    return 1
  }
  parent_identity="$(/usr/bin/stat -f '%u %d' "${parent}")" || {
    echo "Uninstall Linnet: cannot inspect ${label} parent" >&2
    return 1
  }
  read -r owner device <<<"${identity}"
  read -r parent_owner parent_device <<<"${parent_identity}"
  [[ "${owner}" == "${current_uid}" && "${parent_owner}" == "${current_uid}" && \
    "${device}" == "${parent_device}" ]] || {
    echo "Uninstall Linnet: unsafe filesystem boundary for ${label}" >&2
    return 1
  }
}

require_owned_preferences_boundary() {
  require_owned_directory_boundary "${preferences_root}" "Preferences directory"
  if [[ -e "${preferences_root}" && \
    "$(/usr/bin/stat -f '%u' "${preferences_root}")" != "${current_uid}" ]]; then
    echo "Uninstall Linnet: Preferences directory is not owned by the current user" >&2
    return 1
  fi
}

require_owned_preference_file_boundary() {
  local path="$1"
  if [[ -L "${path}" || ( -e "${path}" && ! -f "${path}" ) ]]; then
    echo "Uninstall Linnet: unsafe preference file" >&2
    return 1
  fi
  if [[ -e "${path}" && \
    "$(/usr/bin/stat -f '%u' "${path}")" != "${current_uid}" ]]; then
    echo "Uninstall Linnet: preference file is not owned by the current user" >&2
    return 1
  fi
}

purge_preference_domain() {
  local domain="$1"
  local path="${preferences_root}/${domain}.plist"
  case "${domain}" in
    "${host_bundle_id}"|"${settings_bundle_id}") ;;
    *) return 1 ;;
  esac
  require_owned_preferences_boundary
  require_owned_preference_file_boundary "${path}"
  if /usr/bin/defaults read "${domain}" >/dev/null 2>&1; then
    /usr/bin/defaults delete "${domain}" >/dev/null 2>&1 || {
      echo "Uninstall Linnet: cannot erase preference domain" >&2
      return 1
    }
  else
    /usr/bin/defaults delete "${domain}" >/dev/null 2>&1 || true
  fi
  # CFPreferences materializes an empty plist tombstone after a successful
  # domain delete. The uninstaller owns this exact current-user residue too.
  require_owned_preferences_boundary
  require_owned_preference_file_boundary "${path}"
  if [[ -e "${path}" ]]; then
    /bin/rm -- "${path}"
  fi
  [[ ! -e "${path}" && ! -L "${path}" ]] || {
    echo "Uninstall Linnet: preference residue remains" >&2
    return 1
  }
}

make_owned_tree_removable() {
  local path="$1"
  local parent="$2"
  local label="$3"
  local root_identity root_owner root_device
  require_recursive_delete_target "${path}" "${parent}" "${label}"
  root_identity="$(/usr/bin/stat -f '%u %d' "${path}")" || {
    echo "Uninstall Linnet: cannot inspect ${label}" >&2
    return 1
  }
  read -r root_owner root_device <<<"${root_identity}"
  [[ "${root_owner}" == "${current_uid}" ]] || {
    echo "Uninstall Linnet: ${label} is not owned by the current user" >&2
    return 1
  }

  # Published pack identities are intentionally 0555/0444. Restore write
  # access only on real, current-user-owned directories in this filesystem;
  # -P, -x and chmod -h keep nested links and mounted trees non-authoritative.
  /usr/bin/find -P -x "${path}" -type d -print0 | while IFS= read -r -d '' directory; do
    local identity owner device
    identity="$(/usr/bin/stat -f '%u %d' "${directory}")" || exit 1
    read -r owner device <<<"${identity}"
    if [[ "${owner}" != "${current_uid}" || "${device}" != "${root_device}" ]]; then
      echo "Uninstall Linnet: unsafe directory in ${label}" >&2
      exit 1
    fi
    /bin/chmod -h u+wx "${directory}"
  done
}

product_process_state() {
  local host_path="$1"
  local settings_path="$2"
  local commands
  commands="$(/bin/ps -axo command=)" || return 2
  /usr/bin/awk -v host="${host_path}" -v settings="${settings_path}" '
    {
      command = $0
      sub(/^[[:space:]]+/, "", command)
      if (command == host || index(command, host " ") == 1 ||
          command == settings || index(command, settings " ") == 1) {
        found = 1
      }
    }
    END { exit(found ? 0 : 1) }
  ' <<<"${commands}"
}

require_product_processes_absent() {
  local host_path="$1"
  local settings_path="$2"
  if product_process_state "${host_path}" "${settings_path}"; then
    echo "Uninstall Linnet: Linnet is still running. Switch to another input source, sign out and back in, then rerun the uninstaller." >&2
    return 1
  else
    local process_status=$?
    if [[ "${process_status}" != 1 ]]; then
      echo "Uninstall Linnet: running product processes could not be inspected" >&2
      return 1
    fi
  fi
}

while (( "$#" > 0 )); do
  case "$1" in
    --purge-user-data) purge_user_data=1 ;;
    --print-plan) print_plan=1 ;;
    --help|-h) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

[[ "${user_home}" == /* && -d "${user_home}" && ! -L "${user_home}" ]] || {
  echo "Uninstall Linnet: current user home is unavailable" >&2
  exit 1
}
[[ "${app_path}" == "${user_home}/Library/Input Methods/Linnet.app" ]] || exit 1
[[ "${support_root}" == "${user_home}/Library/Application Support/Linnet" ]] || exit 1

echo "Remove App: ${app_path}"
echo "Remove immutable data: ${support_root}/Data"
echo "Remove active runtime: ${support_root}/Runtime"
echo "Remove generated build data: ${support_root}/Build"
echo "Remove update downloads: ${support_root}/Downloads"
echo "Remove active-state pointer: ${support_root}/State"
echo "Remove generated profiles: ${support_root}/Profiles"
for receipt in "${receipts[@]}"; do
  echo "Forget receipt if present: ${receipt}"
done
if (( purge_user_data )); then
  echo "Erase all remaining Linnet data: ${support_root}"
  echo "Erase preferences: ${host_bundle_id}, ${settings_bundle_id}"
else
  echo "Keep personal data if present: ${support_root}/UserData"
  echo "Keep backups if present: ${support_root}/Backups"
  echo "Keep transactions if present: ${support_root}/Transactions"
  echo "Keep preferences: ${host_bundle_id}, ${settings_bundle_id}"
fi
(( print_plan == 0 )) || exit 0

# Never traverse a replaced user-owned directory while deleting Linnet data.
# Missing directories are valid for a partial or already-completed uninstall;
# every existing component in the mutation chain must be a real directory.
require_owned_directory_boundary "${user_home}/Library" "Library directory"
require_owned_directory_boundary "${user_home}/Library/Input Methods" "Input Methods directory"
require_owned_directory_boundary "${user_home}/Library/Application Support" "Application Support directory"
require_owned_directory_boundary "${app_path}" "App path"
require_owned_directory_boundary "${support_root}" "Application Support root"
if (( purge_user_data )); then
  require_owned_preferences_boundary
  for preference_domain in "${host_bundle_id}" "${settings_bundle_id}"; do
    require_owned_preference_file_boundary \
      "${preferences_root}/${preference_domain}.plist"
  done
fi

# Validate every recursive mutation root before changing the App, receipts,
# generated data, preferences or temporary logs. `-x` below protects nested
# traversal; this preflight separately rejects a target that is itself a mount.
require_recursive_delete_target \
  "${app_path}" "${user_home}/Library/Input Methods" "App path"
require_recursive_delete_target \
  "${support_root}" "${user_home}/Library/Application Support" \
  "Application Support root"
for generated_name in "${generated_names[@]}"; do
  generated_path="${support_root}/${generated_name}"
  [[ "${generated_path}" == "${support_root}/"* ]] || exit 1
  require_recursive_delete_target \
    "${generated_path}" "${support_root}" "generated ${generated_name} path"
done
removal_requires_quiescence=0
[[ -e "${app_path}" ]] && removal_requires_quiescence=1
for generated_name in "${generated_names[@]}"; do
  [[ -e "${support_root}/${generated_name}" ]] && removal_requires_quiescence=1
done
if (( purge_user_data )); then
  if [[ -e "${support_root}" ]] || \
    /usr/bin/defaults read "${host_bundle_id}" >/dev/null 2>&1 || \
    /usr/bin/defaults read "${settings_bundle_id}" >/dev/null 2>&1; then
    removal_requires_quiescence=1
  fi
fi

host_cli="${app_path}/Contents/MacOS/Linnet"
settings_cli="${app_path}/Contents/Applications/Settings.app/Contents/MacOS/Settings"
if (( removal_requires_quiescence )); then
  # User-owned installed bytes are never executable authority for their own
  # deletion. The exact process paths must already be absent.
  require_product_processes_absent "${host_cli}" "${settings_cli}"
fi
if [[ -e "${app_path}" || -L "${app_path}" ]]; then
  require_recursive_delete_target \
    "${app_path}" "${user_home}/Library/Input Methods" "App path"
  /bin/rm -rf -x -- "${app_path}"
fi
for receipt in "${receipts[@]}"; do
  if /usr/sbin/pkgutil --volume "${user_home}" --pkg-info "${receipt}" >/dev/null 2>&1; then
    /usr/sbin/pkgutil --volume "${user_home}" --forget "${receipt}" >/dev/null
  fi
done

for generated_name in "${generated_names[@]}"; do
  generated_path="${support_root}/${generated_name}"
  [[ "${generated_path}" == "${support_root}/"* ]] || exit 1
  require_owned_directory_boundary "${generated_path}" "generated ${generated_name} path"
  if [[ -e "${generated_path}" ]]; then
    make_owned_tree_removable \
      "${generated_path}" "${support_root}" "generated ${generated_name} tree"
    require_recursive_delete_target \
      "${generated_path}" "${support_root}" "generated ${generated_name} path"
    /bin/rm -rf -x -- "${generated_path}"
  fi
done

if (( purge_user_data )); then
  if [[ -e "${support_root}" ]]; then
    make_owned_tree_removable \
      "${support_root}" "${user_home}/Library/Application Support" \
      "Application Support tree"
    require_recursive_delete_target \
      "${support_root}" "${user_home}/Library/Application Support" \
      "Application Support root"
    /bin/rm -rf -x -- "${support_root}"
  fi
  for preference_domain in "${host_bundle_id}" "${settings_bundle_id}"; do
    purge_preference_domain "${preference_domain}"
  done
fi

echo "Linnet has been uninstalled for this user. Sign out and back in to refresh input sources."
