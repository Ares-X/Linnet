#!/usr/bin/env bash

# SPDX-License-Identifier: GPL-3.0-or-later

# GitHub Action publication owner. The candidate Action has already built,
# signed, verified and staged the exact bytes in GitHub Releases; the
# maintainer Mac can only authorize that remote byte set after installed UAT.
# This script verifies GitHub's SHA-256 identities, advances the Catalog, and
# publishes without downloading large assets. Its explicit data-seed mode
# bootstraps a future locked LTS pack without exposing a Catalog.

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
mode="${1:-}"
version="${2:-}"
catalog_sequence="${3:-}"
candidate_revision="${4:-}"
publication_authorization="${5:-}"
repository="${GITHUB_REPOSITORY:-}"

fail_publish() {
  echo "publish_github_release: $*" >&2
  exit 1
}

[[ "$#" -eq 5 &&
   ( "${mode}" == verify || "${mode}" == preview ||
     "${mode}" == publish || "${mode}" == data-seed ) ]] ||
  fail_publish "usage: {verify|preview|publish|data-seed} VERSION CATALOG_SEQUENCE CANDIDATE_REVISION AUTHORIZATION_TAG"
[[ "${mode}" == verify || "${GITHUB_ACTIONS:-}" == true ]] ||
  fail_publish "public release mutation is owned by GitHub Actions"
[[ "${repository}" == Ares-X/Linnet ]] ||
  fail_publish "GITHUB_REPOSITORY must be Ares-X/Linnet"
[[ "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
  fail_publish "product version is invalid"
[[ "${catalog_sequence}" =~ ^[1-9][0-9]*$ ]] ||
  fail_publish "Catalog sequence is invalid"
[[ "${candidate_revision}" =~ ^[0-9a-f]{40}$ ]] ||
  fail_publish "candidate revision is invalid"
[[ "$(git -C "${project_root}" rev-parse --verify HEAD^{commit})" == \
  "${candidate_revision}" ]] || fail_publish "candidate checkout differs"
command -v gh >/dev/null 2>&1 || fail_publish "gh is unavailable"
command -v ruby >/dev/null 2>&1 || fail_publish "ruby is unavailable"

authorized_digest=""
if [[ "${mode}" == data-seed ]]; then
  authorization_pattern='^linnet-data-seed/v([0-9]+\.[0-9]+\.[0-9]+)-([1-9][0-9]*)-([0-9a-f]{40})$'
  [[ "${publication_authorization}" =~ ${authorization_pattern} ]] ||
    fail_publish "data-seed authorization tag is invalid"
  [[ "${BASH_REMATCH[1]}" == "${version}" &&
     "${BASH_REMATCH[2]}" == "${catalog_sequence}" &&
     "${BASH_REMATCH[3]}" == "${candidate_revision}" ]] ||
    fail_publish "data-seed authorization differs from candidate identity"
else
  if [[ "${mode}" == preview ]]; then
    authorization_pattern='^linnet-preview/v([0-9]+\.[0-9]+\.[0-9]+)-([0-9a-f]{40})-h([0-9a-f]{64})$'
  else
    authorization_pattern='^linnet-publication/v([0-9]+\.[0-9]+\.[0-9]+)-([0-9a-f]{40})-h([0-9a-f]{64})$'
  fi
  [[ "${publication_authorization}" =~ ${authorization_pattern} ]] ||
    fail_publish "publication authorization tag is invalid"
  [[ "${BASH_REMATCH[1]}" == "${version}" &&
     "${BASH_REMATCH[2]}" == "${candidate_revision}" ]] ||
    fail_publish "publication authorization differs from candidate identity"
  authorized_digest="${BASH_REMATCH[3]}"
fi

work_root="$(mktemp -d "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/linnet-action-publication.XXXXXX")"
cleanup() {
  if [[ "${work_root}" == \
      "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/linnet-action-publication."* ]]; then
    find "${work_root}" -depth -delete 2>/dev/null || true
  fi
}
trap cleanup EXIT INT TERM HUP

verify_tag_revision() {
  local requested_tag="$1"
  local expected_revision="${2-${candidate_revision}}"
  local tag_record
  tag_record="$(gh api "repos/${repository}/git/ref/tags/${requested_tag}" \
    --jq '[.object.type, .object.sha] | @tsv')" ||
    fail_publish "${requested_tag} tag is unavailable"
  [[ "${tag_record}" =~ ^commit$'\t'[0-9a-f]{40}$ ]] ||
    fail_publish "${requested_tag} tag is not a direct commit identity"
  if [[ -n "${expected_revision}" &&
        "${tag_record}" != commit$'\t'"${expected_revision}" ]]; then
    fail_publish "${requested_tag} tag does not resolve directly to the candidate"
  fi
}

verify_tag_revision "${publication_authorization}"

channel_tag() {
  case "$1" in
    core) printf 'core-v%s\n' "${version}" ;;
    data) printf 'data-%s\n' "${catalog_sequence}" ;;
    public) printf 'v%s\n' "${version}" ;;
    *) return 2 ;;
  esac
}

channel_prerelease() {
  case "$1" in core|data) echo true ;; public) echo false ;; *) return 2 ;; esac
}

load_and_verify_release() {
  local channel="$1"
  local tag expected_prerelease json expected actual
  tag="$(channel_tag "${channel}")"
  expected_prerelease="$(channel_prerelease "${channel}")"
  json="${work_root}/${channel}.json"
  expected="${work_root}/${channel}-expected-names"
  actual="${work_root}/${channel}-assets.tsv"

  gh release view "${tag}" --repo "${repository}" \
    --json databaseId,isDraft,isPrerelease,tagName,targetCommitish,assets \
    >"${json}" || fail_publish "${tag} staged Release is unavailable"
  "${project_root}/package/release_asset_manifest" \
    "${channel}" "${version}" "${catalog_sequence}" >"${expected}"

  ruby -rjson -e '
    release = JSON.parse(File.binread(ARGV.fetch(0)))
    tag, revision, prerelease, expected_path, output, channel = ARGV.drop(1)
    abort unless release.fetch("tagName") == tag
    abort unless release.fetch("isPrerelease") == (prerelease == "true")
    if release.fetch("isDraft")
      target = release.fetch("targetCommitish")
      abort unless target.match?(/\A[0-9a-f]{40}\z/) && target != "0" * 40
      abort unless channel == "data" || target == revision
    end
    expected = File.readlines(expected_path, chomp: true).reject(&:empty?).sort
    assets = release.fetch("assets")
    names = assets.map { |asset| asset.fetch("name") }
    abort unless names.sort == expected && names.uniq == names
    rows = assets.map do |asset|
      digest = asset.fetch("digest")
      size = asset.fetch("size")
      abort unless digest&.match?(/\Asha256:[0-9a-f]{64}\z/) &&
        size.is_a?(Integer) && size.positive?
      [asset.fetch("name"), digest, size]
    end.sort
    File.open(output, "wb") do |file|
      rows.each { |row| file.puts(row.join("\t")) }
    end
  ' "${json}" "${tag}" "${candidate_revision}" "${expected_prerelease}" \
    "${expected}" "${actual}" "${channel}" ||
    fail_publish "${tag} draft metadata or asset identity is invalid"

  if [[ "$(ruby -rjson -e 'puts JSON.parse(File.binread(ARGV.fetch(0))).fetch("isDraft")' \
      "${json}")" == false ]]; then
    if [[ "${channel}" == data ]]; then
      verify_tag_revision "${tag}" ""
    else
      verify_tag_revision "${tag}"
    fi
  fi
}

if [[ "${mode}" == data-seed ]]; then
  load_and_verify_release data
else
  for channel in core data public; do
    load_and_verify_release "${channel}"
  done

  candidate_manifest="${work_root}/candidate.tsv"
  cut -f1,2 "${work_root}/core-assets.tsv" \
    "${work_root}/data-assets.tsv" "${work_root}/public-assets.tsv" |
    LC_ALL=C sort >"${candidate_manifest}"
  candidate_identity="$(ruby -rdigest -e \
    'print Digest::SHA256.file(ARGV.fetch(0)).hexdigest' "${candidate_manifest}")"
  [[ "${candidate_identity}" == "${authorized_digest}" ]] ||
    fail_publish "publication authorization differs from candidate bytes (${authorized_digest} != ${candidate_identity})"
  expected_names="$("${project_root}/package/release_asset_manifest" candidate "${version}" "${catalog_sequence}")"
  [[ "$(cut -f1 "${candidate_manifest}")" == "${expected_names}" ]] ||
    fail_publish "staged candidate inventory differs from the canonical asset set"
fi

publish_channel() {
  local channel="$1"
  local tag json was_draft
  tag="$(channel_tag "${channel}")"
  json="${work_root}/${channel}.json"
  was_draft="$(ruby -rjson -e \
    'puts JSON.parse(File.binread(ARGV.fetch(0))).fetch("isDraft")' "${json}")"
  if [[ "${was_draft}" == true ]]; then
    edit_args=(release edit "${tag}" --repo "${repository}" --draft=false)
    [[ "${channel}" == public ]] && edit_args+=(--latest)
    gh "${edit_args[@]}"
  elif [[ "${channel}" == public ]]; then
    gh release edit "${tag}" --repo "${repository}" --latest
  fi
  if [[ "${channel}" == data ]]; then
    verify_tag_revision "${tag}" ""
  else
    verify_tag_revision "${tag}"
  fi
  load_and_verify_release "${channel}"
  [[ "$(ruby -rjson -e \
      'puts JSON.parse(File.binread(ARGV.fetch(0))).fetch("isDraft")' \
      "${work_root}/${channel}.json")" == false ]] ||
    fail_publish "${tag} remained a draft"
}

if [[ "${mode}" == data-seed ]]; then
  publish_channel data
  echo "Linnet ${version} data seed: PASS (Catalog not promoted)"
  exit 0
fi

catalog="${work_root}/Linnet-Data-Channel.json"
gh release download "$(channel_tag core)" --repo "${repository}" \
  --pattern Linnet-Data-Channel.json --dir "${work_root}"

ruby -rjson -rdigest -e '
  catalog_path, core_assets_path, data_assets_path, repository,
    version, revision, sequence = ARGV
  sequence = Integer(sequence, 10)
  assets = {}
  [core_assets_path, data_assets_path].each do |path|
    File.readlines(path, chomp: true).each do |line|
      name, digest, bytes = line.split("\t", 3)
      abort if assets.key?(name)
      assets[name] = {digest: digest.delete_prefix("sha256:"), bytes: Integer(bytes, 10)}
    end
  end
  catalog = JSON.parse(File.binread(catalog_path))
  abort unless [1, 2].include?(catalog.fetch("format")) && catalog.fetch("sequence") == sequence
  core = catalog.fetch("core")
  if catalog.fetch("format") == 1
    core_name = "Linnet-#{version}-arm64-Core-community-beta.pkg"
    core_url = core.fetch("package_url")
    abort if core.key?("artifact_format") || core.key?("artifact_url")
  else
    core_name = "Linnet-#{version}-arm64-Core.linnetcore"
    abort unless core.fetch("artifact_format") == "app-tar-gzip" && !core.key?("package_url")
    core_url = core.fetch("artifact_url")
  end
  abort unless core.fetch("version") == version &&
    core.fetch("revision") == revision &&
    core.fetch("release_url") == "https://github.com/#{repository}/releases/tag/core-v#{version}" &&
    core_url == "https://github.com/#{repository}/releases/download/core-v#{version}/#{core_name}"
  core_asset = assets.fetch(core_name)
  abort unless core.fetch("bytes") == core_asset.fetch(:bytes) &&
    core.fetch("sha256") == core_asset.fetch(:digest)
  names = {
    "chinese" => "Linnet-Chinese.linnetpack",
    "english" => "Linnet-English.linnetpack",
    "extended" => "Linnet-Extended.linnetpack",
    "lts" => "Linnet-LTS.linnetpack",
  }
  observed = {}
  observed_deltas = {}
  catalog.fetch("activation_sets").each do |set|
    abort unless %w[standard full].include?(set.fetch("edition"))
    set.fetch("packs").each do |pack|
      kind = pack.fetch("kind")
      name = names.fetch(kind)
      asset = assets.fetch(name)
      abort unless pack.fetch("bytes") == asset.fetch(:bytes) &&
        pack.fetch("container_sha256") == asset.fetch(:digest) &&
        pack.fetch("url") == "https://github.com/#{repository}/releases/download/data-#{sequence}/#{name}"
      identity = pack.reject { |key, _| key == "url" }
      abort if observed.key?(kind) && observed.fetch(kind) != identity
      observed[kind] = identity
      pack.fetch("deltas", []).each do |delta|
        base = delta.fetch("base_content_sha256")
        abort unless base.match?(/\A[0-9a-f]{64}\z/) && base != pack.fetch("content_sha256")
        delta_name = name.sub(/\.linnetpack\z/, "-from-#{base}.linnetdelta")
        delta_asset = assets.fetch(delta_name)
        abort unless delta.fetch("url") == "https://github.com/#{repository}/releases/download/data-#{sequence}/#{delta_name}" &&
          delta.fetch("bytes") == delta_asset.fetch(:bytes) && delta.fetch("sha256") == delta_asset.fetch(:digest)
        abort if observed_deltas.key?(delta_name) && observed_deltas.fetch(delta_name) != delta
        observed_deltas[delta_name] = delta
      end
    end
  end
  abort unless observed.keys.sort == names.keys.sort
  abort unless observed_deltas.keys.sort == assets.keys.grep(/\.linnetdelta\z/).sort
  catalog_asset = assets.fetch("Linnet-Data-Channel.json")
  abort unless File.size(catalog_path) == catalog_asset.fetch(:bytes) &&
    Digest::SHA256.file(catalog_path).hexdigest == catalog_asset.fetch(:digest)
' "${catalog}" "${work_root}/core-assets.tsv" \
  "${work_root}/data-assets.tsv" \
  "${repository}" "${version}" "${candidate_revision}" "${catalog_sequence}" ||
  fail_publish "staged Catalog does not bind its GitHub Release assets"

if [[ "${mode}" == verify ]]; then
  echo "Linnet ${version} staged GitHub Releases: VERIFIED"
  exit 0
fi
promote_catalog() {
  local branch="$1"
  local api="repos/${repository}/git"
  local current_commit="" current_tree current_blob current_sequence
  if current_commit="$(gh api "repos/${repository}/git/ref/heads/${branch}" \
      --jq '.object.sha' 2>"${work_root}/${branch}-error")"; then
    [[ "${current_commit}" =~ ^[0-9a-f]{40}$ ]] ||
      fail_publish "${branch} branch identity is invalid"
    current_tree="$(gh api "${api}/commits/${current_commit}" --jq '.tree.sha')"
    current_blob="$(gh api "${api}/trees/${current_tree}" --jq \
      '.tree | select(length == 1 and .[0].path == "Linnet-Data-Channel.json" and .[0].mode == "100644" and .[0].type == "blob") | .[0].sha')"
    [[ -n "${current_blob}" ]] || fail_publish "${branch} tree is not canonical"
    gh api "${api}/blobs/${current_blob}" --jq '.content' |
      ruby -rbase64 -e 'File.binwrite(ARGV.fetch(0), Base64.decode64(STDIN.read))' \
        "${work_root}/current-catalog"
    if cmp -s "${catalog}" "${work_root}/current-catalog"; then
      return
    fi
    current_sequence="$(ruby -rjson -e '
      value = JSON.parse(File.binread(ARGV.fetch(0))).fetch("sequence")
      abort unless value.is_a?(Integer) && value.positive?
      puts value
    ' "${work_root}/current-catalog")" ||
      fail_publish "current ${branch} Catalog is invalid"
    if (( current_sequence == catalog_sequence )); then
      ruby -rjson -e '
        current = JSON.parse(File.binread(ARGV.fetch(0)))
        candidate = JSON.parse(File.binread(ARGV.fetch(1)))
        current.delete("core")
        candidate.delete("core")
        [current, candidate].each do |catalog|
          catalog.fetch("activation_sets").each { |set| set.fetch("packs").each { |pack| pack.delete("deltas") } }
        end
        abort unless current == candidate
      ' "${work_root}/current-catalog" "${catalog}" ||
        fail_publish "Catalog sequence cannot change immutable pack identity"
    elif (( current_sequence > catalog_sequence )); then
      fail_publish "Catalog sequence cannot replace current sequence ${current_sequence}"
    fi
  elif ! grep -Eq 'Not Found|HTTP 404' "${work_root}/${branch}-error"; then
    [[ ! -s "${work_root}/${branch}-error" ]] ||
      cat "${work_root}/${branch}-error" >&2
    fail_publish "${branch} branch identity is unavailable"
  else
    current_commit=""
  fi

  ruby -rjson -rbase64 -e '
    File.binwrite(ARGV.fetch(1), JSON.generate({
      "content" => Base64.strict_encode64(File.binread(ARGV.fetch(0))),
      "encoding" => "base64",
    }))
  ' "${catalog}" "${work_root}/blob.json"
  blob="$(gh api --method POST "${api}/blobs" --input "${work_root}/blob.json" --jq '.sha')"
  ruby -rjson -e '
    File.binwrite(ARGV.fetch(1), JSON.generate({"tree" => [{
      "path" => "Linnet-Data-Channel.json", "mode" => "100644",
      "type" => "blob", "sha" => ARGV.fetch(0),
    }]}))
  ' "${blob}" "${work_root}/tree.json"
  tree="$(gh api --method POST "${api}/trees" --input "${work_root}/tree.json" --jq '.sha')"
  ruby -rjson -e '
    document = {"message" => ARGV.fetch(0), "tree" => ARGV.fetch(1)}
    document["parents"] = [ARGV.fetch(2)] unless ARGV.fetch(2).empty?
    File.binwrite(ARGV.fetch(3), JSON.generate(document))
  ' "Publish Linnet ${branch} ${catalog_sequence}" "${tree}" "${current_commit}" \
    "${work_root}/commit.json"
  commit="$(gh api --method POST "${api}/commits" --input \
    "${work_root}/commit.json" --jq '.sha')"
  if [[ -n "${current_commit}" ]]; then
    gh api --method PATCH "repos/${repository}/git/refs/heads/${branch}" \
      -f sha="${commit}" -F force=false >/dev/null
  else
    gh api --method POST "repos/${repository}/git/refs" \
      -f ref="refs/heads/${branch}" -f sha="${commit}" >/dev/null
  fi
  local final_commit final_tree final_blob
  final_commit="$(gh api "repos/${repository}/git/ref/heads/${branch}" --jq '.object.sha')"
  [[ "${final_commit}" == "${commit}" ]] ||
    fail_publish "${branch} ref did not advance to the exact Catalog"
  final_tree="$(gh api "${api}/commits/${final_commit}" --jq '.tree.sha')"
  final_blob="$(gh api "${api}/trees/${final_tree}" --jq \
    '.tree | select(length == 1 and .[0].path == "Linnet-Data-Channel.json" and .[0].mode == "100644" and .[0].type == "blob") | .[0].sha')"
  [[ -n "${final_blob}" ]] || fail_publish "published ${branch} tree is not canonical"
  gh api "${api}/blobs/${final_blob}" --jq '.content' |
    ruby -rbase64 -e 'File.binwrite(ARGV.fetch(0), Base64.decode64(STDIN.read))' \
      "${work_root}/final-catalog"
  cmp -s "${catalog}" "${work_root}/final-catalog" ||
    fail_publish "${branch} bytes differ after publication"
}

publish_channel core
publish_channel data
if [[ "${mode}" == preview ]]; then
  promote_catalog preview-channel
  echo "Linnet ${version} GitHub Action Preview publication: PASS"
  exit 0
fi
promote_catalog data-channel
publish_channel public
echo "Linnet ${version} GitHub Action publication: PASS"
