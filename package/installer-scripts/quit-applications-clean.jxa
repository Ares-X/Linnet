// Cooperative pre-payload quiescence for exact macOS application identities.
// NSRunningApplication.terminate() reaches each app's normal termination
// delegate. A refusal, unsaved-work prompt, active operation, or relaunch keeps
// the process visible and makes this script fail closed; it never force-quits.

ObjC.import("AppKit");
ObjC.import("Carbon");
ObjC.import("Foundation");

function fail(message) {
  throw new Error(`Linnet clean application quit: ${message}`);
}

function runningApplications(bundleIdentifier) {
  const applications = [];
  const matches = $.NSRunningApplication
    .runningApplicationsWithBundleIdentifier(bundleIdentifier);
  for (let index = 0; index < Number(matches.count); index += 1) {
    const application = matches.objectAtIndex(index);
    if (!Boolean(application.terminated)) {
      applications.push(application);
    }
  }
  return applications;
}

function currentInputSourceID() {
  const source = $.TISCopyCurrentKeyboardInputSource();
  if (!source) fail("current input source is unavailable");
  const property = $.TISGetInputSourceProperty(
    source, $.kTISPropertyInputSourceID);
  if (!property) fail("current input source has no stable identifier");
  const value = ObjC.unwrap(ObjC.castRefToObject(property));
  if (typeof value !== "string" || value.length === 0 || value.length > 1024 ||
      value.includes("\0") || value.includes("\n") || value.includes("\r")) {
    fail("current input source identifier is invalid");
  }
  return value;
}

function quiesceApplication(bundleIdentifier, timeoutSeconds) {
  const requested = new Set();
  const deadline = Date.now() + timeoutSeconds * 1000;
  let quietSince = null;
  while (Date.now() < deadline) {
    const targets = runningApplications(bundleIdentifier);
    if (targets.length === 0) {
      quietSince ??= Date.now();
      if (Date.now() - quietSince >= 500) return;
    } else {
      quietSince = null;
      targets.forEach((application) => {
        const identity = Number(application.processIdentifier);
        if (!requested.has(identity)) {
          requested.add(identity);
          // JXA exposes zero-argument Objective-C methods as evaluated
          // properties. Reading this value sends the normal termination
          // request and returns whether LaunchServices accepted the request.
          Boolean(application.terminate);
        }
      });
    }
    $.NSRunLoop.currentRunLoop.runUntilDate(
      $.NSDate.dateWithTimeIntervalSinceNow(0.05));
  }

  const remaining = runningApplications(bundleIdentifier).map(
    (application) => `${bundleIdentifier}:${Number(application.processIdentifier)}`);
  if (remaining.length > 0) {
    fail(`applications refused to quit: ${remaining.join(", ")}`);
  }
  fail("applications did not remain quiescent before the deadline");
}

function run(arguments) {
  if (arguments.length < 4 || !/^([1-9][0-9]*)(\.[0-9]+)?$/.test(arguments[0])) {
    fail("usage: TIMEOUT_SECONDS TARGET_INPUT_SOURCE_ID BUNDLE_IDENTIFIER...");
  }
  const timeoutSeconds = Number(arguments[0]);
  const targetInputSourceID = arguments[1];
  const bundleIdentifiers = arguments.slice(2);
  if (!Number.isFinite(timeoutSeconds) || timeoutSeconds > 300 ||
      !/^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$/.test(targetInputSourceID) ||
      new Set(bundleIdentifiers).size !== bundleIdentifiers.length ||
      bundleIdentifiers.some((identifier) =>
        !/^[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)+$/.test(identifier))) {
    fail("invalid timeout or application identity");
  }

  for (let index = 0; index < bundleIdentifiers.length - 1; index += 1) {
    const bundleIdentifier = bundleIdentifiers[index];
    quiesceApplication(bundleIdentifier, timeoutSeconds);
  }

  // Snapshot as late as possible: Settings has already quiesced, while the
  // Host that owns the current input source is still alive. TISInputSourceRef
  // is process-local, so the package transaction carries only copied IDs.
  const wasCurrent = currentInputSourceID() === targetInputSourceID;
  quiesceApplication(
    bundleIdentifiers[bundleIdentifiers.length - 1], timeoutSeconds);
  const postQuiescenceInputSourceID = currentInputSourceID();
  return JSON.stringify({
    format: 1,
    target_input_source_id: targetInputSourceID,
    was_current: wasCurrent,
    post_quiescence_input_source_id: postQuiescenceInputSourceID,
  });
}
