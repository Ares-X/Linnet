#!/usr/bin/env bash

# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
app_path="${1:-}"
output_dir="${2:-}"
source_epoch="${SOURCE_DATE_EPOCH:-1704067200}"

fail_archive() {
  echo "make_archive: $1" >&2
  exit 1
}

[[ "$#" -eq 2 ]] || fail_archive "usage: APP OUTPUT_DIRECTORY"
[[ "${app_path}" == /* && -d "${app_path}" && ! -L "${app_path}" ]] ||
  fail_archive "APP must be an absolute, non-symlink App bundle"
[[ "${app_path##*/}" == Linnet.app ]] || fail_archive "unexpected App name"
[[ "${source_epoch}" =~ ^[0-9]+$ ]] || fail_archive "invalid SOURCE_DATE_EPOCH"
for tool in awk cmp cp date find git mkdir mktemp mv pkgutil plutil ruby shasum sort stat tr wc zip; do
  command -v "${tool}" >/dev/null 2>&1 || fail_archive "required tool is unavailable: ${tool}"
done

version="$(plutil -extract CFBundleShortVersionString raw -o - \
  "${app_path}/Contents/Info.plist")"
candidate_revision="${LINNET_CANDIDATE_REVISION:-}"
release_tool="${LINNET_RELEASE_TOOL:-}"
unset LINNET_RELEASE_TOOL
data_release_file="${project_root}/config/linnet-data-releases.json"
data_release_tool="${project_root}/package/data_release_metadata"
"${data_release_tool}" validate "${data_release_file}" >/dev/null
"${data_release_tool}" check-core "${data_release_file}" "${version}" >/dev/null
catalog_sequence="$("${data_release_tool}" get-catalog-sequence "${data_release_file}")"
[[ "${candidate_revision}" =~ ^[0-9a-f]{40}$ ]] ||
  fail_archive "LINNET_CANDIDATE_REVISION must name the exact candidate Git OID"
[[ "$(git -C "${project_root}" rev-parse --verify HEAD^{commit})" == "${candidate_revision}" ]] ||
  fail_archive "candidate revision differs from the candidate checkout"
[[ -z "$(git -C "${project_root}" status --porcelain)" ]] ||
  fail_archive "archive assembly requires a clean candidate revision"
[[ "${output_dir}" == /* && -d "${output_dir}" && ! -L "${output_dir}" ]] ||
  fail_archive "OUTPUT_DIRECTORY must be an absolute, non-symlink directory"
release_prefix="Linnet-${version}-arm64"
core_pkg="${output_dir}/${release_prefix}-Core-community-beta.pkg"
complete_pkg="${output_dir}/Linnet.pkg"
for package in "${core_pkg}" "${complete_pkg}"; do
  [[ -f "${package}" && ! -L "${package}" ]] ||
    fail_archive "verified component product is missing: ${package##*/}"
done

output_dir="$(cd "${output_dir}" && pwd -P)"
work_root="$(mktemp -d "${output_dir}/.linnet-archive.XXXXXX")"
cleanup() {
  if [[ "${work_root}" == "${output_dir}/.linnet-archive."* ]]; then
    chmod -R u+w "${work_root}" 2>/dev/null || true
    /bin/rm -rf -- "${work_root}"
  fi
}
trap cleanup EXIT
if [[ -n "${release_tool}" ]]; then
  [[ "${release_tool}" == /* && -f "${release_tool}" && ! -L "${release_tool}" && -x "${release_tool}" ]] ||
    fail_archive "LINNET_RELEASE_TOOL must name the precompiled pack CLI"
  pack_tool="${release_tool}"
else
  command -v xcrun >/dev/null 2>&1 || fail_archive "required tool is unavailable: xcrun"
  pack_tool="${work_root}/linnet-pack"
  xcrun swiftc -warnings-as-errors \
      "${project_root}/sources/LinnetPackContract.swift" \
      "${project_root}/sources/LinnetDataChannel.swift" \
      "${project_root}/sources/LinnetDataRegistry.swift" \
      "${project_root}/tools/LinnetDataCatalogBuilder.swift" \
      "${project_root}/tools/LinnetPackTool.swift" -o "${pack_tool}"
fi
signing_profile="$(plutil -extract LinnetCodeSigningProfile raw -o - \
  "${app_path}/Contents/Info.plist" 2>/dev/null || true)"
case "${signing_profile}" in
  uat)
    verification_scope=installation-uat
    code_identity="$("${project_root}/scripts/linnet-code-identity" \
      verify-product "${app_path}")" ||
      fail_archive "candidate UAT App identity is invalid"
    ;;
  community-adhoc)
    verification_scope=publication
    code_identity="$("${project_root}/scripts/linnet-code-identity" \
      verify-publication-product "${app_path}" "${candidate_revision}")" ||
      fail_archive "community App identity is invalid"
    ;;
  *) fail_archive "candidate signing profile is invalid" ;;
esac
ruby -rjson -e '
  identity = JSON.parse(ARGV.fetch(0))
  abort unless identity.fetch("candidate_revision") == ARGV.fetch(1)
' "${code_identity}" "${candidate_revision}" ||
  fail_archive "App identity differs from the candidate revision"
LINNET_RELEASE_TOOL="${pack_tool}" LINNET_CANDIDATE_REVISION="${candidate_revision}" \
  "${project_root}/package/verify_package" "${core_pkg}" "${app_path}" core \
    "${verification_scope}"
LINNET_RELEASE_TOOL="${pack_tool}" LINNET_CANDIDATE_REVISION="${candidate_revision}" \
  "${project_root}/package/verify_package" "${complete_pkg}" "${app_path}" complete \
    "${verification_scope}"
expanded_core="${work_root}/expanded-core"
expanded_complete="${work_root}/expanded-complete"
pkgutil --expand-full "${core_pkg}" "${expanded_core}"
pkgutil --expand-full "${complete_pkg}" "${expanded_complete}"

timestamp="$(TZ=UTC date -r "${source_epoch}" +%Y%m%d%H%M.%S)"
publish_zip() {
  local source_root="$1"
  local archive_name="$2"
  local candidate="${work_root}/${archive_name}"
  local reproducibility="${work_root}/reproducibility-${archive_name}"
  while IFS= read -r -d '' entry; do
    TZ=UTC touch -h -t "${timestamp}" "${entry}"
  done < <(find "${source_root}" -print0)
  (
    cd "${source_root}"
    COPYFILE_DISABLE=1 TZ=UTC find . -print | LC_ALL=C sort |
      COPYFILE_DISABLE=1 TZ=UTC zip -6 -X -y -q "${candidate}" -@
    COPYFILE_DISABLE=1 TZ=UTC find . -print | LC_ALL=C sort |
      COPYFILE_DISABLE=1 TZ=UTC zip -6 -X -y -q "${reproducibility}" -@
  )
  cmp -s "${candidate}" "${reproducibility}" ||
    fail_archive "archive is not reproducible: ${archive_name}"
  digest="$(shasum -a 256 "${candidate}" | /usr/bin/awk '{print $1}')"
  printf '%s  %s\n' "${digest}" "${archive_name}" >"${work_root}/${archive_name}.sha256"
  if [[ -e "${output_dir}/${archive_name}" || -e "${output_dir}/${archive_name}.sha256" ]]; then
    [[ -f "${output_dir}/${archive_name}" &&
      -f "${output_dir}/${archive_name}.sha256" ]] ||
      fail_archive "partial existing release output: ${archive_name}"
    cmp -s "${candidate}" "${output_dir}/${archive_name}" ||
      fail_archive "existing release output is not reproducible: ${archive_name}"
    cmp -s "${work_root}/${archive_name}.sha256" "${output_dir}/${archive_name}.sha256" ||
      fail_archive "existing release checksum mismatch: ${archive_name}"
    return
  fi
  mv "${candidate}" "${output_dir}/${archive_name}"
  mv "${work_root}/${archive_name}.sha256" "${output_dir}/${archive_name}.sha256"
}

core_archive_root="${work_root}/core-archive/Linnet-Core-${version}"
mkdir -p "${core_archive_root}"
cp -R "${expanded_core}/Linnet-Core.component.pkg/Payload/Linnet.app" \
  "${core_archive_root}/Linnet.app"
cp "${expanded_core}/Resources/NOTICE.md" "${core_archive_root}/NOTICE.md"
cp "${expanded_core}/Resources/LICENSE.txt" "${core_archive_root}/LICENSE.txt"
publish_zip "${work_root}/core-archive" \
  "${release_prefix}-Core-community-beta.zip"

publish_pack() {
  local expanded="$1"
  local component_name="$2"
  local kind="$3"
  local pack_parent="${expanded}/${component_name}/Payload/Data/Packs/${kind}"
  local identity_entries
  identity_entries="$(find "${pack_parent}" -mindepth 1 -maxdepth 1 -type d | wc -l | tr -d ' ')"
  [[ "${identity_entries}" == 1 ]] || fail_archive "${kind} pack identity layout is invalid"
  local pack_root
  pack_root="$(find "${pack_parent}" -mindepth 1 -maxdepth 1 -type d -print)"
  local pack_version
  local pack_sequence
  local pack_data_abi
  local pack_min_core
  local pack_content_sha256
  pack_version="$("${data_release_tool}" get "${data_release_file}" "${kind}" version)"
  pack_sequence="$("${data_release_tool}" get "${data_release_file}" "${kind}" sequence)"
  pack_data_abi="$("${data_release_tool}" get "${data_release_file}" "${kind}" data_abi)"
  pack_min_core="$("${data_release_tool}" get "${data_release_file}" "${kind}" min_core)"
  pack_content_sha256="$("${data_release_tool}" get "${data_release_file}" "${kind}" content_sha256)"
  [[ "${pack_root##*/}" == "${pack_sequence}-${pack_version}" ]] ||
    fail_archive "${kind} component identity differs from release metadata"
  local installed_manifest="${work_root}/installed-${kind}-manifest.json"
  "${pack_tool}" inspect-installed --root "${pack_root}" --core-version "${version}" \
    >"${installed_manifest}" ||
    fail_archive "${kind} component is not one canonical installed pack"
  local package_content_sha
  package_content_sha="$(ruby -rjson -e '
    manifest = JSON.parse(File.read(ARGV.fetch(0)))
    content = manifest.fetch("content_sha256")
    abort unless content.match?(/\A[0-9a-f]{64}\z/)
    puts content
  ' "${installed_manifest}")" || fail_archive "${kind} manifest is invalid"
  [[ "${package_content_sha}" == "${pack_content_sha256}" ]] ||
    fail_archive "${kind} component content differs from release metadata"
  local archive_name
  archive_name="$("${pack_tool}" asset-name --kind "${kind}")"
  local candidate="${work_root}/${archive_name}"
  "${pack_tool}" build-container --root "${pack_root}" --core-version "${version}" \
    --output "${candidate}" || fail_archive "cannot build ${archive_name}"
  "${pack_tool}" verify --pack "${candidate}" --core-version "${version}" >/dev/null
  "${pack_tool}" inspect --pack "${candidate}" --core-version "${version}" \
    >"${work_root}/manifest-1-${kind}.json"
  cmp -s "${installed_manifest}" "${work_root}/manifest-1-${kind}.json" ||
    fail_archive "${kind} embedded and online manifests differ"
  local digest
  digest="$(shasum -a 256 "${candidate}" | awk '{print $1}')"
  printf '%s  %s\n' "${digest}" "${archive_name}" >"${work_root}/expected-${archive_name}.sha256"
  if [[ -e "${output_dir}/${archive_name}" || -e "${output_dir}/${archive_name}.sha256" ]]; then
    [[ -f "${output_dir}/${archive_name}" &&
      -f "${output_dir}/${archive_name}.sha256" ]] ||
      fail_archive "partial existing release output: ${archive_name}"
    cmp -s "${candidate}" "${output_dir}/${archive_name}" ||
      fail_archive "existing pack bytes differ: ${archive_name}"
    (cd "${output_dir}" && shasum -a 256 -c "${archive_name}.sha256" >/dev/null) ||
      fail_archive "existing release checksum mismatch: ${archive_name}"
    return
  fi
  cp "${candidate}" "${output_dir}/${archive_name}"
  cp "${work_root}/expected-${archive_name}.sha256" "${output_dir}/${archive_name}.sha256"
}

publish_pack "${expanded_complete}" Linnet-Chinese.component.pkg chinese
publish_pack "${expanded_complete}" Linnet-English.component.pkg english
publish_pack "${expanded_complete}" Linnet-LTS.component.pkg lts
publish_pack "${expanded_complete}" Linnet-Extended.component.pkg extended

publish_catalog() {
  local archive_name=Linnet-Data-Channel.json
  local candidate="${work_root}/${archive_name}"
  "${pack_tool}" build-catalog --sequence "${catalog_sequence}" \
    --core-version "${version}" --output "${candidate}" \
    --chinese-pack "${output_dir}/Linnet-Chinese.linnetpack" \
    --english-pack "${output_dir}/Linnet-English.linnetpack" \
    --lts-pack "${output_dir}/Linnet-LTS.linnetpack" \
    --extended-pack "${output_dir}/Linnet-Extended.linnetpack" ||
    fail_archive "cannot build data Catalog"
  "${pack_tool}" verify-catalog --catalog "${candidate}" \
    --core-version "${version}" >/dev/null
  "${pack_tool}" inspect-catalog --catalog "${candidate}" \
    --core-version "${version}" >"${work_root}/catalog-1.json"
  ruby -rjson -rdigest -e '
    catalog = JSON.parse(File.read(ARGV.shift))
    expected_sequence = Integer(ARGV.shift)
    root = ARGV.shift
    manifests = ARGV.to_h { |path|
      manifest = JSON.parse(File.read(path))
      [manifest.fetch("kind"), manifest]
    }
    abort "catalog sequence mismatch" unless catalog.fetch("sequence") == expected_sequence
    catalog.fetch("activation_sets").each do |set|
      set.fetch("packs").each do |artifact|
        manifest = manifests.fetch(artifact.fetch("kind"))
        %w[kind version sequence data_abi min_core content_sha256].each do |field|
          abort "catalog #{field} mismatch" unless artifact.fetch(field) == manifest.fetch(field)
        end
        asset_names = {
          "chinese" => "Linnet-Chinese.linnetpack",
          "english" => "Linnet-English.linnetpack",
          "lts" => "Linnet-LTS.linnetpack",
          "extended" => "Linnet-Extended.linnetpack",
        }
        asset = File.join(root, asset_names.fetch(artifact.fetch("kind")))
        abort "catalog byte count mismatch" unless artifact.fetch("bytes") == File.size(asset)
        abort "catalog container digest mismatch" unless
          artifact.fetch("container_sha256") == Digest::SHA256.file(asset).hexdigest
      end
    end
  ' "${work_root}/catalog-1.json" "${catalog_sequence}" "${output_dir}" \
    "${work_root}/manifest-1-chinese.json" "${work_root}/manifest-1-english.json" \
    "${work_root}/manifest-1-lts.json" "${work_root}/manifest-1-extended.json" ||
    fail_archive "external catalog differs from the accepted pack set"
  local digest
  digest="$(shasum -a 256 "${candidate}" | awk '{print $1}')"
  printf '%s  %s\n' "${digest}" "${archive_name}" >"${work_root}/expected-${archive_name}.sha256"
  if [[ -e "${output_dir}/${archive_name}" || -e "${output_dir}/${archive_name}.sha256" ]]; then
    [[ -f "${output_dir}/${archive_name}" && -f "${output_dir}/${archive_name}.sha256" ]] ||
      fail_archive "partial existing release output: ${archive_name}"
    "${pack_tool}" inspect-catalog --catalog "${output_dir}/${archive_name}" \
      --core-version "${version}" \
      >"${work_root}/catalog-existing.json"
    cmp -s "${work_root}/catalog-1.json" "${work_root}/catalog-existing.json" ||
      fail_archive "existing data catalog content differs"
    (cd "${output_dir}" && shasum -a 256 -c "${archive_name}.sha256" >/dev/null) ||
      fail_archive "existing data catalog checksum mismatch"
    return
  fi
  cp "${candidate}" "${output_dir}/${archive_name}"
  cp "${work_root}/expected-${archive_name}.sha256" "${output_dir}/${archive_name}.sha256"
}

publish_catalog

echo "Linnet Core archive, deterministic language packs and Catalog: PASS"
