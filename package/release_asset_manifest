#!/usr/bin/env bash

# SPDX-License-Identifier: GPL-3.0-or-later

# One owner partitions the verified archive into the stable user download and
# the two same-repository update channels. Callers may copy or upload these
# names, but must not reconstruct channel membership themselves.

set -euo pipefail

channel="${1:-}"
version="${2:-}"
catalog_sequence="${3:-}"
project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

fail_manifest() {
  echo "release_asset_manifest: $*" >&2
  exit 1
}

[[ "$#" -eq 3 ]] ||
  fail_manifest "usage: CHANNEL VERSION CATALOG_SEQUENCE"
[[ "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.-][0-9A-Za-z]+)*$ ]] ||
  fail_manifest "invalid product version"
[[ "${catalog_sequence}" =~ ^[1-9][0-9]*$ ]] ||
  fail_manifest "invalid Catalog sequence"

public_assets() {
  printf '%s\n' Linnet.pkg
}

core_assets() {
  printf '%s\n' \
    "Linnet-${version}-arm64-Core-community-beta.pkg" \
    "Linnet-${version}-Uninstall.command" \
    Linnet-Data-Channel.json
}

data_assets() {
  printf '%s\n' \
    Linnet-Chinese.linnetpack \
    Linnet-English.linnetpack \
    Linnet-Extended.linnetpack \
    Linnet-LTS.linnetpack
  ruby -rjson -e '
    baselines = JSON.parse(File.read(ARGV.fetch(0)))
    releases = JSON.parse(File.read(ARGV.fetch(1)))
    abort "invalid baseline format" unless baselines.fetch("format") == 1
    names = {"chinese" => "Chinese", "english" => "English", "lts" => "LTS", "extended" => "Extended"}
    abort "baseline kind mismatch" unless baselines.fetch("pack_baselines").keys.sort == names.keys.sort
    names.each do |kind, name|
      baseline = baselines.fetch("pack_baselines").fetch(kind)
      release = releases.fetch("packs").fetch(kind)
      abort "baseline is not bound to target pack sequence" unless baseline.fetch("target_sequence") == release.fetch("sequence")
      base = baseline.fetch("content_sha256")
      abort "invalid baseline content" unless base.match?(/\A[0-9a-f]{64}\z/)
      baselines.fetch("sources").fetch(baseline.fetch("source"))
      puts "Linnet-#{name}-from-#{base}.linnetdelta" unless base == release.fetch("content_sha256")
    end
  ' "${project_root}/config/linnet-update-baselines.json" "${project_root}/config/linnet-data-releases.json"
}

case "${channel}" in
  public) public_assets ;;
  core) core_assets ;;
  data) data_assets ;;
  candidate)
    public_assets
    core_assets
    data_assets
    ;;
  *) fail_manifest "unknown release channel: ${channel}" ;;
esac | LC_ALL=C sort -u
