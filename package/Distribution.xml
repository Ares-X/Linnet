<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>Linnet</title>
  <welcome file="WELCOME.md" mime-type="text/plain"/>
  <license file="LICENSE.txt" mime-type="text/plain"/>
  <readme file="NOTICE.md" mime-type="text/plain"/>
  <conclusion file="Conclusion-summary.txt" mime-type="text/plain"/>
  <options customize="never" require-scripts="false" hostArchitectures="arm64"/>
  <domains enable_localSystem="false" enable_currentUserHome="true" enable_anywhere="false"/>
  <os-version min="13.0"/>
  <choices-outline>
    <line choice="core"/>
    <line choice="chinese"/>
    <line choice="english"/>
    <line choice="lts"/>
    <line choice="extended"/>
    <line choice="profile"/>
  </choices-outline>
  <choice id="core" visible="false">
    <pkg-ref id="io.github.ares-x.inputmethod.Linnet.core.pkg"/>
  </choice>
  <choice id="chinese" visible="false">
    <pkg-ref id="io.github.ares-x.inputmethod.Linnet.data.chinese.pkg"/>
  </choice>
  <choice id="english" visible="false">
    <pkg-ref id="io.github.ares-x.inputmethod.Linnet.data.english.pkg"/>
  </choice>
  <choice id="lts" visible="false">
    <pkg-ref id="io.github.ares-x.inputmethod.Linnet.data.lts.pkg"/>
  </choice>
  <choice id="extended" visible="false">
    <pkg-ref id="io.github.ares-x.inputmethod.Linnet.data.extended.pkg"/>
  </choice>
  <choice id="profile" visible="false">
    <pkg-ref id="io.github.ares-x.inputmethod.Linnet.profile.pkg"/>
  </choice>
  <pkg-ref id="io.github.ares-x.inputmethod.Linnet.core.pkg"
    version="@CORE_VERSION@" auth="none"
    onConclusion="RequireLogout">Linnet-Core.component.pkg</pkg-ref>
  <pkg-ref id="io.github.ares-x.inputmethod.Linnet.data.chinese.pkg"
    version="@CHINESE_SEQUENCE@" auth="none">Linnet-Chinese.component.pkg</pkg-ref>
  <pkg-ref id="io.github.ares-x.inputmethod.Linnet.data.english.pkg"
    version="@ENGLISH_SEQUENCE@" auth="none">Linnet-English.component.pkg</pkg-ref>
  <pkg-ref id="io.github.ares-x.inputmethod.Linnet.data.lts.pkg"
    version="@LTS_SEQUENCE@" auth="none">Linnet-LTS.component.pkg</pkg-ref>
  <pkg-ref id="io.github.ares-x.inputmethod.Linnet.data.extended.pkg"
    version="@EXTENDED_SEQUENCE@" auth="none">Linnet-Extended.component.pkg</pkg-ref>
  <pkg-ref id="io.github.ares-x.inputmethod.Linnet.profile.pkg"
    version="@PROFILE_RECEIPT_VERSION@" auth="none">Linnet-Profile.component.pkg</pkg-ref>
  <pkg-ref id="io.github.ares-x.inputmethod.Linnet.core.pkg">
    <must-close>
      <app id="io.github.ares-x.inputmethod.Linnet"/>
      <app id="io.github.ares-x.inputmethod.Linnet.settings"/>
    </must-close>
  </pkg-ref>
</installer-gui-script>
