#!/usr/bin/env bash

# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

user_home="${HOME:-}"
library_root="${user_home}/Library"
input_methods_root="${library_root}/Input Methods"
app_path="${input_methods_root}/Linnet.app"
application_support_root="${library_root}/Application Support"
support_root="${application_support_root}/Linnet"
state_root="${support_root}/State"
script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
candidate_file="${script_root}/candidate-core-version"
mode_file="${script_root}/install-mode"
identity_helper="${script_root}/candidate-app-identity.sh"
identity_metadata="${script_root}/candidate-app-identity.json"
registration_inspector="${script_root}/input-source-registration-inspector"
runtime_inspector="${script_root}/linnet-runtime-inspector"
current_uid="$(/usr/bin/id -u)"
identity_transition=""
registration_state=""
runtime_state=""
candidate_bundle_identifier=""

secure_owned_path() {
  local path="$1"
  local expected_type="$2"
  local owner mode
  case "${expected_type}" in
    directory) [[ -d "${path}" && ! -L "${path}" ]] || return 1 ;;
    file) [[ -f "${path}" && ! -L "${path}" ]] || return 1 ;;
    *) return 1 ;;
  esac
  read -r owner mode < <(/usr/bin/stat -f '%u %Lp' "${path}") || return 1
  [[ "${owner}" == "${current_uid}" ]] || return 1
  (( (8#${mode} & 0022) == 0 ))
}

require_secure_directory_if_present() {
  local path="$1"
  if [[ -e "${path}" || -L "${path}" ]]; then
    secure_owned_path "${path}" directory || {
      echo "Linnet Core preinstall: unsafe payload path: ${path}" >&2
      exit 1
    }
  fi
}

[[ "${user_home}" == /* ]] && secure_owned_path "${user_home}" directory || {
  echo "Linnet Core preinstall: current user home is unavailable" >&2
  exit 1
}
secure_owned_path "${library_root}" directory || {
  echo "Linnet Core preinstall: user Library is unsafe" >&2
  exit 1
}
[[ -f "${candidate_file}" && ! -L "${candidate_file}" && \
  -f "${mode_file}" && ! -L "${mode_file}" && \
  -f "${identity_helper}" && ! -L "${identity_helper}" && \
  -x "${identity_helper}" && \
  -f "${identity_metadata}" && ! -L "${identity_metadata}" && \
  -f "${registration_inspector}" && ! -L "${registration_inspector}" && \
  -x "${registration_inspector}" && \
  -f "${runtime_inspector}" && ! -L "${runtime_inspector}" && \
  -x "${runtime_inspector}" ]] || {
  echo "Linnet Core preinstall: compatibility metadata is unavailable" >&2
  exit 1
}
IFS= read -r candidate_core_version <"${candidate_file}"
IFS= read -r install_mode <"${mode_file}"
[[ -n "${candidate_core_version}" ]] || exit 1
case "${install_mode}" in
  core-update|complete) ;;
  *)
    echo "Linnet Core preinstall: package installation mode is invalid" >&2
    exit 1
    ;;
esac

# This is the pre-payload half of the Registry's canonical-root invariant.
# Missing leaves are valid on first install. Every existing component of both
# Installer destinations must already be an owned, non-writable real directory;
# validate the complete chains before classifying a clean Complete install.
payload_directories=(
  "${input_methods_root}"
  "${app_path}"
  "${application_support_root}"
  "${support_root}"
  "${support_root}/Data"
  "${support_root}/Data/Packs"
  "${support_root}/Data/Packs/chinese"
  "${support_root}/Data/Packs/english"
  "${support_root}/Data/Packs/lts"
  "${support_root}/Data/Packs/extended"
  "${support_root}/Runtime"
  "${support_root}/Runtime/Active"
  "${state_root}"
)
for payload_directory in "${payload_directories[@]}"; do
  require_secure_directory_if_present "${payload_directory}"
done

# The package-owned candidate identity is the only authority for deciding
# whether an existing integrity-checked App can be replaced or Complete owns a
# clean first install. It validates without running installed code and returns
# one typed transition before mutation.
identity_transition="$("${identity_helper}" existing)" || exit 1
candidate_bundle_identifier="$(/usr/bin/plutil -extract bundle_identifier raw -o - \
  "${identity_metadata}")" || exit 1
[[ -n "${candidate_bundle_identifier}" && \
  "${candidate_bundle_identifier}" != *$'\n'* ]] || exit 1

inspect_input_source_registration() {
  secure_owned_path "${registration_inspector}" file || return 1
  registration_state="$("${registration_inspector}" \
    "${candidate_bundle_identifier}")" || return 1
  [[ -n "${registration_state}" && "${registration_state}" != *$'\n'* ]]
}

inspect_runtime() {
  secure_owned_path "${runtime_inspector}" file || return 1
  runtime_state="$("${runtime_inspector}" probe \
    "${candidate_core_version}" "${application_support_root}")" || return 1
  case "${runtime_state}" in
    healthy|missing) ;;
    *) return 1 ;;
  esac
}

# Complete owns both clean installation and repair of a supported signed App.
# A clean install has no executable from which to read TIS. A repair must first
# pass the same installed-App signature transition as Core, then consume the
# package-owned helper's read-only typed TIS state. Registration mutation stays
# exclusively in Complete postinstall.
if [[ "${install_mode}" == complete ]]; then
  if [[ ! -e "${app_path}" && ! -L "${app_path}" ]]; then
    [[ "${identity_transition}" == clean-complete-install ]] || {
      echo "Linnet Complete requires an absent App identity" >&2
      exit 1
    }
  else
    case "${identity_transition}" in
      legacy-community-adhoc-to-cms|same-community-cms-leaf) ;;
      *)
        echo "Linnet Complete cannot repair this App identity. Uninstall Linnet first." >&2
        exit 1
        ;;
    esac
  fi

  inspect_input_source_registration || {
    echo "Linnet Complete could not inspect input-source registration. Uninstall Linnet first." >&2
    exit 1
  }
  inspect_runtime || {
    echo "Linnet Complete found invalid installed language data. Run the official uninstaller first." >&2
    exit 1
  }
  case "${registration_state}" in
    missing) exit 0 ;;
    registered:bundle-match:path-unknown)
      if [[ "${identity_transition}" != clean-complete-install && \
        "${runtime_state}" == healthy ]]; then
        echo "Linnet is already healthy. Use Linnet Core for routine updates; Complete is only for first installation or repair." >&2
        exit 1
      fi
      exit 0
      ;;
    *)
      echo "Linnet Complete found conflicting or unverifiable input-source registration (${registration_state}). Uninstall Linnet first." >&2
      exit 1
      ;;
  esac
fi

# Core is only an in-place update of the registered App identity. Missing App
# state is not reconstructible from filesystem evidence, so it fails before
# payload mutation and remains owned by the Complete registration lifecycle.
case "${identity_transition}" in
  legacy-community-adhoc-to-cms|same-community-cms-leaf) ;;
  clean-complete-install)
    echo "Linnet Core update requires the installed App. Run Linnet Complete to repair it." >&2
    exit 1
    ;;
  *)
    echo "Linnet Core preinstall: App identity transition is invalid" >&2
    exit 1
    ;;
esac

# Core can replace bytes only when TIS resolves exactly one source with Linnet's
# source and bundle IDs. HIToolbox exposes no authoritative bundle path, so the
# typed state explicitly records path-unknown. Core performs no TIS mutation.
inspect_input_source_registration || {
  echo "Linnet Core update could not inspect input-source registration. Uninstall Linnet first." >&2
  exit 1
}
case "${registration_state}" in
  registered:bundle-match:path-unknown) ;;
  missing)
    echo "Linnet Core update requires a registered input source. Run Linnet Complete to repair it." >&2
    exit 1
    ;;
  *)
    echo "Linnet Core update found conflicting or unverifiable input-source registration (${registration_state}). Uninstall Linnet first, then install Linnet Complete." >&2
    exit 1
    ;;
esac

# Existing language data is authoritative. The Registry-backed inspector is
# the one full compatibility/inventory/projection owner; Core never replaces
# the App after only a partial shell interpretation of activation.json.
inspect_runtime || {
  echo "Linnet Core preinstall: installed language data is missing, incompatible, or invalid. Run Linnet Complete to repair it." >&2
  exit 1
}
[[ "${runtime_state}" == healthy ]] || {
  echo "Linnet Core preinstall: installed language data is missing. Run Linnet Complete to repair it." >&2
  exit 1
}

exit 0
