#!/usr/bin/env bash

# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

user_home="${HOME:-}"
library_root="${user_home}/Library"
input_methods_root="${library_root}/Input Methods"
app_path="${input_methods_root}/Linnet.app"
application_support_root="${library_root}/Application Support"
support_root="${application_support_root}/Linnet"
active_state="${support_root}/Runtime/Active/activation.json"
state_link="${support_root}/State/active.json"
state_root="${support_root}/State"
script_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
candidate_file="${script_root}/candidate-core-version"
mode_file="${script_root}/install-mode"
identity_helper="${script_root}/candidate-app-identity.sh"
identity_metadata="${script_root}/candidate-app-identity.json"
application_quiescer="${script_root}/quit-applications-clean.jxa"
current_uid="$(/usr/bin/id -u)"
identity_transition=""

secure_owned_path() {
  local path="$1"
  local expected_type="$2"
  local owner mode
  case "${expected_type}" in
    directory) [[ -d "${path}" && ! -L "${path}" ]] || return 1 ;;
    file) [[ -f "${path}" && ! -L "${path}" ]] || return 1 ;;
    *) return 1 ;;
  esac
  read -r owner mode < <(/usr/bin/stat -f '%u %Lp' "${path}") || return 1
  [[ "${owner}" == "${current_uid}" ]] || return 1
  (( (8#${mode} & 0022) == 0 ))
}

require_secure_directory_if_present() {
  local path="$1"
  if [[ -e "${path}" || -L "${path}" ]]; then
    secure_owned_path "${path}" directory || {
      echo "Linnet Core preinstall: unsafe payload path: ${path}" >&2
      exit 1
    }
  fi
}

semver_at_least() {
  local actual="$1"
  local required="$2"
  local semver='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-([0-9A-Za-z-]+(\.[0-9A-Za-z-]+)*))?$'
  local actual_major actual_minor actual_patch actual_pre
  local required_major required_minor required_patch required_pre
  local index actual_part required_part
  local -a actual_parts required_parts

  [[ "${actual}" =~ ${semver} ]] || return 1
  actual_major="${BASH_REMATCH[1]}"
  actual_minor="${BASH_REMATCH[2]}"
  actual_patch="${BASH_REMATCH[3]}"
  actual_pre="${BASH_REMATCH[5]:-}"
  [[ "${required}" =~ ${semver} ]] || return 1
  required_major="${BASH_REMATCH[1]}"
  required_minor="${BASH_REMATCH[2]}"
  required_patch="${BASH_REMATCH[3]}"
  required_pre="${BASH_REMATCH[5]:-}"

  for index in 0 1 2; do
    actual_part=("${actual_major}" "${actual_minor}" "${actual_patch}")
    required_part=("${required_major}" "${required_minor}" "${required_patch}")
    if (( actual_part[index] > required_part[index] )); then return 0; fi
    if (( actual_part[index] < required_part[index] )); then return 1; fi
  done
  [[ "${actual_pre}" == "${required_pre}" ]] && return 0
  [[ -z "${actual_pre}" ]] && return 0
  [[ -z "${required_pre}" ]] && return 1

  IFS='.' read -r -a actual_parts <<<"${actual_pre}"
  IFS='.' read -r -a required_parts <<<"${required_pre}"
  index=0
  while (( index < ${#actual_parts[@]} || index < ${#required_parts[@]} )); do
    [[ "${actual_parts[index]+set}" == set ]] || return 1
    [[ "${required_parts[index]+set}" == set ]] || return 0
    actual_part="${actual_parts[index]}"
    required_part="${required_parts[index]}"
    if [[ "${actual_part}" != "${required_part}" ]]; then
      if [[ "${actual_part}" =~ ^[0-9]+$ && "${required_part}" =~ ^[0-9]+$ ]]; then
        (( 10#${actual_part} >= 10#${required_part} ))
        return
      fi
      [[ "${actual_part}" =~ ^[0-9]+$ ]] && return 1
      [[ "${required_part}" =~ ^[0-9]+$ ]] && return 0
      [[ "${actual_part}" > "${required_part}" ]]
      return
    fi
    ((index += 1))
  done
  return 0
}

check_active_core() {
  local candidate="$1"
  local format pack_count index kind required seen=' '
  semver_at_least "${candidate}" "0.0.0" || return 1
  format="$(/usr/bin/plutil -extract format raw -o - "${active_state}")" || return 1
  [[ "${format}" == io.github.ares-x.linnet.active-set.v1 ]] || return 1
  pack_count="$(/usr/bin/plutil -extract packs raw -o - "${active_state}")" || return 1
  [[ "${pack_count}" == 4 ]] || return 1
  for ((index = 0; index < pack_count; index += 1)); do
    kind="$(/usr/bin/plutil -extract "packs.${index}.kind" raw -o - "${active_state}")" ||
      return 1
    required="$(/usr/bin/plutil -extract "packs.${index}.min_core" raw -o - "${active_state}")" ||
      return 1
    case "${kind}" in chinese|english|lts|extended) ;; *) return 1 ;; esac
    [[ "${seen}" != *" ${kind} "* ]] || return 1
    seen+="${kind} "
    semver_at_least "${candidate}" "${required}" || return 1
  done
}

[[ "${user_home}" == /* ]] && secure_owned_path "${user_home}" directory || {
  echo "Linnet Core preinstall: current user home is unavailable" >&2
  exit 1
}
secure_owned_path "${library_root}" directory || {
  echo "Linnet Core preinstall: user Library is unsafe" >&2
  exit 1
}
[[ -f "${candidate_file}" && ! -L "${candidate_file}" && \
  -f "${mode_file}" && ! -L "${mode_file}" && \
  -f "${identity_helper}" && ! -L "${identity_helper}" && \
  -x "${identity_helper}" && \
  -f "${identity_metadata}" && ! -L "${identity_metadata}" ]] || {
  echo "Linnet Core preinstall: compatibility metadata is unavailable" >&2
  exit 1
}
IFS= read -r candidate_core_version <"${candidate_file}"
IFS= read -r install_mode <"${mode_file}"
[[ -n "${candidate_core_version}" ]] || exit 1
case "${install_mode}" in
  core-update|complete) ;;
  *)
    echo "Linnet Core preinstall: package installation mode is invalid" >&2
    exit 1
    ;;
esac

# This is the pre-payload half of the Registry's canonical-root invariant.
# Missing leaves are valid on first install. Every existing component of both
# Installer destinations must already be an owned, non-writable real directory;
# validate the complete chains before classifying a clean Complete install.
payload_directories=(
  "${input_methods_root}"
  "${app_path}"
  "${application_support_root}"
  "${support_root}"
  "${support_root}/Data"
  "${support_root}/Data/Packs"
  "${support_root}/Data/Packs/chinese"
  "${support_root}/Data/Packs/english"
  "${support_root}/Data/Packs/lts"
  "${support_root}/Data/Packs/extended"
  "${support_root}/Runtime"
  "${support_root}/Runtime/Active"
  "${state_root}"
)
for payload_directory in "${payload_directories[@]}"; do
  require_secure_directory_if_present "${payload_directory}"
done

# The package-owned candidate identity is the only authority for deciding
# whether an existing integrity-checked App can be replaced or a missing App
# can be restored without inferring prior enablement. It validates without
# running installed code and returns one typed transition before mutation.
identity_transition="$("${identity_helper}" existing)" || exit 1

# Complete is only a clean first install or a reinstall after the official
# uninstaller removed App, Active, and state. Preserved UserData, Backups,
# Transactions, and preferences do not participate in this installed-state
# decision. Never let Complete overwrite an existing or partially removed App;
# a healthy installation must use Core and therefore earns no second logout.
if [[ "${install_mode}" == complete ]]; then
  if [[ -e "${app_path}" || -L "${app_path}" || \
    -e "${active_state}" || -L "${active_state}" || \
    -e "${state_link}" || -L "${state_link}" ]]; then
    echo "Linnet Complete requires a clean first install or completed uninstall. Use Linnet Core for an existing installation." >&2
    exit 1
  fi
  exit 0
fi

# Core is the only in-place App update or repair product. A missing App carries
# no prior enablement intent: it may restore the accepted candidate, but it is
# registered without being enabled or selected on the user's behalf.
case "${identity_transition}" in
  legacy-community-adhoc-to-cms|same-community-cms-leaf|missing-app-install) ;;
  *)
    echo "Linnet Core preinstall: App identity transition is invalid" >&2
    exit 1
    ;;
esac

# Core cannot install without the complete product's authoritative Active
# language state.
if [[ ! -e "${active_state}" && ! -L "${active_state}" && \
  ! -e "${state_link}" && ! -L "${state_link}" ]]; then
  echo "Linnet Core update requires an existing Complete installation. Install Linnet.pkg first." >&2
  exit 1
fi

# Existing language data is authoritative. Reject an older Core before its
# payload mutates the installed App; a damaged or partial active state also
# fails closed instead of replacing the last executable that may still work.
[[ -L "${state_link}" && "$(readlink "${state_link}")" == \
  "../Runtime/Active/activation.json" ]] && \
  secure_owned_path "${active_state}" file || {
  echo "Linnet Core preinstall: active language state is incomplete" >&2
  exit 1
}
check_active_core "${candidate_core_version}" || {
  echo "Linnet Core preinstall: active language data requires a newer Core" >&2
  exit 1
}

# Distribution must-close is the early Installer UI boundary. Enforce the
# Settings mutation-time invariant again after every compatibility check and
# immediately before allowing payload replacement. The InputMethodKit Host
# deliberately remains alive: existing client applications keep their server
# connection while new bytes wait for the next natural Host launch. Settings
# can reject the normal quit request while work or an unsaved draft is active;
# any refusal or relaunch leaves the process visible and fails this preinstall.
[[ -f "${application_quiescer}" && ! -L "${application_quiescer}" ]] || {
  echo "Linnet Core preinstall: application quiescence owner is unavailable" >&2
  exit 1
}
quiescer_mode="$(/usr/bin/stat -f '%Lp' "${application_quiescer}")" || {
  echo "Linnet Core preinstall: application quiescence owner cannot be inspected" >&2
  exit 1
}
(( (8#${quiescer_mode} & 0022) == 0 )) || {
  echo "Linnet Core preinstall: application quiescence owner is unsafe" >&2
  exit 1
}
/usr/bin/osascript -l JavaScript "${application_quiescer}" 30 \
  io.github.ares-x.inputmethod.Linnet.settings >/dev/null || {
  echo "Linnet Core update requires Settings to quit cleanly before replacement" >&2
  exit 1
}

exit 0
