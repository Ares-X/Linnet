#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "LinnetSettingsResource.h"

IDD_LINNET_SETTINGS DIALOGEX 0, 0, 520, 260
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Linnet Settings / 设置"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_LINNET_TABS, WC_TABCONTROL, WS_TABSTOP, 10, 10, 500, 209
    CONTROL "", IDC_LINNET_LIST, WC_LISTVIEW, LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 20, 38, 480, 145
    COMBOBOX IDC_LINNET_CHOICE, 20, 190, 300, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_LINNET_CODE, 20, 190, 100, 16, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_LINNET_TEXT, 130, 190, 190, 16, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "添加/修改 Add/Edit", IDC_LINNET_ADD, 330, 189, 100, 20
    PUSHBUTTON "删除 Delete", IDC_LINNET_REMOVE, 436, 189, 64, 20
    PUSHBUTTON "字体 Font…", IDC_LINNET_FONT, 330, 190, 80, 20
    PUSHBUTTON "恢复默认 Reset", IDC_LINNET_RESET, 420, 190, 80, 20
    PUSHBUTTON "备份到文件夹 / Back up…", IDC_LINNET_BACKUP, 25, 45, 225, 26
    PUSHBUTTON "从备份恢复 / Restore…", IDC_LINNET_RESTORE, 270, 45, 225, 26
    PUSHBUTTON "选择同步文件夹 / Sync folder…", IDC_LINNET_SYNC_FOLDER, 25, 79, 225, 26
    PUSHBUTTON "立即同步学习数据 / Sync now", IDC_LINNET_SYNC, 270, 79, 225, 26
    PUSHBUTTON "导出诊断 / Export diagnostics…", IDC_LINNET_DIAGNOSTICS, 25, 113, 225, 26
    PUSHBUTTON "Rime 词典导入/导出 / Dictionaries…", IDC_LINNET_DICTIONARIES, 270, 113, 225, 26
    CONTROL "每小时自动同步学习数据 / Automatically sync learning hourly", IDC_LINNET_AUTO_SYNC, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 25, 144, 470, 16
    LTEXT "", IDC_LINNET_DATA_NOTE, 25, 162, 470, 23
    PUSHBUTTON "检查应用更新 / Check for app updates…", IDC_LINNET_UPDATE, 25, 45, 470, 24
    LTEXT "词库下载源 / Language-data source", IDC_LINNET_SOURCE_LABEL, 25, 78, 210, 12
    COMBOBOX IDC_LINNET_SOURCE, 245, 75, 250, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_LINNET_MIRROR, 25, 100, 350, 18, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "保存源 / Save source", IDC_LINNET_SAVE_SOURCE, 385, 99, 110, 20
    PUSHBUTTON "更新当前词库 / Update data", IDC_LINNET_UPDATE_DATA, 25, 131, 225, 26
    PUSHBUTTON "安装完整离线词库 / Full offline data", IDC_LINNET_COMPLETE_DATA, 270, 131, 225, 26
    LTEXT "下载时可继续输入；切换词库时短暂停用。\nInput remains available during download.", IDC_LINNET_UPDATE_NOTE, 25, 171, 350, 33
    PUSHBUTTON "取消下载 / Cancel", IDC_LINNET_CANCEL_DATA, 385, 173, 110, 24
    LTEXT "", IDC_LINNET_STATUS, 10, 225, 310, 28
    DEFPUSHBUTTON "应用 Apply", IDC_LINNET_APPLY, 330, 229, 80, 24
    PUSHBUTTON "关闭 Close", IDCANCEL, 430, 229, 80, 24
END
