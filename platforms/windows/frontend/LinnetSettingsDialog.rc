#pragma code_page(65001)
#include <windows.h>
#include <commctrl.h>
#include "LinnetSettingsResource.h"

IDD_LINNET_SETTINGS DIALOGEX 0, 0, 650, 385
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Linnet Settings / 设置"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_LINNET_TABS, WC_TABCONTROL, WS_TABSTOP, 10, 10, 630, 325
    CONTROL "", IDC_LINNET_LIST, WC_LISTVIEW, LVS_REPORT | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 20, 38, 610, 244
    COMBOBOX IDC_LINNET_CHOICE, 20, 290, 440, 150, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_LINNET_CODE, 20, 290, 150, 16, ES_AUTOHSCROLL | WS_TABSTOP
    EDITTEXT IDC_LINNET_TEXT, 180, 290, 270, 16, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON "添加/修改 Add/Edit", IDC_LINNET_ADD, 460, 289, 100, 20
    PUSHBUTTON "删除 Delete", IDC_LINNET_REMOVE, 566, 289, 64, 20
    PUSHBUTTON "字体 Font…", IDC_LINNET_FONT, 470, 290, 80, 20
    PUSHBUTTON "恢复默认 Reset", IDC_LINNET_RESET, 555, 290, 75, 20
    PUSHBUTTON "备份到文件夹 / Back up…", IDC_LINNET_BACKUP, 25, 52, 265, 28
    PUSHBUTTON "从备份恢复 / Restore…", IDC_LINNET_RESTORE, 330, 52, 265, 28
    PUSHBUTTON "选择同步文件夹 / Sync folder…", IDC_LINNET_SYNC_FOLDER, 25, 95, 265, 28
    PUSHBUTTON "立即同步学习数据 / Sync now", IDC_LINNET_SYNC, 330, 95, 265, 28
    PUSHBUTTON "导出诊断 / Export diagnostics…", IDC_LINNET_DIAGNOSTICS, 25, 138, 265, 28
    PUSHBUTTON "Rime 词典导入/导出 / Dictionaries…", IDC_LINNET_DICTIONARIES, 330, 138, 265, 28
    LTEXT "", IDC_LINNET_DATA_NOTE, 25, 187, 575, 118
    LTEXT "", IDC_LINNET_STATUS, 10, 342, 445, 32
    DEFPUSHBUTTON "应用 Apply", IDC_LINNET_APPLY, 470, 348, 80, 24
    PUSHBUTTON "关闭 Close", IDCANCEL, 560, 348, 80, 24
END
