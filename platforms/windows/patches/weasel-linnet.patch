+LRESULT WeaselPanel::OnRightClicked(UINT, WPARAM, LPARAM position, BOOL&) {
+  if (hide_candidates || !m_layout || m_ctx.cinfo.empty() || m_status.schema_id == L".default") return 0;
+  CPoint point(GET_X_LPARAM(position), GET_Y_LPARAM(position));
+  size_t index = m_ctx.cinfo.candies.size();
+  for (size_t i = 0; i < m_ctx.cinfo.candies.size(); ++i) {
+    CRect rect = m_layout->GetCandidateRect(int(i));
+    if (rect.IsRectEmpty()) continue;
+    if (m_istorepos) rect.OffsetRect(0, m_offsetys[i]);
+    rect.InflateRect(DPI_SCALE(m_style.hilite_padding_x), DPI_SCALE(m_style.hilite_padding_y));
+    if (rect.PtInRect(point)) { index = i; break; }
+  }
+  if (index == m_ctx.cinfo.candies.size()) return 0;
+  // Copy before opening the menu: a focus notification may update the panel.
+  const auto word = m_ctx.cinfo.candies[index].str;
+  const Context publication = m_ctx;
+  HMENU menu = CreatePopupMenu();
+  AppendMenuW(menu, MF_STRING, 1, L"忘记此候选的学习记录 / Forget learning");
+  AppendMenuW(menu, MF_STRING, 2, L"加入个人词 / Add to custom words…");
+  if (m_style.candidate_expansion_allowed)
+    AppendMenuW(menu, MF_STRING, 3, m_ctx.cinfo.expanded ? L"收起候选 / Collapse" : L"展开候选 / Expand");
+  ClientToScreen(&point);
+  const UINT command = TrackPopupMenu(menu, TPM_RETURNCMD | TPM_NONOTIFY | TPM_RIGHTBUTTON,
+                                      point.x, point.y, 0, m_hWnd, nullptr);
+  DestroyMenu(menu);
+  // A modal menu can process focus/composition updates. Never apply the old
+  // candidate index to a replacement publication.
+  if (m_ctx != publication || !IsWindowVisible()) return 0;
+  if (command == 1 && _candidateAction) _candidateAction(FORGET_CANDIDATE, index);
+  if (command == 3 && _candidateAction) _candidateAction(TOGGLE_CANDIDATE_EXPANSION, 0);
+  if (command == 2) {
+    // Quote a single Windows argv value, never a shell command. Opening this
+    // endpoint creates an editable draft; it does not save personal data.
+    std::wstring quoted = L"\"";
+    size_t slashes = 0;
+    for (wchar_t ch : word) {
+      if (ch == L'\\') { ++slashes; continue; }
+      quoted.append(ch == L'\"' ? slashes * 2 + 1 : slashes, L'\\');
+      quoted += ch;
+      slashes = 0;
+    }
+    quoted.append(slashes * 2, L'\\');
+    quoted += L'\"';
+    std::wstring installed;
+    if (RegGetStringValue(HKEY_LOCAL_MACHINE, WEASEL_REG_KEY, L"WeaselRoot", installed) != ERROR_SUCCESS) return 0;
+    const auto deployer = fs::path(installed) / L"WeaselDeployer.exe";
+    const auto arguments = L"/add-word " + quoted;
+    ShellExecuteW(m_hWnd, L"open", deployer.c_str(), arguments.c_str(), nullptr, SW_SHOWNORMAL);
+  }
+  return 0;
+}
