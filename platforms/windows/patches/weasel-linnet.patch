+bool ClientImpl::ShutdownServer() {
+  constexpr DWORD kShutdownTimeoutMs = 10000;
+  DWORD process_id = channel.ServerProcessId();
+  if (!process_id)
+    return false;
+  HANDLE process = OpenProcess(SYNCHRONIZE, FALSE, process_id);
+  if (!process)
+    return false;
+  _SendMessage(WEASEL_IPC_SHUTDOWN_SERVER, 0, 0);
+  channel.Disconnect();
+  DWORD wait_result = WaitForSingleObject(process, kShutdownTimeoutMs);
+  CloseHandle(process);
+  return wait_result == WAIT_OBJECT_0;
 }
 
