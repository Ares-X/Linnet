+bool UIStyleSettings::SelectColorScheme(const std::string& color_scheme_id) {
+  constexpr char kLinnetPrefix[] = "linnet_";
+  constexpr char kLightSuffix[] = "_light";
+  const size_t suffix_length = sizeof(kLightSuffix) - 1;
+  if (color_scheme_id.compare(0, sizeof(kLinnetPrefix) - 1,
+                              kLinnetPrefix) == 0 &&
+      color_scheme_id.size() >= suffix_length &&
+      color_scheme_id.compare(color_scheme_id.size() - suffix_length,
+                              suffix_length, kLightSuffix) == 0) {
+    const std::string family =
+        color_scheme_id.substr(0, color_scheme_id.size() - suffix_length);
+    const std::string dark_scheme = family + "_dark";
+    api_->customize_string(settings_, "style/color_scheme",
+                           color_scheme_id.c_str());
+    api_->customize_string(settings_, "style/color_scheme_dark",
+                           dark_scheme.c_str());
+  } else {
+    api_->customize_string(settings_, "style/color_scheme",
+                           color_scheme_id.c_str());
+  }
   return true;
 }
