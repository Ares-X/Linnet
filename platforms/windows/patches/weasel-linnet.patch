 }
 
+bool CCandidateList::ProcessCandidateKeyEvent(const KeyEvent& key, Client& client) {
+  if (!_ui || !_ui->candidate_geometry.expanded || (key.mask & ~ibus::LOCK_MASK))
+    return false;
+  const auto& geometry = _ui->candidate_geometry;
+  if (key.keycode == ibus::Up || key.keycode == ibus::Down) {
+    client.HighlightCandidateOnCurrentPage(key.keycode == ibus::Up ? geometry.previous : geometry.next);
+    return true;
+  }
+  if (key.keycode >= '1' && key.keycode <= '9') {
+    const int index = geometry.numbers[key.keycode - '1'];
+    if (index >= 0) client.SelectCandidateOnCurrentPage(index);
+    // Fetch the normal commit/context response through the existing key path.
+    client.ProcessKeyEvent(KeyEvent(0, 0));
+    return true;
+  }
+  // Publish geometry without deciding whether a printable symbol is paging.
+  // The shared Rime processor remains the sole owner of that classification.
+  client.CandidateRows(geometry.previous, geometry.next);
+  return false;
+}
