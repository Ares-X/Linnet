+  swprintf_s<128>(buffer, format, current.at(id).str.c_str());
   return std::wstring(buffer);
 }
 
+void StandardLayout::DoExpandedLayout(CDCHandle dc, PDWR pDWR,
+                                      const CRect& workArea, CandidateGeometry& geometry) {
+  geometry = CandidateGeometry();
+  geometry.expanded = true;
+  const int count = (std::min)(candidates_count, MAX_CANDIDATES_COUNT);
+  const bool horizontal = _style.layout_type == UIStyle::LAYOUT_HORIZONTAL ||
+                          _style.layout_type == UIStyle::LAYOUT_HORIZONTAL_FULLSCREEN;
+  const int rowLimit = horizontal ? _style.expanded_rows : _style.expanded_vertical_count;
+  int columns = horizontal ? (std::min)(_style.expanded_columns, count) : 1;
+  const int left = offsetX + real_margin_x;
+  const int available = (std::max)(1, workArea.Width() - 2 * left);
+  const int maximum = _style.max_width > 0
+      ? (std::min)(available, (std::max)(1, _style.max_width - 2 * real_margin_x))
+      : available;
+  _style.max_width = maximum;
+  int top = offsetY + real_margin_y;
+  int width = 0;
+  for (const auto& item : {std::make_pair(&_context.preedit, &_preeditRect),
+                            std::make_pair(&_context.aux, &_auxiliaryRect)}) {
+    if (item.first->empty() || (item.first == &_context.preedit && IsInlinePreedit())) continue;
+    CSize size = GetPreeditSize(dc, *item.first, pDWR->pPreeditTextFormat, pDWR);
+    item.second->SetRect(left, top, left + size.cx, top + size.cy);
+    top += size.cy + _style.spacing;
+    width = (std::max)(width, int(size.cx));
+  }
+  CSize labelSize;
+  GetTextSizeDW(L"9.", 2, pDWR->pLabelTextFormat, pDWR, &labelSize);
+  const int labelWidth = labelFontValid ? labelSize.cx + _style.hilite_spacing : 0;
+  std::vector<int> widths(count);
+  for (int i = 0; i < count; ++i) {
+    CSize size;
+    GetTextSizeDW(candidates[i].str, candidates[i].str.size(), pDWR->pTextFormat, pDWR, &size);
+    widths[i] = labelWidth + size.cx;
+    _candidateRects[i].SetRectEmpty();
+    _candidateLabelRects[i].SetRectEmpty();
+    _candidateTextRects[i].SetRectEmpty();
+    _candidateCommentRects[i].SetRectEmpty();
+  }
+  int firstRow = 0, lastRow = 0;
+  std::vector<int> columnWidths;
+  // Match the shared design: preserve whole words and column guides, reducing
+  // the number of columns before narrowing the final single-column surface.
+  for (; columns >= 1; --columns) {
+    const int selectedRow = id / columns;
+    firstRow = selectedRow / rowLimit * rowLimit;
+    lastRow = (std::min)((count + columns - 1) / columns, firstRow + rowLimit);
+    columnWidths.assign(columns, 1);
+    for (int i = firstRow * columns; i < (std::min)(count, lastRow * columns); ++i)
+      columnWidths[i % columns] = (std::max)(columnWidths[i % columns], widths[i]);
+    int total = _style.candidate_spacing * (columns - 1);
+    for (int cell : columnWidths) total += cell;
+    if (total <= maximum || columns == 1) break;
+  }
+  if (columns == 1) columnWidths[0] = (std::min)(columnWidths[0], maximum);
+  _expandedLabels.assign(count, Text());
+  const int rowStart = id / columns * columns;
+  for (int i = firstRow * columns; i < (std::min)(count, lastRow * columns); ++i) {
+    const int number = horizontal ? (i / columns == id / columns ? i - rowStart : -1)
+                                  : i - firstRow;
+    if (number >= 0 && number < int(geometry.numbers.size())) {
+      geometry.numbers[number] = i;
+      _expandedLabels[i].str = std::to_wstring(number + 1);
+    }
+  }
+  geometry.previous = id >= columns ? id - columns : -1;
+  geometry.next = id + columns < count ? id + columns
+      : (id / columns < (count - 1) / columns ? count - 1 : count);
+  for (int row = firstRow; row < lastRow; ++row) {
+    int rowHeight = labelSize.cy;
+    for (int i = row * columns; i < (std::min)(count, (row + 1) * columns); ++i) {
+      if (SUCCEEDED(pDWR->CreateTextLayout(candidates[i].str, int(candidates[i].str.size()),
+          pDWR->pTextFormat.Get(), float((std::max)(1, columnWidths[i % columns] - labelWidth)), 0))) {
+        DWRITE_TEXT_METRICS metrics = {};
+        if (SUCCEEDED(pDWR->GetLayoutMetrics(&metrics)))
+          rowHeight = (std::max)(rowHeight, int(ceil(metrics.height)));
+      }
+    }
+    int x = left;
+    for (int i = row * columns; i < (std::min)(count, (row + 1) * columns); ++i) {
+      const int cellWidth = columnWidths[i % columns];
+      _candidateRects[i].SetRect(x, top, x + cellWidth, top + rowHeight);
+      _candidateLabelRects[i].SetRect(x, top, x + labelWidth, top + rowHeight);
+      _candidateTextRects[i].SetRect(x + labelWidth, top, x + cellWidth, top + rowHeight);
+      x += cellWidth + _style.candidate_spacing;
+    }
+    width = (std::max)(width, x - left - _style.candidate_spacing);
+    top += rowHeight + _style.candidate_spacing;
+  }
+  _contentSize.SetSize(width + 2 * left,
+      top - _style.candidate_spacing + offsetY + real_margin_y);
+  _contentRect.SetRect(0, 0, _contentSize.cx, _contentSize.cy);
+  _highlightRect = _candidateRects[id];
+  _bgRect = _contentRect;
+  _bgRect.DeflateRect(offsetX + 1, offsetY + 1);
+  _contentRect.DeflateRect(offsetX, offsetY);
+}
+
+void StandardLayout::AddDetail(PDWR pDWR, const std::wstring& text,
+                               const CRect& workArea, bool disclosure) {
+  _detailRect.SetRectEmpty();
+  _detailDividerRect.SetRectEmpty();
+  _disclosureRect.SetRectEmpty();
+  _disclosureText = _context.cinfo.expanded ? L"收起 ∧" : L"展开 ∨";
+  const int left = offsetX + real_margin_x;
+  int bodyWidth = (std::max)(1, int(_contentSize.cx) - 2 * left);
+  CSize control;
+  if (disclosure) {
+    GetTextSizeDW(_disclosureText, _disclosureText.size(), pDWR->pLabelTextFormat, pDWR, &control);
+    const int growth = (std::max)(0, int(control.cx) - bodyWidth);
+    bodyWidth += growth;
+    _contentSize.cx += growth;
+    _contentRect.right += growth;
+    _bgRect.right += growth;
+  }
+  const int bodyBottom = _contentSize.cy - offsetY - real_margin_y;
+  int bottom = bodyBottom;
+  const bool sidecar = _style.layout_type == UIStyle::LAYOUT_VERTICAL ||
+                       _style.layout_type == UIStyle::LAYOUT_VERTICAL_FULLSCREEN;
+  const int detailLeft = sidecar ? left + bodyWidth + 2 * _style.spacing + 1 : left;
+  const int maximumWidth = sidecar ? _style.detail_sidecar_width : _style.detail_footer_width;
+  const int availableWidth = sidecar
+      ? workArea.Width() - detailLeft - left : bodyWidth;
+  const int width = (std::min)(maximumWidth, availableWidth);
+  if (!text.empty() && width > 0 && pDWR->pCommentTextFormat &&
+      SUCCEEDED(pDWR->CreateTextLayout(text, int(text.size()),
+          pDWR->pCommentTextFormat.Get(), float(width), 0))) {
+    DWRITE_TEXT_METRICS metrics = {};
+    if (SUCCEEDED(pDWR->GetLayoutMetrics(&metrics))) {
+      const int top = sidecar ? offsetY + real_margin_y : bodyBottom + _style.spacing;
+      int height = int(ceil(metrics.height));
+      if (sidecar) {
+        height = (std::min)(height, bodyBottom - top);
+      } else {
+        UINT32 count = 0;
+        pDWR->pTextLayout->GetLineMetrics(nullptr, 0, &count);
+        std::vector<DWRITE_LINE_METRICS> lines(count);
+        if (count && SUCCEEDED(pDWR->pTextLayout->GetLineMetrics(lines.data(), count, &count))) {
+          float visibleHeight = 0;
+          for (UINT32 i = 0; i < count && i < linnet_design::footer_detail_lines; ++i)
+            visibleHeight += lines[i].height;
+          height = int(ceil(visibleHeight));
+        }
+        height = (std::min)(height, (std::max)(0, workArea.Height() -
+            top - int(control.cy) - 2 * real_margin_y - _style.spacing));
+      }
+      _detailRect.SetRect(detailLeft, top, detailLeft + width, top + height);
+      if (sidecar) {
+        _detailDividerRect.SetRect(left + bodyWidth + _style.spacing, top,
+            left + bodyWidth + _style.spacing + 1, bodyBottom);
+        const int growth = 2 * _style.spacing + 1 + width;
+        _contentSize.cx += growth;
+        _contentRect.right += growth;
+        _bgRect.right += growth;
+      } else {
+        bottom = top + height;
+      }
+    }
+  }
+  if (disclosure) {
+    bottom += _style.spacing;
+    const int right = _contentSize.cx - left;
+    _disclosureRect.SetRect(right - control.cx, bottom, right, bottom + control.cy);
+    bottom += control.cy;
+  }
+  const int extra = bottom - bodyBottom;
+  _contentSize.cy += extra;
+  _contentRect.bottom += extra;
+  _bgRect.bottom += extra;
+}
