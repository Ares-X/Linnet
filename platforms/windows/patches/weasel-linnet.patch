+Function MovePackageFiles
+  StrCpy $LinnetMoveFailed 0
+  ClearErrors
+  CreateDirectory "$LinnetMoveTarget"
+  IfErrors package_move_failed
+  ${Locate} "$LinnetMoveSource" "/L=FDE" "MovePackageEntry"
+  IfErrors package_move_failed
+  StrCmp $LinnetMoveFailed 0 0 package_move_done
+  RMDir /r "$LinnetMoveSource"
+  IfErrors package_move_failed
+  GoTo package_move_done
+package_move_failed:
+  StrCpy $LinnetMoveFailed 1
+package_move_done:
+  Push $LinnetMoveFailed
+FunctionEnd
+
+Function MovePackageEntry
+  Push $0
+  StrLen $0 $LinnetMoveSource
+  StrCpy $0 $R8 "" $0
+  ClearErrors
+  CreateDirectory "$LinnetMoveTarget$0"
+  IfErrors package_entry_failed
+  StrCmp $R6 "" package_entry_directory
+  Rename "$R9" "$LinnetMoveTarget$0\$R7"
+  GoTo package_entry_checked
+package_entry_directory:
+  CreateDirectory "$LinnetMoveTarget$0\$R7"
+package_entry_checked:
+  IfErrors package_entry_failed
+  Pop $0
+  Push ""
+  Return
+package_entry_failed:
+  DetailPrint "Could not move $R9 into $LinnetMoveTarget."
+  StrCpy $LinnetMoveFailed 1
+  Pop $0
+  Push "StopLocate"
