+
+bool RimeWithWeaselHandler::CandidateAction(UINT action, size_t index, WeaselSessionId ipc_id, EatLine eat) {
+  if (m_disabled) return false;
+  auto& view = get_session_status(ipc_id);
+  bool result = false;
+  if (action == TOGGLE_CANDIDATE_EXPANSION && view.candidate_ui && view.style.candidate_expansion_allowed) {
+    view.expanded = !view.expanded;
+    result = true;
+  } else if (action == FORGET_CANDIDATE) {
+    result = view.expanded ? rime_api->delete_candidate(view.session_id, view.candidate_base + index)
+                           : rime_api->delete_candidate_on_current_page(view.session_id, index);
+  }
+  _Respond(ipc_id, eat);
+  _UpdateUI(ipc_id);
+  return result;
+}
