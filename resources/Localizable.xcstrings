    "Tune completion, pronunciation, translation, and correction together." : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"统一调整补全、发音、翻译和纠错。"}}}},
    "Candidate suggestions" : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"候选建议"}}}},
    "Typing behavior" : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"输入行为"}}}},
    "English…" : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"英文…"}}}},
    "Follow System" : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"跟随系统"}}}},
    "Horizontal" : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"横排"}}}},
    "Input" : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"输入"}}}},
    "Configure Chinese and Smart English behavior in one place." : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"在一处配置中文与智能英文输入行为。"}}}},
    "Chinese Input" : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"中文输入"}}}},
    "Configure input behavior. Choose your Chinese scheme and reverse-lookup preferences here." : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"在这里配置中文方案、输入行为与拼音反查偏好。"}}}},
    "Chinese scheme" : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"中文方案"}}}},
    "Natural Code" : {"localizations":{"zh-Hans":{"stringUnit":{"state":"translated","value":"自然码双拼"}}}},
