        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deploying Rime input method engine."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部署输入法引擎…"
          }
        }
      }
