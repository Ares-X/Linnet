relationships = [
  relationship("SPDXRef-Package-Linnet", "VARIANT_OF", "SPDXRef-Package-Squirrel"),
  relationship("SPDXRef-Package-Linnet", "DYNAMIC_LINK", "SPDXRef-Package-librime"),
  relationship("SPDXRef-Package-Linnet", "DYNAMIC_LINK", "SPDXRef-Package-librime-lua"),
  relationship(
    "SPDXRef-Package-Linnet", "DYNAMIC_LINK", "SPDXRef-Package-librime-octagram"
  ),
  relationship(
    "SPDXRef-Package-Linnet", "DYNAMIC_LINK", "SPDXRef-Package-librime-predict"
  ),
  relationship("SPDXRef-Package-Linnet", "DEPENDS_ON", "SPDXRef-Package-rime-ice"),
  relationship("SPDXRef-Package-Linnet", "DEPENDS_ON", "SPDXRef-Package-Hallelujah"),
  relationship(
    "SPDXRef-Package-Linnet", "DEPENDS_ON", "SPDXRef-Package-rime-wanxiang"
  ),
  relationship("SPDXRef-Package-Linnet", "DEPENDS_ON", "SPDXRef-Package-RIME-LMDG"),
  relationship(
    "SPDXRef-Package-librime-lua", "DYNAMIC_LINK", "SPDXRef-Package-librime"
  ),
  relationship("SPDXRef-Package-librime-lua", "CONTAINS", "SPDXRef-Package-Lua"),
  relationship(
    "SPDXRef-Package-librime-lua", "STATIC_LINK", "SPDXRef-Package-Boost"
  ),
  relationship(
    "SPDXRef-Package-librime-octagram", "DYNAMIC_LINK", "SPDXRef-Package-librime"
  ),
  relationship(
    "SPDXRef-Package-librime-predict", "DYNAMIC_LINK", "SPDXRef-Package-librime"
  ),
  relationship(
    "SPDXRef-Package-librime-predict", "STATIC_LINK", "SPDXRef-Package-Boost"
  ),
  relationship(
    "SPDXRef-Package-librime-octagram", "STATIC_LINK", "SPDXRef-Package-Boost"
  ),
  relationship("SPDXRef-Package-Linnet", "STATIC_LINK", "SPDXRef-Package-Boost"),
  relationship("SPDXRef-Package-librime", "STATIC_LINK", "SPDXRef-Package-glog"),
  relationship("SPDXRef-Package-librime", "STATIC_LINK", "SPDXRef-Package-LevelDB"),
  relationship("SPDXRef-Package-librime", "STATIC_LINK", "SPDXRef-Package-marisa"),
  relationship("SPDXRef-Package-librime", "STATIC_LINK", "SPDXRef-Package-OpenCC"),
  relationship("SPDXRef-Package-librime", "STATIC_LINK", "SPDXRef-Package-yaml-cpp"),
  relationship("SPDXRef-Package-librime", "STATIC_LINK", "SPDXRef-Package-Boost"),
  relationship("SPDXRef-Package-librime", "CONTAINS", "SPDXRef-Package-Darts-clone"),
  relationship(
    "SPDXRef-Package-librime-octagram", "STATIC_LINK", "SPDXRef-Package-Darts-clone"
  ),
  relationship(
    "SPDXRef-Package-librime-predict", "STATIC_LINK", "SPDXRef-Package-Darts-clone"
  ),
  relationship("SPDXRef-Package-OpenCC", "CONTAINS", "SPDXRef-Package-RapidJSON")
]

sbom = {
  "spdxVersion" => "SPDX-2.3",
  "dataLicense" => "CC0-1.0",
  "SPDXID" => "SPDXRef-DOCUMENT",
  "name" => release_name,
  "documentNamespace" =>
    "https://spdx.org/spdxdocs/io.github.ares-x.inputmethod.Linnet/" \
    "#{version}/#{build}/#{candidate_revision}/#{lock_sha256}",
  "creationInfo" => {
    "created" => created_at,
    "creators" => ["Tool: Linnet release metadata generator"]
  },
  "documentDescribes" => ["SPDXRef-Package-Linnet"],
  "packages" => packages,
  "relationships" => relationships
}
sbom_json = JSON.pretty_generate(sbom) + "\n"
sbom_sha256 = Digest::SHA256.hexdigest(sbom_json)

distribution = if community_identity
  {
    "application_code_signature" => {
      "profile" => "community-adhoc",
      "kind" => "adhoc",
      "hardened_runtime" => true,
      "host_settings_same_kind" => true
    },
    "artifact_scope" => "public-community",
    "notarized" => false,
    "publication_eligible" => true,
    "trust_model" => "manual-user-approval"
  }
else
  {
    "application_code_signature" => {
      "profile" => code_signing_profile,
      "kind" => "external-cms",
      "leaf_certificate_sha256" => code_identity.fetch("leaf_certificate_sha256"),
      "hardened_runtime" => true,
      "host_settings_same_leaf" => true
    },
    "artifact_scope" => "installation-uat",
    "notarized" => false,
    "publication_eligible" => false
  }
end

version_manifest = {
  "format" => 2,
  "product" => "Linnet",
  "version" => version,
  "build" => build,
  "channel" => "community-beta",
  "architecture" => "arm64",
  "minimum_macos" => "13.0",
  "source" => {
    "candidate_revision" => code_identity.fetch("candidate_revision")
  },
  "distribution" => distribution,
  "upstream_lock_sha256" => lock_sha256,
  "sbom_sha256" => sbom_sha256,
  "direct_product_upstreams" => [
    {
      "group" => "squirrel_rime",
      "squirrel" => squirrel.slice("tag", "commit", "repository"),
      "librime" => librime.slice("tag", "commit", "repository")
    },
    { "group" => "rime_ice" }.merge(rime_ice.slice("tag", "commit", "repository")),
    { "group" => "hallelujah" }.merge(hallelujah.slice("tag", "commit", "repository", "declared_license")),
    { "group" => "rime_wanxiang" }.merge(
      rime_wanxiang.slice("tag", "commit", "repository", "declared_license")
    ),
    { "group" => "rime_lmdg_grammar" }.merge(
      rime_lmdg_grammar.slice(
        "release", "asset", "repository", "declared_license", "bytes", "sha256"
      )
    )
  ]
}

File.write(File.join(output_path, "NOTICE.md"), notice)
licenses_path = File.join(output_path, "LICENSES")
FileUtils.mkdir_p(licenses_path)
runtime_license_specs.each_key do |filename|
  FileUtils.cp(
    File.join(runtime_license_root, filename), File.join(licenses_path, filename)
  )
end
wanxiang_license = File.join(
  source_root,
  rime_wanxiang.fetch("submodule_path"),
  rime_wanxiang.fetch("license_path")
)
fail_release("Rime Wanxiang license differs from the release lock") unless
  File.file?(wanxiang_license) && !File.symlink?(wanxiang_license) &&
    Digest::SHA256.file(wanxiang_license).hexdigest ==
      rime_wanxiang.fetch("license_sha256")
FileUtils.cp(wanxiang_license, File.join(licenses_path, "Rime-wanxiang-CC-BY-4.0.txt"))
lmdg_license = File.join(source_root, rime_lmdg_grammar.fetch("license_path"))
fail_release("Rime LMDG license differs from the release lock") unless
  File.file?(lmdg_license) && !File.symlink?(lmdg_license) &&
    Digest::SHA256.file(lmdg_license).hexdigest ==
      rime_lmdg_grammar.fetch("license_sha256")
FileUtils.cp(lmdg_license, File.join(licenses_path, "RIME-LMDG-CC-BY-4.0.txt"))
File.write(File.join(output_path, "PRIVACY.md"), privacy)
File.write(File.join(output_path, "SBOM.spdx.json"), sbom_json)
File.write(File.join(output_path, "VERSION.json"), JSON.pretty_generate(version_manifest) + "\n")
