    declared: static_dependencies.dig("glog", "declared_license"),
    purpose: "LIBRARY", refs: [vcs_reference(
      static_sources.dig("glog", "repository"),
      static_sources.dig("glog", "commit")
    )]
  ),
  spdx_package(
    name: "LevelDB", id: "SPDXRef-Package-LevelDB",
    version: static_sources.dig("leveldb", "commit"),
    download: static_sources.dig("leveldb", "repository"),
    declared: static_dependencies.dig("leveldb", "declared_license"),
