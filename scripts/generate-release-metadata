    comment: "Exact candidate revision #{candidate_revision}; includes the " \
      "Host, embedded Settings app and first-party Smart English plugin."
  ),
  spdx_package(
    name: "Squirrel", id: "SPDXRef-Package-Squirrel",
    version: squirrel.fetch("tag"), download: squirrel.fetch("repository"),
    declared: squirrel.fetch("declared_license"), purpose: "APPLICATION",
    refs: [vcs_reference(squirrel.fetch("repository"), squirrel.fetch("commit"))]
  ),
  spdx_package(
    name: "librime", id: "SPDXRef-Package-librime",
    version: librime.fetch("tag"), download: librime.fetch("repository"),
    declared: librime.fetch("declared_license"), purpose: "LIBRARY",
    refs: [vcs_reference(librime.fetch("repository"), librime_commit)]
  ),
  spdx_package(
    name: "librime-lua", id: "SPDXRef-Package-librime-lua",
    version: lua_plugin.fetch("commit"), download: lua_plugin.fetch("repository"),
    declared: lua_plugin.fetch("declared_license"),
    concluded: "(BSD-3-Clause AND MIT)", purpose: "LIBRARY",
    refs: [vcs_reference(lua_plugin.fetch("repository"), lua_plugin.fetch("commit"))],
    comment: "The plugin includes the MIT components named in " \
      "LICENSES/librime-lua-embedded-MIT.txt."
  ),
  spdx_package(
    name: "librime-octagram", id: "SPDXRef-Package-librime-octagram",
    version: octagram_plugin.fetch("commit"),
    download: octagram_plugin.fetch("repository"),
    declared: octagram_plugin.fetch("declared_license"), purpose: "LIBRARY",
    refs: [vcs_reference(
      octagram_plugin.fetch("repository"), octagram_plugin.fetch("commit")
    )],
    comment: "Shipped plugin code; no octagram model data is bundled."
  ),
  spdx_package(
    name: "librime-predict", id: "SPDXRef-Package-librime-predict",
    version: predict_plugin.fetch("commit"),
    download: predict_plugin.fetch("repository"),
    declared: predict_plugin.fetch("declared_license"), purpose: "LIBRARY",
    refs: [vcs_reference(
      predict_plugin.fetch("repository"), predict_plugin.fetch("commit")
