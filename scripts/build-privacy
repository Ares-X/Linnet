#!/usr/bin/env bash

set -euo pipefail

privacy_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/build-privacy redact
  scripts/build-privacy scan PATH...
  scripts/build-privacy sanitize-localizations APP...

Commands:
  redact            Read text from stdin and write a path-redacted stream to stdout.
  scan PATH...       Fail if an artifact contains private build paths or metadata.
  sanitize-localizations APP...
                    Remove only empty locale directories retired from the canonical string catalog.
USAGE
}

fail_privacy() {
  echo "build-privacy: $1" >&2
  exit 1
}

normalized_prefix() {
  local value="$1"
  while [[ "${value}" != "/" && "${value}" == */ ]]; do
    value="${value%/}"
  done
  printf '%s' "${value}"
}

redact_stream() {
  [[ "$#" -eq 0 ]] || {
    usage
    exit 2
  }

  local privacy_home=""
  local privacy_temp=""
  if [[ "${HOME:-}" == /* ]]; then
    privacy_home="$(normalized_prefix "${HOME}")"
  fi
  if [[ "${TMPDIR:-}" == /* ]]; then
    privacy_temp="$(normalized_prefix "${TMPDIR}")"
  fi

  LINNET_PRIVACY_REPO="${privacy_root}" \
  LINNET_PRIVACY_HOME="${privacy_home}" \
  LINNET_PRIVACY_TEMP="${privacy_temp}" \
    ruby -e '
      STDIN.binmode
      STDOUT.binmode
      text = STDIN.read.force_encoding(Encoding::BINARY)

      text.gsub!(
        %r{/(?:[^/\s"\x27<>:]+/)*DerivedData(?:/[^/\s"\x27<>:]+)?(?=/|[[:space:]"\x27=:,;)\]]|$)}n,
        "Linnet/BuildState"
      )

      replacements = [
        [ENV.fetch("LINNET_PRIVACY_REPO"), "Linnet/Workspace"],
        [ENV.fetch("LINNET_PRIVACY_HOME"), "Linnet/Home"],
        [ENV.fetch("LINNET_PRIVACY_TEMP"), "Linnet/Temp"],
        ["/private/tmp", "Linnet/Temp"],
        ["/tmp", "Linnet/Temp"],
      ].reject { |prefix, _| prefix.empty? }
       .uniq { |prefix, _| prefix }
       .sort_by { |prefix, _| -prefix.bytesize }

      replacements.each do |prefix, replacement|
        pattern = /#{Regexp.escape(prefix.b)}(?=\/|[[:space:]"\x27=:,;)\]]|$)/n
        text.gsub!(pattern, replacement)
      end

      boundary = %q{(?<![A-Za-z0-9._~:/-])}
      text.gsub!(
        /#{boundary}\/Applications\/Xcode[^\/]*\.app\/Contents\/Developer(?=\/|[[:space:]"\x27=:,;)\]]|$)/n,
        "Linnet/Toolchain"
      )
      text.gsub!(
        /#{boundary}\/Library\/Developer\/CommandLineTools(?=\/|[[:space:]"\x27=:,;)\]]|$)/n,
        "Linnet/Toolchain"
      )
      text.gsub!(
        /#{boundary}\/(?:opt\/homebrew|usr\/local\/Cellar)(?=\/|[[:space:]"\x27=:,;)\]]|$)/n,
        "Linnet/BuildTools"
      )
      text.gsub!(
        /#{boundary}\/(?:Users|home)\/[^\/\s"\x27<>:]+/n,
        "Linnet/Home"
      )
      text.gsub!(
        /#{boundary}\/builds\/[^\/\s"\x27<>:]+/n,
        "Linnet/CI"
      )
      text.gsub!(
        /#{boundary}\/(?:private\/)?var\/folders\/[^\/\s"\x27<>:]+\/[^\/\s"\x27<>:]+/n,
        "Linnet/Temp"
      )
      text.gsub!(
        /#{boundary}\/Volumes\/[^\/\s"\x27<>:]+/n,
        "Linnet/Volume"
      )
      text.gsub!(/[A-Za-z]:[\\\/]+Users[\\\/]+[^\\\/\s"\x27<>:]+/n, "Linnet/Home")
      text.gsub!(/file:\/\/\/Users\/[^\/\s"\x27<>:]+/ni, "file:///Linnet/Home")
      text.gsub!(/%2fUsers%2f[^%\s"\x27<>:]+/ni, "Linnet%2FHome")
      STDOUT.write(text)
    '
}

scan_artifacts() {
  [[ "$#" -gt 0 ]] || {
    usage
    exit 2
  }

  local privacy_home=""
  local privacy_temp=""
  [[ "${HOME:-}" == /* ]] && privacy_home="$(normalized_prefix "${HOME}")"
  [[ "${TMPDIR:-}" == /* ]] && privacy_temp="$(normalized_prefix "${TMPDIR}")"

  LINNET_PRIVACY_REPO="${privacy_root}" \
  LINNET_PRIVACY_HOME="${privacy_home}" \
  LINNET_PRIVACY_TEMP="${privacy_temp}" \
    ruby - "$@" <<'RUBY'
require "open3"

class PrivacyScanner
  MACH_MAGICS = %W[feedface cefaedfe feedfacf cffaedfe cafebabe bebafeca cafebabf bfbafeca].freeze

  def initialize
    @failures = 0
    @exact_paths = %w[LINNET_PRIVACY_REPO LINNET_PRIVACY_HOME LINNET_PRIVACY_TEMP]
      .map { |key| ENV.fetch(key).b }
      .reject(&:empty?)
    # These are audited upstream runtime filename templates, not captured
    # build roots. Keep the allowlist exact so a concrete temporary path still
    # fails the generic rules below.
    @runtime_templates = [
      "/tmp/agent-stderr.txt".b,
      "/tmp/leveldbtest-%d".b,
      "/tmp/lua_XXXXXX".b,
    ].freeze
    @runtime_literal_patterns = [
      %r{(?<![A-Za-z0-9._~:/-])/tmp(?=[\x00[:space:]"\x27=,;:)\]]|\z)}n,
    ].freeze
    boundary = %q{(?<![A-Za-z0-9._~:/-])}
    terminus = %q{(?=/|[\x00[:space:]"\x27=,;:)\]]|\z)}
    @path_patterns = [
      /#{boundary}\/Users#{terminus}/n,
      /#{boundary}\/home#{terminus}/n,
      /#{boundary}\/builds#{terminus}/n,
      /#{boundary}\/(?:private\/)?var\/folders#{terminus}/n,
      /#{boundary}\/Volumes#{terminus}/n,
      /#{boundary}\/(?:private\/)?tmp#{terminus}/n,
      /#{boundary}\/Applications\/Xcode[^\/]*\.app\/Contents\/Developer#{terminus}/n,
      /#{boundary}\/Library\/Developer\/CommandLineTools#{terminus}/n,
      /#{boundary}\/opt\/homebrew#{terminus}/n,
      /#{boundary}\/usr\/local\/Cellar#{terminus}/n,
      /file:\/\/\/Users#{terminus}/ni,
      /%2fUsers(?=%2f|[\x00[:space:]"\x27=,;:)\]]|\z)/ni,
      /[A-Za-z]:[\\\/]+Users(?=[\\\/]+|[\x00[:space:]"\x27=,;:)\]]|\z)/n,
    ]
    @marker_patterns = [
      /(?:\A|[\\\/])(?:DerivedData|Intermediates\.noindex|Index\.noindex|CMakeFiles)(?:[\\\/]|\z)/n,
      /(?:\A|[\\\/])\.DS_Store(?:[\\\/]|\z)/n,
    ]
  end

  def scan(inputs)
    inputs.each { |input| scan_root(input) }
    exit(@failures.zero? ? 0 : 1)
  rescue StandardError
    warn "build-privacy: artifact inspection failed"
    exit 1
  end

  private

  def report(label, category)
    @failures += 1
    safe = label.encode("UTF-8", invalid: :replace, undef: :replace, replace: "?")
      .gsub(/[\x00-\x1f\x7f]/, "?")
    warn "build-privacy: #{category} in relative artifact #{safe.dump}"
  end

  def views(data)
    value = data.b
    result = [value]
    value.scan(/(?:[\x20-\x7e]\x00){4,}/n) do |run|
      result << run.bytes.each_slice(2).map(&:first).pack("C*")
    end
    value.scan(/(?:\x00[\x20-\x7e]){4,}/n) do |run|
      result << run.bytes.each_slice(2).map(&:last).pack("C*")
    end
    result
  end

  def forbidden_content?(data)
    views(data).any? do |view|
      inspected = view.dup
      @runtime_templates.each { |template| inspected.gsub!(template, "") }
      @runtime_literal_patterns.each { |pattern| inspected.gsub!(pattern, "") }
      next true if @exact_paths.any? { |path| inspected.include?(path) }
      next true if @path_patterns.any? { |pattern| pattern.match?(inspected) }

      without_public_urls = inspected.gsub(%r{https?://[^\x00\s"\x27<>()]+}ni, "")
      @marker_patterns.any? { |pattern| pattern.match?(without_public_urls) }
    end
  end

  def forbidden_name?(label)
    components = label.b.split(/[\\\/]/n)
    markers = %w[DerivedData Intermediates.noindex Index.noindex CMakeFiles .DS_Store].map(&:b)
    components.any? { |component| markers.include?(component) }
  end

  def allowed_load_path?(path)
    path == "/usr/lib" || path == "/System/Library" ||
      path == "@rpath" || path == "@loader_path" || path == "@executable_path" ||
      path.start_with?("@rpath/", "@loader_path/", "@executable_path/", "/usr/lib/", "/System/Library/")
  end

  def inspect_macho(path, data)
    return false unless data.bytesize >= 4 && MACH_MAGICS.include?(data.byteslice(0, 4).unpack1("H*"))

    linked, error, status = Open3.capture3("/usr/bin/otool", "-L", path)
    raise "otool dependency inspection failed" unless status.success? && error.empty?
    linked.lines.drop(1).each do |line|
      dependency = line.strip.split.first
      return true if dependency && !allowed_load_path?(dependency)
    end

    commands, error, status = Open3.capture3("/usr/bin/otool", "-l", path)
    raise "otool load-command inspection failed" unless status.success? && error.empty?
    in_rpath = false
    commands.each_line do |line|
      fields = line.split
      if fields == %w[cmd LC_RPATH]
        in_rpath = true
      elsif in_rpath && fields.first == "path"
        return true unless fields[1] && allowed_load_path?(fields[1])
        in_rpath = false
      end
    end
    false
  end

  def inspect_entry(path, label, stat)
    if forbidden_name?(label)
      report(label, "forbidden build metadata")
      return
    end

    if stat.symlink?
      target = File.readlink(path)
      report(label, "forbidden symlink target") if forbidden_content?(target.b)
    elsif stat.file?
      data = File.binread(path)
      if forbidden_content?(data) || inspect_macho(path, data)
        report(label, "forbidden build metadata")
      end
    elsif !stat.directory?
      report(label, "unsupported artifact type")
    end
  end

  def scan_root(input)
    root = File.expand_path(input)
    root_label = File.basename(root)
    root_label = "artifact" if root_label.empty?
    stat = File.lstat(root)
    inspect_entry(root, root_label, stat)
    return unless stat.directory? && !stat.symlink?

    stack = [[root, root_label]]
    until stack.empty?
      directory, directory_label = stack.pop
      children = Dir.children(directory)
      children.reverse_each do |name|
        path = File.join(directory, name)
        label = File.join(directory_label, name)
        child_stat = File.lstat(path)
        inspect_entry(path, label, child_stat)
        stack << [path, label] if child_stat.directory? && !child_stat.symlink?
      end
    end
  end
end

PrivacyScanner.new.scan(ARGV)
RUBY
}

sanitize_localizations() {
  [[ "$#" -gt 0 ]] || {
    usage
    exit 2
  }

  local catalog="${privacy_root}/resources/Localizable.xcstrings"
  [[ -f "${catalog}" && ! -L "${catalog}" ]] ||
    fail_privacy "canonical localization catalog is unavailable"

  local expected_locales
  expected_locales="$(ruby -rjson -e '
    catalog = JSON.parse(File.read(ARGV.fetch(0)))
    locales = [catalog.fetch("sourceLanguage")]
    catalog.fetch("strings").each_value do |entry|
      locales.concat(entry.fetch("localizations", {}).keys)
    end
    puts locales.uniq.sort.map { |locale| "#{locale}.lproj" }
  ' "${catalog}")"
  [[ -n "${expected_locales}" ]] ||
    fail_privacy "canonical localization catalog declares no locales"

  local app resources locale_dir locale_name actual_locales
  for app in "$@"; do
    resources="${app}/Contents/Resources"
    [[ -d "${app}" && ! -L "${app}" && -d "${resources}" && ! -L "${resources}" ]] ||
      fail_privacy "sanitize-localizations requires regular App resources"

    while IFS= read -r -d '' locale_dir; do
      locale_name="$(basename "${locale_dir}")"
      if ! grep -Fxq "${locale_name}" <<< "${expected_locales}"; then
        if find "${locale_dir}" -mindepth 1 -print -quit | grep -q .; then
          fail_privacy "unsupported non-empty localization: ${locale_name}"
        fi
        rmdir "${locale_dir}" ||
          fail_privacy "could not retire empty localization: ${locale_name}"
      fi
    done < <(find "${resources}" -maxdepth 1 -type d -name '*.lproj' -print0)

    actual_locales="$(find "${resources}" -maxdepth 1 -type d -name '*.lproj' \
      -exec basename {} \; | LC_ALL=C sort)"
    [[ "${actual_locales}" == "${expected_locales}" ]] ||
      fail_privacy "App localization projection does not match the canonical catalog"
  done
}

main() {
  [[ "$#" -gt 0 ]] || {
    usage
    exit 2
  }

  local command="$1"
  shift
  case "${command}" in
    redact) redact_stream "$@" ;;
    scan) scan_artifacts "$@" ;;
    sanitize-localizations) sanitize_localizations "$@" ;;
    -h|--help|help)
      [[ "$#" -eq 0 ]] || {
        usage
        exit 2
      }
      usage
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
