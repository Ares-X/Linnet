#!/usr/bin/env bash

set -euo pipefail

privacy_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
privacy_workspace_name="$(basename "${privacy_root}")"

usage() {
  cat >&2 <<'USAGE'
Usage:
  scripts/build-privacy redact
  scripts/build-privacy scan PATH...
  scripts/build-privacy sanitize-localizations APP...
  scripts/build-privacy project-menu-icon OUTPUT
  scripts/build-privacy verify-menu-icon PDF

Commands:
  redact            Read text from stdin and write a path-redacted stream to stdout.
  scan PATH...       Fail if an artifact contains private build paths or metadata.
  sanitize-localizations APP...
                    Remove only empty locale directories retired from the canonical string catalog.
  project-menu-icon OUTPUT
                    Project the canonical transparent Linnet mark into the 22x16 input-source PDF.
  verify-menu-icon PDF
                    Prove the input-source PDF is the transparent vector projection of that mark.
USAGE
}

fail_privacy() {
  echo "build-privacy: $1" >&2
  exit 1
}

normalized_prefix() {
  local value="$1"
  while [[ "${value}" != "/" && "${value}" == */ ]]; do
    value="${value%/}"
  done
  printf '%s' "${value}"
}

redact_stream() {
  [[ "$#" -eq 0 ]] || {
    usage
    exit 2
  }

  local privacy_home=""
  local privacy_temp=""
  if [[ "${HOME:-}" == /* ]]; then
    privacy_home="$(normalized_prefix "${HOME}")"
  fi
  if [[ "${TMPDIR:-}" == /* ]]; then
    privacy_temp="$(normalized_prefix "${TMPDIR}")"
  fi

  LINNET_PRIVACY_REPO="${privacy_root}" \
  LINNET_PRIVACY_HOME="${privacy_home}" \
  LINNET_PRIVACY_TEMP="${privacy_temp}" \
    ruby -e '
      STDIN.binmode
      STDOUT.binmode
      text = STDIN.read.force_encoding(Encoding::BINARY)

      text.gsub!(
        %r{/(?:[^/\s"\x27<>:]+/)*DerivedData(?:/[^/\s"\x27<>:]+)?(?=/|[[:space:]"\x27=:,;)\]]|$)}n,
        "Linnet/BuildState"
      )

      replacements = [
        [ENV.fetch("LINNET_PRIVACY_REPO"), "Linnet/Workspace"],
        [ENV.fetch("LINNET_PRIVACY_HOME"), "Linnet/Home"],
        [ENV.fetch("LINNET_PRIVACY_TEMP"), "Linnet/Temp"],
        ["/private/tmp", "Linnet/Temp"],
        ["/tmp", "Linnet/Temp"],
      ].reject { |prefix, _| prefix.empty? }
       .uniq { |prefix, _| prefix }
       .sort_by { |prefix, _| -prefix.bytesize }

      replacements.each do |prefix, replacement|
        pattern = /#{Regexp.escape(prefix.b)}(?=\/|[[:space:]"\x27=:,;)\]]|$)/n
        text.gsub!(pattern, replacement)
      end

      boundary = %q{(?<![A-Za-z0-9._~:/-])}
      text.gsub!(
        /#{boundary}\/Applications\/Xcode[^\/]*\.app\/Contents\/Developer(?=\/|[[:space:]"\x27=:,;)\]]|$)/n,
        "Linnet/Toolchain"
      )
      text.gsub!(
        /#{boundary}\/Library\/Developer\/CommandLineTools(?=\/|[[:space:]"\x27=:,;)\]]|$)/n,
        "Linnet/Toolchain"
      )
      text.gsub!(
        /#{boundary}\/(?:opt\/homebrew|usr\/local\/Cellar)(?=\/|[[:space:]"\x27=:,;)\]]|$)/n,
        "Linnet/BuildTools"
      )
      text.gsub!(
        /#{boundary}\/(?:Users|home)\/[^\/\s"\x27<>:]+/n,
        "Linnet/Home"
      )
      text.gsub!(
        /#{boundary}\/builds\/[^\/\s"\x27<>:]+/n,
        "Linnet/CI"
      )
      text.gsub!(
        /#{boundary}\/(?:private\/)?var\/folders\/[^\/\s"\x27<>:]+\/[^\/\s"\x27<>:]+/n,
        "Linnet/Temp"
      )
      text.gsub!(
        /#{boundary}\/Volumes\/[^\/\s"\x27<>:]+/n,
        "Linnet/Volume"
      )
      text.gsub!(/[A-Za-z]:[\\\/]+Users[\\\/]+[^\\\/\s"\x27<>:]+/n, "Linnet/Home")
      text.gsub!(/file:\/\/\/Users\/[^\/\s"\x27<>:]+/ni, "file:///Linnet/Home")
      text.gsub!(/%2fUsers%2f[^%\s"\x27<>:]+/ni, "Linnet%2FHome")
      STDOUT.write(text)
    '
}

scan_artifacts() {
  [[ "$#" -gt 0 ]] || {
    usage
    exit 2
  }

  local privacy_home=""
  local privacy_temp=""
  [[ "${HOME:-}" == /* ]] && privacy_home="$(normalized_prefix "${HOME}")"
  [[ "${TMPDIR:-}" == /* ]] && privacy_temp="$(normalized_prefix "${TMPDIR}")"

  LINNET_PRIVACY_REPO="${privacy_root}" \
  LINNET_PRIVACY_HOME="${privacy_home}" \
  LINNET_PRIVACY_TEMP="${privacy_temp}" \
  LINNET_PRIVACY_WORKSPACE_NAME="${privacy_workspace_name}" \
    ruby - "$@" <<'RUBY'
require "fiddle/import"
require "open3"

module NativeXattr
  extend Fiddle::Importer
  dlload Fiddle.dlopen(nil)
  extern "long listxattr(const char*, char*, size_t, int)"
  extern "long getxattr(const char*, const char*, void*, size_t, unsigned int, int)"
end

class PrivacyScanner
  XATTR_NOFOLLOW = 0x0001
  MACH_MAGICS = %W[feedface cefaedfe feedfacf cffaedfe cafebabe bebafeca cafebabf bfbafeca].freeze

  def initialize
    @failures = 0
    @exact_paths = %w[LINNET_PRIVACY_REPO LINNET_PRIVACY_HOME LINNET_PRIVACY_TEMP]
      .map { |key| ENV.fetch(key).b }
      .reject(&:empty?)
    @workspace = ENV.fetch("LINNET_PRIVACY_WORKSPACE_NAME").b
    # These are audited upstream runtime filename templates, not captured
    # build roots. Keep the allowlist exact so a concrete temporary path still
    # fails the generic rules below.
    @runtime_templates = [
      "/tmp/agent-stderr.txt".b,
      "/tmp/leveldbtest-%d".b,
      "/tmp/lua_XXXXXX".b,
    ].freeze
    @runtime_literal_patterns = [
      %r{(?<![A-Za-z0-9._~:/-])/tmp(?=[\x00[:space:]"\x27=,;:)\]]|\z)}n,
    ].freeze
    boundary = %q{(?<![A-Za-z0-9._~:/-])}
    terminus = %q{(?=/|[\x00[:space:]"\x27=,;:)\]]|\z)}
    @path_patterns = [
      /#{boundary}\/Users#{terminus}/n,
      /#{boundary}\/home#{terminus}/n,
      /#{boundary}\/builds#{terminus}/n,
      /#{boundary}\/(?:private\/)?var\/folders#{terminus}/n,
      /#{boundary}\/Volumes#{terminus}/n,
      /#{boundary}\/(?:private\/)?tmp#{terminus}/n,
      /#{boundary}\/Applications\/Xcode[^\/]*\.app\/Contents\/Developer#{terminus}/n,
      /#{boundary}\/Library\/Developer\/CommandLineTools#{terminus}/n,
      /#{boundary}\/opt\/homebrew#{terminus}/n,
      /#{boundary}\/usr\/local\/Cellar#{terminus}/n,
      /file:\/\/\/Users#{terminus}/ni,
      /%2fUsers(?=%2f|[\x00[:space:]"\x27=,;:)\]]|\z)/ni,
      /[A-Za-z]:[\\\/]+Users(?=[\\\/]+|[\x00[:space:]"\x27=,;:)\]]|\z)/n,
    ]
    @marker_patterns = [
      /(?:\A|[\\\/])(?:DerivedData|Intermediates\.noindex|Index\.noindex|CMakeFiles)(?:[\\\/]|\z)/n,
      /(?:\A|[\\\/])\.DS_Store(?:[\\\/]|\z)/n,
    ]
  end

  def scan(inputs)
    inputs.each { |input| scan_root(input) }
    exit(@failures.zero? ? 0 : 1)
  rescue StandardError
    warn "build-privacy: artifact inspection failed"
    exit 1
  end

  private

  def report(label, category)
    @failures += 1
    safe = label.encode("UTF-8", invalid: :replace, undef: :replace, replace: "?")
      .gsub(/[\x00-\x1f\x7f]/, "?")
    warn "build-privacy: #{category} in relative artifact #{safe.dump}"
  end

  def views(data)
    value = data.b
    result = [value]
    value.scan(/(?:[\x20-\x7e]\x00){4,}/n) do |run|
      result << run.bytes.each_slice(2).map(&:first).pack("C*")
    end
    value.scan(/(?:\x00[\x20-\x7e]){4,}/n) do |run|
      result << run.bytes.each_slice(2).map(&:last).pack("C*")
    end
    result
  end

  def forbidden_content?(data)
    views(data).any? do |view|
      inspected = view.dup
      @runtime_templates.each { |template| inspected.gsub!(template, "") }
      @runtime_literal_patterns.each { |pattern| inspected.gsub!(pattern, "") }
      next true if @exact_paths.any? { |path| inspected.include?(path) }
      next true if @path_patterns.any? { |pattern| pattern.match?(inspected) }

      without_public_urls = inspected.gsub(%r{https?://[^\x00\s"\x27<>()]+}ni, "")
      workspace_hit = @workspace != "Linnet".b && without_public_urls.include?(@workspace)
      workspace_hit || @marker_patterns.any? { |pattern| pattern.match?(without_public_urls) }
    end
  end

  def forbidden_name?(label)
    components = label.b.split(/[\\\/]/n)
    markers = %w[DerivedData Intermediates.noindex Index.noindex CMakeFiles .DS_Store].map(&:b)
    components.any? { |component| markers.include?(component) } ||
      (@workspace != "Linnet".b && components.any? { |component| component.include?(@workspace) })
  end

  def xattrs(path, symlink)
    options = symlink ? XATTR_NOFOLLOW : 0
    size = NativeXattr.listxattr(path, nil, 0, options)
    raise "listxattr failed" if size.negative?
    return [] if size.zero?

    buffer = Fiddle::Pointer.malloc(size)
    actual = NativeXattr.listxattr(path, buffer, size, options)
    raise "listxattr changed" if actual.negative? || actual > size
    buffer.to_s(actual).split("\0", -1).reject(&:empty?).map do |name|
      value_size = NativeXattr.getxattr(path, name, nil, 0, 0, options)
      raise "getxattr failed" if value_size.negative?
      value = "".b
      if value_size.positive?
        value_buffer = Fiddle::Pointer.malloc(value_size)
        value_actual = NativeXattr.getxattr(path, name, value_buffer, value_size, 0, options)
        raise "getxattr changed" if value_actual.negative? || value_actual > value_size
        value = value_buffer.to_s(value_actual)
      end
      [name.b, value.b]
    end
  end

  def allowed_load_path?(path)
    path == "/usr/lib" || path == "/System/Library" ||
      path == "@rpath" || path == "@loader_path" || path == "@executable_path" ||
      path.start_with?("@rpath/", "@loader_path/", "@executable_path/", "/usr/lib/", "/System/Library/")
  end

  def inspect_macho(path, data)
    return false unless data.bytesize >= 4 && MACH_MAGICS.include?(data.byteslice(0, 4).unpack1("H*"))

    linked, error, status = Open3.capture3("/usr/bin/otool", "-L", path)
    raise "otool dependency inspection failed" unless status.success? && error.empty?
    linked.lines.drop(1).each do |line|
      dependency = line.strip.split.first
      return true if dependency && !allowed_load_path?(dependency)
    end

    commands, error, status = Open3.capture3("/usr/bin/otool", "-l", path)
    raise "otool load-command inspection failed" unless status.success? && error.empty?
    in_rpath = false
    commands.each_line do |line|
      fields = line.split
      if fields == %w[cmd LC_RPATH]
        in_rpath = true
      elsif in_rpath && fields.first == "path"
        return true unless fields[1] && allowed_load_path?(fields[1])
        in_rpath = false
      end
    end
    false
  end

  def inspect_entry(path, label, stat)
    if forbidden_name?(label)
      report(label, "forbidden build metadata")
      return
    end

    attributes = xattrs(path, stat.symlink?)
    # Extended metadata is a privacy failure only when its name or value leaks
    # a forbidden identity/path. macOS may recreate com.apple.provenance on
    # local generated files; the attribute name alone discloses no build path.
    if attributes.any? { |name, value| forbidden_content?(name) || forbidden_content?(value) }
      report(label, "forbidden extended metadata")
      return
    end

    if stat.symlink?
      target = File.readlink(path)
      report(label, "forbidden symlink target") if forbidden_content?(target.b)
    elsif stat.file?
      data = File.binread(path)
      if forbidden_content?(data) || inspect_macho(path, data)
        report(label, "forbidden build metadata")
      end
    elsif !stat.directory?
      report(label, "unsupported artifact type")
    end
  end

  def scan_root(input)
    root = File.expand_path(input)
    root_label = File.basename(root)
    root_label = "artifact" if root_label.empty?
    stat = File.lstat(root)
    inspect_entry(root, root_label, stat)
    return unless stat.directory? && !stat.symlink?

    stack = [[root, root_label]]
    until stack.empty?
      directory, directory_label = stack.pop
      children = Dir.children(directory)
      children.reverse_each do |name|
        path = File.join(directory, name)
        label = File.join(directory_label, name)
        child_stat = File.lstat(path)
        inspect_entry(path, label, child_stat)
        stack << [path, label] if child_stat.directory? && !child_stat.symlink?
      end
    end
  end
end

PrivacyScanner.new.scan(ARGV)
RUBY
}

sanitize_localizations() {
  [[ "$#" -gt 0 ]] || {
    usage
    exit 2
  }

  local catalog="${privacy_root}/resources/Localizable.xcstrings"
  [[ -f "${catalog}" && ! -L "${catalog}" ]] ||
    fail_privacy "canonical localization catalog is unavailable"

  local expected_locales
  expected_locales="$(ruby -rjson -e '
    catalog = JSON.parse(File.read(ARGV.fetch(0)))
    locales = [catalog.fetch("sourceLanguage")]
    catalog.fetch("strings").each_value do |entry|
      locales.concat(entry.fetch("localizations", {}).keys)
    end
    puts locales.uniq.sort.map { |locale| "#{locale}.lproj" }
  ' "${catalog}")"
  [[ -n "${expected_locales}" ]] ||
    fail_privacy "canonical localization catalog declares no locales"

  local app resources locale_dir locale_name actual_locales
  for app in "$@"; do
    resources="${app}/Contents/Resources"
    [[ -d "${app}" && ! -L "${app}" && -d "${resources}" && ! -L "${resources}" ]] ||
      fail_privacy "sanitize-localizations requires regular App resources"

    while IFS= read -r -d '' locale_dir; do
      locale_name="$(basename "${locale_dir}")"
      if ! grep -Fxq "${locale_name}" <<< "${expected_locales}"; then
        if find "${locale_dir}" -mindepth 1 -print -quit | grep -q .; then
          fail_privacy "unsupported non-empty localization: ${locale_name}"
        fi
        rmdir "${locale_dir}" ||
          fail_privacy "could not retire empty localization: ${locale_name}"
      fi
    done < <(find "${resources}" -maxdepth 1 -type d -name '*.lproj' -print0)

    actual_locales="$(find "${resources}" -maxdepth 1 -type d -name '*.lproj' \
      -exec basename {} \; | LC_ALL=C sort)"
    [[ "${actual_locales}" == "${expected_locales}" ]] ||
      fail_privacy "App localization projection does not match the canonical catalog"
  done
}

menu_icon_tool() {
  [[ "$#" -eq 2 ]] || {
    usage
    exit 2
  }

  local mode="$1"
  local output="$2"
  local source="${privacy_root}/resources/branding/linnet-mark.svg"

  [[ -f "${source}" && ! -L "${source}" ]] ||
    fail_privacy "canonical Linnet mark is unavailable"
  if [[ "${mode}" == project && -f "${output}" && ! -L "${output}" ]] &&
    "${privacy_root}/scripts/build-privacy" verify-menu-icon "${output}" \
      >/dev/null 2>&1; then
    return 0
  fi

  local menu_icon_temp_dir
  menu_icon_temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/linnet-menu-icon.XXXXXX")"
  trap 'rm -f "${menu_icon_temp_dir}/expected.pdf" "${menu_icon_temp_dir}/expected.bmp" \
    "${menu_icon_temp_dir}/actual.bmp"; rmdir "${menu_icon_temp_dir}"' EXIT

  xcrun swift - "${mode}" "${source}" "${output}" \
    "${menu_icon_temp_dir}/expected.pdf" <<'SWIFT'
import AppKit
import CoreGraphics
import Foundation

enum MenuIconError: Error { case invalid(String) }

let pageSize = CGSize(width: 22, height: 16)
let sourceRect = CGRect(x: 0, y: -3, width: 22, height: 22)

func regularFileSize(at url: URL) -> Int? {
  guard let values = try? url.resourceValues(
    forKeys: [.fileSizeKey, .isRegularFileKey, .isSymbolicLinkKey]
  ), values.isRegularFile == true, values.isSymbolicLink != true else { return nil }
  return values.fileSize
}

func regularFile(at url: URL) -> Bool { regularFileSize(at: url) != nil }

func project(_ image: NSImage, to url: URL) throws {
  if FileManager.default.fileExists(atPath: url.path), !regularFile(at: url) {
    throw MenuIconError.invalid("output is not a regular file")
  }
  let data = NSMutableData()
  var mediaBox = CGRect(origin: .zero, size: pageSize)
  guard let consumer = CGDataConsumer(data: data as CFMutableData),
        let context = CGContext(consumer: consumer, mediaBox: &mediaBox, nil) else {
    throw MenuIconError.invalid("could not create PDF context")
  }

  context.beginPDFPage(nil)
  NSGraphicsContext.saveGraphicsState()
  NSGraphicsContext.current = NSGraphicsContext(cgContext: context, flipped: false)
  image.draw(
    in: sourceRect,
    from: CGRect(origin: .zero, size: image.size),
    operation: .copy,
    fraction: 1
  )
  NSGraphicsContext.restoreGraphicsState()
  context.endPDFPage()
  context.closePDF()
  try (data as Data).write(to: url, options: .atomic)
}

func verify(_ url: URL) throws {
  guard let fileSize = regularFileSize(at: url) else {
    throw MenuIconError.invalid("PDF is not a regular file")
  }
  guard fileSize > 0 && fileSize <= 65_536 else {
    throw MenuIconError.invalid("PDF has an unexpected byte size")
  }
  let bytes = try Data(contentsOf: url, options: .mappedIfSafe)
  guard bytes.count == fileSize else {
    throw MenuIconError.invalid("PDF has an unexpected byte size")
  }
  guard let text = String(data: bytes, encoding: .isoLatin1),
        !text.contains("DCTDecode"),
        !text.contains("/Subtype /Image"),
        text.contains("/Subtype /Form") else {
    throw MenuIconError.invalid("PDF must contain vector forms and no raster image XObject")
  }
  guard let provider = CGDataProvider(data: bytes as CFData),
        let document = CGPDFDocument(provider), document.numberOfPages == 1,
        let page = document.page(at: 1) else {
    throw MenuIconError.invalid("PDF must contain exactly one readable page")
  }
  let box = page.getBoxRect(.mediaBox)
  guard box.origin == .zero && box.size == pageSize else {
    throw MenuIconError.invalid("PDF media box must be 22x16 points")
  }
}

do {
  guard CommandLine.arguments.count == 5 else {
    throw MenuIconError.invalid("invalid arguments")
  }
  let mode = CommandLine.arguments[1]
  let sourceURL = URL(fileURLWithPath: CommandLine.arguments[2])
  let outputURL = URL(fileURLWithPath: CommandLine.arguments[3])
  let expectedURL = URL(fileURLWithPath: CommandLine.arguments[4])
  guard let sourceSize = regularFileSize(at: sourceURL), sourceSize <= 65_536,
        sourceURL.pathExtension == "svg",
        let image = NSImage(contentsOf: sourceURL), image.isValid,
        image.representations.contains(where: {
          String(describing: type(of: $0)).contains("SVG")
        }) else {
    throw MenuIconError.invalid("canonical source is not a regular SVG")
  }

  if mode == "project" {
    try project(image, to: outputURL)
  } else if mode != "verify" {
    throw MenuIconError.invalid("unknown operation")
  }
  try project(image, to: expectedURL)
  try verify(outputURL)
  try verify(expectedURL)
} catch {
  let message = "build-privacy: \(error)\n"
  FileHandle.standardError.write(Data(message.utf8))
  exit(1)
}
SWIFT

  sips -s format bmp "${output}" \
    --out "${menu_icon_temp_dir}/actual.bmp" >/dev/null
  sips -s format bmp "${menu_icon_temp_dir}/expected.pdf" \
    --out "${menu_icon_temp_dir}/expected.bmp" >/dev/null
  cmp -s "${menu_icon_temp_dir}/actual.bmp" \
    "${menu_icon_temp_dir}/expected.bmp" ||
    fail_privacy "menu icon PDF is not the canonical mark projection"
  ruby - "${menu_icon_temp_dir}/actual.bmp" <<'RUBY'
data = File.binread(ARGV.fetch(0))
raise "unexpected menu icon raster size" unless data.bytesize <= 4096
offset = data.unpack1("@10V")
width = data.unpack1("@18l<")
height = data.unpack1("@22l<")
bits = data.unpack1("@28v")
raise "unexpected menu icon raster format" unless [width, height, bits] == [22, -16, 32]
pixels = data.byteslice(offset, width * height.abs * 4).bytes.each_slice(4).to_a
raise "truncated menu icon raster" unless pixels.length == width * height.abs
alpha = ->(x, y) { pixels.fetch(y * width + x).fetch(3) }
corners = [alpha.call(0, 0), alpha.call(width - 1, 0),
           alpha.call(0, height.abs - 1), alpha.call(width - 1, height.abs - 1)]
raise "menu icon corners are opaque" unless corners.all?(&:zero?)
visible = pixels.each_index.select { |index| pixels.fetch(index).fetch(3) >= 64 }
strong = pixels.count { |pixel| pixel.fetch(3) >= 192 }
xs = visible.map { |index| index % width }
ys = visible.map { |index| index / width }
raise "menu icon is not legible at 22x16" unless
  xs.max - xs.min + 1 >= 18 && ys.max - ys.min + 1 >= 12 &&
    visible.length >= 60 && strong >= 20
RUBY

  rm "${menu_icon_temp_dir}/expected.pdf" \
    "${menu_icon_temp_dir}/expected.bmp" "${menu_icon_temp_dir}/actual.bmp"
  rmdir "${menu_icon_temp_dir}"
  trap - EXIT
}

main() {
  [[ "$#" -gt 0 ]] || {
    usage
    exit 2
  }

  local command="$1"
  shift
  case "${command}" in
    redact) redact_stream "$@" ;;
    scan) scan_artifacts "$@" ;;
    sanitize-localizations) sanitize_localizations "$@" ;;
    project-menu-icon) menu_icon_tool project "$@" ;;
    verify-menu-icon) menu_icon_tool verify "$@" ;;
    -h|--help|help)
      [[ "$#" -eq 0 ]] || {
        usage
        exit 2
      }
      usage
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

main "$@"
