#!/usr/bin/env bash

# SPDX-License-Identifier: GPL-3.0-or-later

set -euo pipefail

readonly project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
readonly host_bundle_id='io.github.ares-x.inputmethod.Linnet'
readonly settings_bundle_id='io.github.ares-x.inputmethod.Linnet.settings'

fail_identity() {
  echo "linnet-code-identity: $1" >&2
  exit 1
}

require_tool() {
  command -v "$1" >/dev/null 2>&1 ||
    fail_identity "required tool is unavailable: $1"
}

# Prove the exact external key by exercising the same codesign boundary used
# for the product. `security find-identity -p codesigning` also requires a
# persistent trust-settings entry for self-signed certificates, even though
# codesign can use and verify the key without that unrelated global state.
verify_signing_key() (
  set -euo pipefail
  local identity="$1"
  local keychain="$2"
  local scratch_root
  local scratch
  local probe
  local certificate
  local actual_identity

  scratch_root="$(cd "${TMPDIR:-/tmp}" && pwd -P)" || exit 1
  scratch="$(mktemp -d "${scratch_root}/linnet-signing-key.XXXXXX")" || exit 1
  probe="${scratch}/probe"
  certificate="${scratch}/certificate"
  cleanup_signing_key() {
    if [[ "${scratch%/*}" == "${scratch_root}" &&
      "${scratch##*/}" == linnet-signing-key.* ]]; then
      /bin/rm -rf -- "${scratch}"
    fi
  }
  trap cleanup_signing_key EXIT INT TERM HUP

  /bin/cp /usr/bin/true "${probe}"
  codesign --force --sign "${identity}" --keychain "${keychain}" \
    --options runtime --timestamp=none "${probe}" >/dev/null 2>&1
  codesign --verify --strict "${probe}" >/dev/null 2>&1
  codesign -d --extract-certificates="${certificate}" "${probe}" \
    >/dev/null 2>&1
  [[ -s "${certificate}0" ]]
  actual_identity="$(shasum "${certificate}0" | awk '{ print toupper($1) }')"
  [[ "${actual_identity}" == "${identity}" ]]
)

canonical_regular_file() {
  local path="$1"
  local parent
  local canonical
  [[ "${path}" == /* && -f "${path}" && ! -L "${path}" ]] || return 1
  parent="$(cd "$(dirname "${path}")" && pwd -P)" || return 1
  canonical="${parent}/$(basename "${path}")"
  [[ "${canonical}" == "${path}" ]] || return 1
  printf '%s\n' "${canonical}"
}

signing_contract() {
  local identity="${LINNET_CODE_SIGN_IDENTITY:-}"
  local keychain="${LINNET_CODE_SIGN_KEYCHAIN:-}"
  local profile="${LINNET_CODE_SIGN_PROFILE:-}"
  local canonical_keychain
  local owner
  local mode
  local leaf
  local revision

  [[ "${identity}" =~ ^[0-9A-Fa-f]{40}$ ]] ||
    fail_identity "LINNET_CODE_SIGN_IDENTITY must be one exact 40-hex certificate SHA-1"
  [[ "${identity}" != 0000000000000000000000000000000000000000 ]] ||
    fail_identity "the zero signing identity is invalid"
  [[ "${profile}" == uat ]] ||
    fail_identity "LINNET_CODE_SIGN_PROFILE must be uat"
  identity="$(tr '[:lower:]' '[:upper:]' <<<"${identity}")"
  canonical_keychain="$(canonical_regular_file "${keychain}")" ||
    fail_identity "LINNET_CODE_SIGN_KEYCHAIN must be an absolute, canonical, non-symlink file"
  read -r owner mode < <(stat -f '%u %Lp' "${canonical_keychain}")
  [[ "${owner}" == "$(id -u)" && $((8#${mode} & 8#022)) -eq 0 ]] ||
    fail_identity "LINNET_CODE_SIGN_KEYCHAIN must be current-user-owned and not group/world writable"
  [[ "$(security find-certificate -a -Z "${canonical_keychain}" 2>/dev/null |
    awk -v expected="${identity}" '$1 == "SHA-1" && $2 == "hash:" && $3 == expected { count += 1 } END { print count + 0 }')" == 1 ]] ||
    fail_identity "the exact signing certificate is absent or duplicated in LINNET_CODE_SIGN_KEYCHAIN"
  verify_signing_key "${identity}" "${canonical_keychain}" ||
    fail_identity "the exact signing certificate has no usable private key"
  security list-keychains -d user | sed -E 's/^[[:space:]]*"(.*)"$/\1/' |
    grep -Fxq "${canonical_keychain}" ||
    fail_identity "LINNET_CODE_SIGN_KEYCHAIN must already be in the user keychain search list"
  leaf="$(security find-certificate -a -Z -p "${canonical_keychain}" 2>/dev/null |
    awk -v expected="${identity}" '
      $1 == "SHA-256" && $2 == "hash:" { sha256 = tolower($3) }
      $1 == "SHA-1" && $2 == "hash:" && $3 == expected {
        if (sha256 ~ /^[0-9a-f]{64}$/) { print sha256; matches += 1 }
      }
      END { if (matches != 1) exit 1 }
    ')" || fail_identity "the exact signing certificate leaf is ambiguous"
  revision="$(git -C "${project_root}" rev-parse --verify HEAD^{commit})" ||
    fail_identity "the source revision is unavailable"
  [[ "${revision}" =~ ^[0-9a-f]{40}$ ]] || fail_identity "the source revision is invalid"
  if [[ "${profile}" == uat ]]; then
    [[ "${LINNET_CANDIDATE_REVISION:-}" == "${revision}" ]] ||
      fail_identity "uat signing requires LINNET_CANDIDATE_REVISION to equal HEAD"
    [[ -z "$(git -C "${project_root}" status --porcelain)" ]] ||
      fail_identity "uat signing requires a clean candidate revision"
  fi
  printf '%s\n%s\n%s\n%s\n%s\n' \
    "${identity}" "${canonical_keychain}" "${profile}" "${leaf}" \
    "${revision}"
}

projection_from_contract() {
  local contract="$1"
  local profile
  local leaf
  local revision
  profile="$(sed -n '3p' <<<"${contract}")"
  leaf="$(sed -n '4p' <<<"${contract}")"
  revision="$(sed -n '5p' <<<"${contract}")"
  printf '{"format":2,"profile":"%s","leaf_certificate_sha256":"%s","candidate_revision":"%s"}\n' \
    "${profile}" "${leaf}" "${revision}"
}

inspect_contract() {
  local contract
  contract="$(signing_contract)"
  projection_from_contract "${contract}"
}

require_bundle() {
  local bundle="$1"
  local expected_name="$2"
  [[ "${bundle}" == /* && -d "${bundle}" && ! -L "${bundle}" &&
    "${bundle##*/}" == "${expected_name}" ]] ||
    fail_identity "unsafe or unexpected App bundle: ${expected_name}"
}

bundle_identifier() {
  plutil -extract CFBundleIdentifier raw -o - "$1/Contents/Info.plist" 2>/dev/null
}

mach_o_inventory() {
  local bundle="$1"
  find "${bundle}" -type f -print0 | while IFS= read -r -d '' candidate; do
    if file -b "${candidate}" | grep -q 'Mach-O'; then
      printf '%s\n' "${candidate#${bundle}/}"
    fi
  done | LC_ALL=C sort
}

require_inventory() {
  local bundle="$1"
  local expected="$2"
  local actual
  actual="$(mach_o_inventory "${bundle}")"
  [[ "${actual}" == "${expected}" ]] ||
    fail_identity "Mach-O inventory differs from the fixed product contract: ${bundle##*/}"
  while IFS= read -r relative; do
    [[ -n "${relative}" ]] || continue
    [[ -f "${bundle}/${relative}" && ! -L "${bundle}/${relative}" ]] ||
      fail_identity "unsafe Mach-O in product inventory: ${relative}"
  done <<<"${expected}"
}

readonly standalone_settings_inventory=$'Contents/Frameworks/librime.1.dylib\nContents/MacOS/Settings'
readonly host_inventory=$'Contents/Applications/Settings.app/Contents/Frameworks/librime.1.dylib\nContents/Applications/Settings.app/Contents/MacOS/Settings\nContents/Frameworks/librime.1.dylib\nContents/Frameworks/rime-plugins/librime-lua.dylib\nContents/Frameworks/rime-plugins/librime-octagram.dylib\nContents/Frameworks/rime-plugins/librime-predict.dylib\nContents/Frameworks/rime-plugins/librime-smart-english.dylib\nContents/MacOS/Linnet'

sign_code() {
  local path="$1"
  local identity="$2"
  local keychain="$3"
  local entitlements="${4:-}"
  local arguments=(
    --force --sign "${identity}" --keychain "${keychain}"
    --options runtime --timestamp=none
  )
  if [[ -n "${entitlements}" ]]; then
    arguments+=(--entitlements "${entitlements}")
  fi
  codesign "${arguments[@]}" "${path}" >/dev/null 2>&1 ||
    fail_identity "external code signing failed"
}

sign_adhoc_code() {
  local path="$1"
  local entitlements="${2:-}"
  local arguments=(--force --sign - --options runtime --timestamp=none)
  if [[ -n "${entitlements}" ]]; then
    arguments+=(--entitlements "${entitlements}")
  fi
  codesign "${arguments[@]}" "${path}" >/dev/null 2>&1 ||
    fail_identity "community ad-hoc code signing failed"
}

community_projection() {
  local revision
  revision="$(git -C "${project_root}" rev-parse --verify HEAD^{commit})" ||
    fail_identity "the source revision is unavailable"
  [[ "${revision}" =~ ^[0-9a-f]{40}$ &&
    "${LINNET_CANDIDATE_REVISION:-}" == "${revision}" ]] ||
    fail_identity "community publication requires LINNET_CANDIDATE_REVISION to equal HEAD"
  [[ -z "$(git -C "${project_root}" status --porcelain)" ]] ||
    fail_identity "community publication requires a clean candidate revision"
  printf '{"format":3,"profile":"community-adhoc","candidate_revision":"%s"}\n' \
    "${revision}"
}

verify_community_code() {
  local path="$1"
  local label="$2"
  local expected_identifier="${3:-}"
  local details
  codesign --verify --strict "${path}" >/dev/null 2>&1 ||
    fail_identity "invalid community code signature: ${label}"
  details="$(codesign -dvvv "${path}" 2>&1)" ||
    fail_identity "missing community code-signing details: ${label}"
  grep -q '^CodeDirectory .*flags=.*runtime' <<<"${details}" ||
    fail_identity "hardened runtime is missing: ${label}"
  grep -Fxq 'Signature=adhoc' <<<"${details}" ||
    fail_identity "community code is not ad-hoc signed: ${label}"
  if [[ -n "${expected_identifier}" ]]; then
    grep -Fxq "Identifier=${expected_identifier}" <<<"${details}" ||
      fail_identity "community code-signing identifier mismatch: ${label}"
  fi
}

leaf_sha256() {
  local path="$1"
  local certificate_prefix="$2"
  codesign -d --extract-certificates="${certificate_prefix}" "${path}" \
    >/dev/null 2>&1 || return 1
  [[ -s "${certificate_prefix}0" ]] || return 1
  shasum -a 256 "${certificate_prefix}0" | awk '{print $1}'
}

verify_code() {
  local path="$1"
  local expected_leaf="$2"
  local scratch="$3"
  local label="$4"
  local expected_identifier="${5:-}"
  local details
  local actual_leaf
  local signing_profile
  codesign --verify --strict "${path}" >/dev/null 2>&1 ||
    fail_identity "invalid code signature: ${label}"
  details="$(codesign -dvvv "${path}" 2>&1)" ||
    fail_identity "missing code-signing details: ${label}"
  grep -q '^CodeDirectory .*flags=.*runtime' <<<"${details}" ||
    fail_identity "hardened runtime is missing: ${label}"
  if grep -q '^Signature=adhoc$' <<<"${details}"; then
    fail_identity "ad-hoc code is forbidden: ${label}"
  fi
  grep -q '^Authority=' <<<"${details}" ||
    fail_identity "CMS signing authority is missing: ${label}"
  if [[ -n "${expected_identifier}" ]]; then
    grep -Fxq "Identifier=${expected_identifier}" <<<"${details}" ||
      fail_identity "code-signing identifier mismatch: ${label}"
  fi
  actual_leaf="$(leaf_sha256 "${path}" "${scratch}/${label}-cert")" ||
    fail_identity "leaf signing certificate is missing: ${label}"
  [[ -z "${expected_leaf}" || "${actual_leaf}" == "${expected_leaf}" ]] ||
    fail_identity "product code does not share one leaf signing certificate"
  printf '%s\n' "${actual_leaf}"
}

verify_product() {
  local host_app="$1"
  local standalone_settings_app="${2:-}"
  local embedded_settings_app
  local scratch
  local scratch_root
  local expected_leaf
  local actual_leaf
  local signing_profile
  local metadata_projection
  local product_version
  local product_build

  require_bundle "${host_app}" Linnet.app
  embedded_settings_app="${host_app}/Contents/Applications/Settings.app"
  require_bundle "${embedded_settings_app}" Settings.app
  [[ "$(bundle_identifier "${host_app}")" == "${host_bundle_id}" ]] ||
    fail_identity "Host signing identifier input is invalid"
  [[ "$(bundle_identifier "${embedded_settings_app}")" == "${settings_bundle_id}" ]] ||
    fail_identity "embedded Settings signing identifier input is invalid"
  signing_profile="$(plutil -extract LinnetCodeSigningProfile raw -o - \
    "${host_app}/Contents/Info.plist" 2>/dev/null || true)"
  product_version="$(plutil -extract CFBundleShortVersionString raw -o - \
    "${host_app}/Contents/Info.plist" 2>/dev/null || true)"
  product_build="$(plutil -extract CFBundleVersion raw -o - \
    "${host_app}/Contents/Info.plist" 2>/dev/null || true)"
  [[ "${signing_profile}" == uat ]] ||
    fail_identity "Host code-signing profile is missing or invalid"
  [[ "$(plutil -extract LinnetCodeSigningProfile raw -o - \
    "${embedded_settings_app}/Contents/Info.plist" 2>/dev/null || true)" == \
    "${signing_profile}" ]] || fail_identity "embedded Settings code-signing profile mismatch"
  require_inventory "${host_app}" "${host_inventory}"
  if [[ -n "${standalone_settings_app}" ]]; then
    require_bundle "${standalone_settings_app}" Settings.app
    [[ "$(bundle_identifier "${standalone_settings_app}")" == "${settings_bundle_id}" ]] ||
      fail_identity "standalone Settings signing identifier input is invalid"
    [[ "$(plutil -extract LinnetCodeSigningProfile raw -o - \
      "${standalone_settings_app}/Contents/Info.plist" 2>/dev/null || true)" == \
      "${signing_profile}" ]] || fail_identity "standalone Settings code-signing profile mismatch"
    require_inventory "${standalone_settings_app}" "${standalone_settings_inventory}"
  fi

  scratch_root="$(cd "${TMPDIR:-/tmp}" && pwd -P)" ||
    fail_identity "the canonical temporary root is unavailable"
  scratch="$(mktemp -d "${scratch_root}/linnet-code-identity.XXXXXX")"
  cleanup_verification() {
    if [[ "${scratch%/*}" == "${scratch_root}" &&
      "${scratch##*/}" == linnet-code-identity.* ]]; then
      /bin/rm -rf -- "${scratch}"
    fi
  }
  # RETURN covers the successful function path. EXIT also owns rejected
  # products and interrupted callers: fail_identity exits the verifier before
  # the function can return, and every negative identity fixture must still
  # remove its exported-certificate scratch directory.
  trap cleanup_verification RETURN EXIT

  expected_leaf="$(verify_code "${host_app}/Contents/Frameworks/librime.1.dylib" \
    '' "${scratch}" host-runtime)"
  while IFS= read -r relative; do
    [[ -n "${relative}" ]] || continue
    actual_leaf="$(verify_code "${host_app}/${relative}" "${expected_leaf}" \
      "${scratch}" "host-$(tr '/.' '--' <<<"${relative}")")"
    [[ "${actual_leaf}" == "${expected_leaf}" ]] ||
      fail_identity "Host code leaf mismatch"
  done <<<"${host_inventory}"
  actual_leaf="$(verify_code "${embedded_settings_app}" "${expected_leaf}" \
    "${scratch}" embedded-settings-bundle "${settings_bundle_id}")"
  [[ "${actual_leaf}" == "${expected_leaf}" ]] || fail_identity "embedded Settings leaf mismatch"
  if [[ -n "${standalone_settings_app}" ]]; then
    while IFS= read -r relative; do
      [[ -n "${relative}" ]] || continue
      actual_leaf="$(verify_code "${standalone_settings_app}/${relative}" "${expected_leaf}" \
        "${scratch}" "standalone-$(tr '/.' '--' <<<"${relative}")")"
      [[ "${actual_leaf}" == "${expected_leaf}" ]] ||
        fail_identity "standalone Settings code leaf mismatch"
    done <<<"${standalone_settings_inventory}"
    actual_leaf="$(verify_code "${standalone_settings_app}" "${expected_leaf}" \
      "${scratch}" standalone-settings-bundle "${settings_bundle_id}")"
    [[ "${actual_leaf}" == "${expected_leaf}" ]] ||
      fail_identity "standalone Settings leaf mismatch"
  fi
  codesign --verify --deep --strict "${host_app}" >/dev/null 2>&1 ||
    fail_identity "Host nested-code verification failed"
  actual_leaf="$(verify_code "${host_app}" "${expected_leaf}" \
    "${scratch}" host-bundle "${host_bundle_id}")"
  [[ "${actual_leaf}" == "${expected_leaf}" ]] || fail_identity "Host leaf mismatch"
  metadata_projection="$(ruby -rjson -rdigest -e '
    path, profile, leaf, product_version, product_build = ARGV
    root = File.dirname(path)
    metadata_entries = Dir.glob(File.join(root, "**", "*"), File::FNM_DOTMATCH)
      .reject { |item| %w[. ..].include?(File.basename(item)) }
    abort "release metadata is empty" if metadata_entries.empty?
    abort "unsafe release metadata" unless metadata_entries.all? do |item|
      !File.symlink?(item) && (File.file?(item) || File.directory?(item))
    end
    document = JSON.parse(File.binread(path))
    expected_top = %w[
      architecture build channel direct_product_upstreams distribution format
      minimum_macos product sbom_sha256 source upstream_lock_sha256 version
    ]
    abort "release metadata shape mismatch" unless document.keys.sort == expected_top
    abort "release metadata format mismatch" unless document.fetch("format") == 2
    abort "release product identity mismatch" unless
      document.fetch("product") == "Linnet" &&
      document.fetch("version") == product_version &&
      document.fetch("build") == product_build &&
      document.fetch("channel") == "community-beta" &&
      document.fetch("architecture") == "arm64" &&
      document.fetch("minimum_macos") == "13.0" &&
      document.fetch("upstream_lock_sha256").match?(/\A[0-9a-f]{64}\z/) &&
      document.fetch("sbom_sha256") ==
        Digest::SHA256.file(File.join(root, "SBOM.spdx.json")).hexdigest &&
      document.fetch("direct_product_upstreams").map { |item| item.fetch("group") } ==
        %w[squirrel_rime rime_ice hallelujah rime_wanxiang rime_lmdg_grammar]
    source = document.fetch("source")
    abort "release source shape mismatch" unless
      source.keys == ["candidate_revision"]
    revision = source.fetch("candidate_revision")
    abort "release candidate revision mismatch" unless revision.match?(/\A[0-9a-f]{40}\z/)
    distribution = document.fetch("distribution")
    abort "release distribution shape mismatch" unless distribution.keys.sort ==
      %w[application_code_signature artifact_scope notarized publication_eligible]
    signature = distribution.fetch("application_code_signature")
    abort "release signature shape mismatch" unless signature.keys.sort ==
      %w[hardened_runtime host_settings_same_leaf kind leaf_certificate_sha256 profile]
    abort "release signature mismatch" unless signature == {
      "profile" => profile,
      "kind" => "external-cms",
      "leaf_certificate_sha256" => leaf,
      "hardened_runtime" => true,
      "host_settings_same_leaf" => true,
    }
    abort "release scope mismatch" unless
      distribution.fetch("artifact_scope") == "installation-uat" &&
      distribution.fetch("notarized") == false &&
      distribution.fetch("publication_eligible") == false
    print JSON.generate({
      "format" => 2,
      "profile" => profile,
      "leaf_certificate_sha256" => leaf,
      "candidate_revision" => revision,
    })
  ' "${host_app}/Contents/Resources/LinnetRelease/VERSION.json" \
    "${signing_profile}" "${expected_leaf}" "${product_version}" "${product_build}")" ||
    fail_identity "signed release metadata is invalid"
  "${project_root}/scripts/generate-release-metadata" \
    "${project_root}/upstreams.lock.json" "${scratch}/expected-release-metadata" \
    "${product_version}" "${product_build}" 1704067200 \
    "${metadata_projection}" >/dev/null ||
    fail_identity "canonical release metadata cannot be projected"
  diff -qr "${scratch}/expected-release-metadata" \
    "${host_app}/Contents/Resources/LinnetRelease" >/dev/null ||
    fail_identity "signed release metadata differs from the canonical projection"
  trap - RETURN EXIT
  cleanup_verification
  printf '%s\n' "${metadata_projection}"
}

verify_publication_product() {
  local host_app="$1"
  local candidate_revision="$2"
  local embedded_settings_app
  [[ "${candidate_revision}" =~ ^[0-9a-f]{40}$ ]] ||
    fail_identity "publication candidate revision is invalid"
  require_bundle "${host_app}" Linnet.app
  embedded_settings_app="${host_app}/Contents/Applications/Settings.app"
  require_bundle "${embedded_settings_app}" Settings.app
  require_inventory "${host_app}" "${host_inventory}"
  while IFS= read -r relative; do
    [[ -n "${relative}" ]] || continue
    verify_community_code "${host_app}/${relative}" \
      "community-$(tr '/.' '--' <<<"${relative}")"
  done <<<"${host_inventory}"
  codesign --verify --deep --strict "${host_app}" >/dev/null 2>&1 ||
    fail_identity "community Host nested-code verification failed"
  verify_community_code "${embedded_settings_app}" embedded-settings-bundle \
    "${settings_bundle_id}"
  verify_community_code "${host_app}" host-bundle "${host_bundle_id}"
  [[ "$(bundle_identifier "${host_app}")" == "${host_bundle_id}" &&
    "$(bundle_identifier "${embedded_settings_app}")" == "${settings_bundle_id}" ]] ||
    fail_identity "publication bundle identifiers differ from the product contract"
  ruby -rjson -e '
    path, revision = ARGV
    document = JSON.parse(File.binread(path))
    abort unless document.fetch("source") == {"candidate_revision" => revision}
    distribution = document.fetch("distribution")
    abort unless distribution.fetch("application_code_signature") == {
      "profile" => "community-adhoc", "kind" => "adhoc",
      "hardened_runtime" => true, "host_settings_same_kind" => true,
    } && distribution.fetch("artifact_scope") == "public-community" &&
      distribution.fetch("notarized") == false &&
      distribution.fetch("publication_eligible") == true &&
      distribution.fetch("trust_model") == "manual-user-approval"
  ' "${host_app}/Contents/Resources/LinnetRelease/VERSION.json" \
    "${candidate_revision}" ||
    fail_identity "publication release metadata is invalid"
  printf '{"format":2,"candidate_revision":"%s","trust_model":"unsigned-community"}\n' \
    "${candidate_revision}"
}

sign_community_product() {
  local host_app="$1"
  local standalone_settings_app="$2"
  local embedded_settings_app="${host_app}/Contents/Applications/Settings.app"
  local entitlements="${project_root}/resources/Squirrel.entitlements"
  local expected_projection actual_projection
  require_bundle "${host_app}" Linnet.app
  require_bundle "${standalone_settings_app}" Settings.app
  require_bundle "${embedded_settings_app}" Settings.app
  require_inventory "${host_app}" "${host_inventory}"
  require_inventory "${standalone_settings_app}" "${standalone_settings_inventory}"
  expected_projection="$(community_projection)"
  for app in "${host_app}" "${standalone_settings_app}" "${embedded_settings_app}"; do
    plutil -replace LinnetCodeSigningProfile -string community-adhoc \
      "${app}/Contents/Info.plist" ||
      fail_identity "failed to project the community code-signing profile"
  done
  sign_adhoc_code "${standalone_settings_app}/Contents/Frameworks/librime.1.dylib"
  sign_adhoc_code "${standalone_settings_app}" "${entitlements}"
  sign_adhoc_code "${embedded_settings_app}/Contents/Frameworks/librime.1.dylib"
  sign_adhoc_code "${embedded_settings_app}" "${entitlements}"
  sign_adhoc_code "${host_app}/Contents/Frameworks/librime.1.dylib"
  for plugin in librime-lua.dylib librime-octagram.dylib librime-predict.dylib \
    librime-smart-english.dylib; do
    sign_adhoc_code "${host_app}/Contents/Frameworks/rime-plugins/${plugin}"
  done
  sign_adhoc_code "${host_app}" "${entitlements}"
  actual_projection="$(verify_publication_product "${host_app}" \
    "$(ruby -rjson -e 'puts JSON.parse(ARGV.fetch(0)).fetch("candidate_revision")' \
      "${expected_projection}")")"
  [[ "$(ruby -rjson -e 'puts JSON.parse(ARGV.fetch(0)).fetch("candidate_revision")' \
      "${actual_projection}")" == \
    "$(ruby -rjson -e 'puts JSON.parse(ARGV.fetch(0)).fetch("candidate_revision")' \
      "${expected_projection}")" ]] ||
    fail_identity "community product differs from its source contract"
}

sign_product() {
  local host_app="$1"
  local standalone_settings_app="$2"
  local embedded_settings_app="${host_app}/Contents/Applications/Settings.app"
  local contract
  local identity
  local keychain
  local profile
  local entitlements
  local expected_projection
  local actual_projection

  require_bundle "${host_app}" Linnet.app
  require_bundle "${standalone_settings_app}" Settings.app
  require_bundle "${embedded_settings_app}" Settings.app
  [[ "$(bundle_identifier "${host_app}")" == "${host_bundle_id}" &&
    "$(bundle_identifier "${standalone_settings_app}")" == "${settings_bundle_id}" &&
    "$(bundle_identifier "${embedded_settings_app}")" == "${settings_bundle_id}" ]] ||
    fail_identity "product bundle identifiers differ from the signing contract"
  require_inventory "${host_app}" "${host_inventory}"
  require_inventory "${standalone_settings_app}" "${standalone_settings_inventory}"
  contract="$(signing_contract)"
  identity="$(sed -n '1p' <<<"${contract}")"
  keychain="$(sed -n '2p' <<<"${contract}")"
  profile="$(sed -n '3p' <<<"${contract}")"
  entitlements="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)/resources/Squirrel.entitlements"
  expected_projection="$(projection_from_contract "${contract}")"

  for signed_app in "${host_app}" "${standalone_settings_app}" "${embedded_settings_app}"; do
    plutil -replace LinnetCodeSigningProfile -string "${profile}" \
      "${signed_app}/Contents/Info.plist" ||
      fail_identity "failed to project the code-signing profile"
  done

  sign_code "${standalone_settings_app}/Contents/Frameworks/librime.1.dylib" \
    "${identity}" "${keychain}"
  sign_code "${standalone_settings_app}" "${identity}" "${keychain}" "${entitlements}"
  sign_code "${embedded_settings_app}/Contents/Frameworks/librime.1.dylib" \
    "${identity}" "${keychain}"
  sign_code "${embedded_settings_app}" "${identity}" "${keychain}" "${entitlements}"
  sign_code "${host_app}/Contents/Frameworks/librime.1.dylib" "${identity}" "${keychain}"
  for plugin in librime-lua.dylib librime-octagram.dylib librime-predict.dylib \
    librime-smart-english.dylib; do
    sign_code "${host_app}/Contents/Frameworks/rime-plugins/${plugin}" \
      "${identity}" "${keychain}"
  done
  sign_code "${host_app}" "${identity}" "${keychain}" "${entitlements}"
  actual_projection="$(verify_product "${host_app}" "${standalone_settings_app}")"
  [[ "${actual_projection}" == "${expected_projection}" ]] ||
    fail_identity "signed product differs from its external identity contract"
}

for required_tool in awk basename codesign diff dirname file find git grep id mktemp plutil \
  ruby security sed shasum sort spctl stat tr xcrun; do
  require_tool "${required_tool}"
done

command="${1:-}"
case "${command}" in
  preflight)
    [[ "$#" -eq 1 ]] || fail_identity "usage: preflight"
    inspect_contract >/dev/null
    ;;
  inspect-contract)
    [[ "$#" -eq 1 ]] || fail_identity "usage: inspect-contract"
    inspect_contract
    ;;
  sign-product)
    [[ "$#" -eq 3 ]] || fail_identity "usage: sign-product HOST_APP STANDALONE_SETTINGS_APP"
    sign_product "$2" "$3"
    ;;
  verify-product)
    [[ "$#" -eq 2 || "$#" -eq 3 ]] ||
      fail_identity "usage: verify-product HOST_APP [STANDALONE_SETTINGS_APP]"
    verify_product "$2" "${3:-}"
    ;;
  verify-publication-product)
    [[ "$#" -eq 3 ]] ||
      fail_identity "usage: verify-publication-product HOST_APP CANDIDATE_REVISION"
    verify_publication_product "$2" "$3"
    ;;
  inspect-community-contract)
    [[ "$#" -eq 1 ]] || fail_identity "usage: inspect-community-contract"
    community_projection
    ;;
  sign-community-product)
    [[ "$#" -eq 3 ]] ||
      fail_identity "usage: sign-community-product HOST_APP STANDALONE_SETTINGS_APP"
    sign_community_product "$2" "$3"
    ;;
  *)
    fail_identity "usage: preflight | inspect-contract | inspect-community-contract | sign-product HOST_APP STANDALONE_SETTINGS_APP | sign-community-product HOST_APP STANDALONE_SETTINGS_APP | verify-product HOST_APP [STANDALONE_SETTINGS_APP] | verify-publication-product HOST_APP CANDIDATE_REVISION"
    ;;
esac
