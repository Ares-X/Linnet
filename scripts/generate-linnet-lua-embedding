#!/usr/bin/env ruby

require "digest"
require "fileutils"
require "pathname"
require "tmpdir"

repo_root = Pathname.new(__dir__).parent.realpath
# This mapping is the sole source-to-module projection. Keep it exact: adding a
# module changes the executable Core contract and requires owner-level review.
sources = {
  "auto_phrase" => "data/linnet/lua/auto_phrase.lua",
  "calc_translator" => "upstreams/rime-ice/lua/calc_translator.lua",
  "convert_ar_num_to_zh" => "upstreams/rime-ice/lua/convert_ar_num_to_zh.lua",
  "corrector" => "upstreams/rime-ice/lua/corrector.lua",
  "date_translator" => "upstreams/rime-ice/lua/date_translator.lua",
  "force_gc" => "upstreams/rime-ice/lua/force_gc.lua",
  "pin_cand_filter" => "upstreams/rime-ice/lua/pin_cand_filter.lua",
  "search" => "upstreams/rime-ice/lua/search.lua",
  "unicode" => "upstreams/rime-ice/lua/unicode.lua",
  "uuid" => "upstreams/rime-ice/lua/uuid.lua",
}.freeze
downstream_patch =
  "patches/rime-ice-linnet-pinyin-tag-boundary.patch".freeze

if ARGV == ["--print-inputs"]
  puts sources.values
  puts downstream_patch
  exit 0
end

abort "usage: generate-linnet-lua-embedding ABSOLUTE_OUTPUT" unless ARGV.length == 1
output = Pathname.new(ARGV.fetch(0))
abort "output must be absolute" unless output.absolute?
abort "unexpected output name" unless output.basename.to_s == "linnet_embedded_lua.h"
abort "output parent is missing" unless output.parent.directory?
abort "output parent must not be a symlink" if output.parent.symlink?

patch = repo_root.join(downstream_patch)
patch_stat = patch.lstat
abort "unsafe Lua patch: #{downstream_patch}" unless patch_stat.file? && !patch_stat.symlink?

records = Dir.mktmpdir("linnet-lua-embedding.") do |scratch|
  sources.each_value do |relative_path|
    source = repo_root.join(relative_path)
    stat = source.lstat
    abort "unsafe Lua source: #{relative_path}" unless stat.file? && !stat.symlink?
    staged = Pathname.new(scratch).join(relative_path)
    FileUtils.mkdir_p(staged.parent)
    staged.binwrite(source.binread)
  end
  patch_ok = system(
    "/usr/bin/patch", "-f", "-s", "-F", "0", "-p1",
    "-d", scratch, "-i", patch.to_s,
    out: File::NULL, err: File::NULL
  )
  abort "Linnet Lua boundary patch no longer applies exactly" unless patch_ok

  sources.map do |name, relative_path|
    bytes = Pathname.new(scratch).join(relative_path).binread
    symbol = "k#{name.split("_").map(&:capitalize).join}"
    [name, relative_path, Digest::SHA256.hexdigest(bytes), symbol, bytes]
  end
end

lines = [
  "// Generated by scripts/generate-linnet-lua-embedding. Do not edit.",
  "#ifndef LINNET_EMBEDDED_LUA_H_",
  "#define LINNET_EMBEDDED_LUA_H_",
  "",
  "#include <cstddef>",
  "",
  "namespace linnet_embedded_lua {",
  "struct Module {",
  "  const char* name;",
  "  const char* chunk_name;",
  "  const char* source_path;",
  "  const char* sha256;",
  "  const unsigned char* bytes;",
  "  std::size_t size;",
  "};",
  "",
]

records.each do |name, path, sha, symbol, bytes|
  lines << "// LINNET_LUA_MODULE name=#{name} source=#{path} sha256=#{sha}"
  lines << "inline constexpr unsigned char #{symbol}[] = {"
  bytes.bytes.each_slice(16) do |slice|
    lines << "  #{slice.map { |byte| format("0x%02x", byte) }.join(", ")},"
  end
  lines << "};"
  lines << ""
end

lines << "inline constexpr Module kModules[] = {"
records.each do |name, path, sha, symbol, _bytes|
  lines << "  {\"#{name}\", \"@linnet/#{name}.lua\", \"#{path}\", \"#{sha}\","
  lines << "   #{symbol}, sizeof(#{symbol})},"
end
lines.concat([
  "};",
  "inline constexpr std::size_t kModuleCount = sizeof(kModules) / sizeof(kModules[0]);",
  "static_assert(kModuleCount == 10, \"Linnet embedded Lua module set changed\");",
  "}  // namespace linnet_embedded_lua",
  "",
  "#endif  // LINNET_EMBEDDED_LUA_H_",
  "",
])

temporary = Pathname.new("#{output}.tmp.#{$$}")
begin
  temporary.binwrite(lines.join("\n"))
  File.rename(temporary, output)
ensure
  temporary.delete if temporary.exist?
end
