  "$(lock_value sources.librime.static_dependencies.leveldb.license_sha256)" \
  "${runtime_license_stage}/LevelDB-BSD-3-Clause.txt" "LevelDB license"
project_runtime_license \
  "${source_root}/deps/marisa-trie/$(lock_value sources.librime.static_dependencies.marisa-trie.license_path)" \
  "$(lock_value sources.librime.static_dependencies.marisa-trie.license_sha256)" \
  "${runtime_license_stage}/marisa-BSD-2-Clause-or-LGPL-2.1.txt" \
  "marisa license"
project_runtime_license \
  "${source_root}/deps/opencc/$(lock_value sources.librime.static_dependencies.opencc.license_path)" \
  "$(lock_value sources.librime.static_dependencies.opencc.license_sha256)" \
  "${runtime_license_stage}/OpenCC-Apache-2.0.txt" "OpenCC license"
project_runtime_license \
  "${source_root}/deps/yaml-cpp/$(lock_value sources.librime.static_dependencies.yaml-cpp.license_path)" \
  "$(lock_value sources.librime.static_dependencies.yaml-cpp.license_sha256)" \
  "${runtime_license_stage}/yaml-cpp-MIT.txt" "yaml-cpp license"
project_runtime_license \
  "${boost_root}/${boost_archive_root}/$(lock_value build_inputs.boost_headers.license_path)" \
  "$(lock_value build_inputs.boost_headers.license_sha256)" \
  "${runtime_license_stage}/Boost-BSL-1.0.txt" "Boost license"
project_runtime_license \
  "${source_root}/$(lock_value sources.librime.embedded_components.darts_clone.license_path)" \
  "$(lock_value sources.librime.embedded_components.darts_clone.license_sha256)" \
  "${runtime_license_stage}/Darts-clone-BSD-3-Clause.txt" "Darts-clone license"
