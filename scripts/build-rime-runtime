#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "${repo_root}"

privacy="${repo_root}/scripts/build-privacy"
upstream_sync="${repo_root}/scripts/upstream-sync"
lua_embedding_generator="${repo_root}/scripts/generate-linnet-lua-embedding"
lock_file="${repo_root}/upstreams.lock.json"
[[ -x "${privacy}" && -x "${upstream_sync}" && \
  -x "${lua_embedding_generator}" && -f "${lock_file}" ]] || {
  echo "build-rime-runtime: missing build contract" >&2
  exit 1
}

# This is the only diagnostic boundary. Successful third-party output is
# redacted and discarded by run(); unexpected shell diagnostics are redacted
# here. Our own stdout is limited to the short, path-free status lines below.
exec 2> >( exec "${privacy}" redact >&2 )

fail() {
  echo "build-rime-runtime: $1" >&2
  exit 1
}

lock_value() {
  local key_path="$1"
  ruby -rjson -e '
    lock = JSON.parse(File.binread(ARGV.fetch(0)).force_encoding(Encoding::UTF_8))
    value = ARGV.fetch(1).split(".").reduce(lock) do |node, key|
      abort "missing lock value" unless node.is_a?(Hash) && node.key?(key)
      node.fetch(key)
    end
    abort "lock value is not a string" unless value.is_a?(String) && !value.empty?
    puts value
  ' "${lock_file}" "${key_path}"
}

require_sha1() {
  [[ "$1" =~ ^[0-9a-f]{40}$ ]] || fail "invalid locked Git commit"
}

require_sha256() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]] || fail "invalid locked archive digest"
}

require_relative_component() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || fail "unsafe locked source directory"
}

run() {
  local output
  if ! output="$("$@" 2>&1 | "${privacy}" redact | tail -n 40)"; then
    [[ -z "${output}" ]] || printf '%s\n' "${output}" >&2
    fail "third-party command failed"
  fi
}

capture() {
  local output
  output="$("$@")" || fail "required command failed"
  printf '%s' "${output}"
}

# One worktree has one native-runtime mutation owner. The kernel-held lock is
# released on every exit, including crashes, and is inherited by build tools.
mkdir -p "${repo_root}/build"
runtime_lock_path="${repo_root}/build/.linnet-rime-runtime.lock"
exec 9>"${runtime_lock_path}"
/usr/bin/lockf -s -t 0 9 || fail "another native runtime build owns this worktree"

run "${upstream_sync}" verify

offline=0
[[ -n "${no_download:-}" ]] && offline=1
export LC_ALL=C TZ=UTC ZERO_AR_DATE=1

cache_root="${repo_root}/build/upstreams"
archive_root="${cache_root}/archives"
git_root="${cache_root}/git"
tools_root="${repo_root}/build/tools"
mkdir -p "${archive_root}" "${git_root}" "${tools_root}"

# Fast path: the compiled runtime only changes when its own locked inputs do.
# Language-data locks are deliberately excluded: only build tools, librime and
# its bundled plugins, the retained runtime patches, and this build script own the
# generated runtime bytes. Hash file contents without absolute path names so a
# workspace move cannot invalidate an otherwise identical runtime cache.
runtime_fingerprint_stamp="${repo_root}/build/rime-runtime.fingerprint"
content_sha256() {
  shasum -a 256 < "$1" | awk '{print $1}'
}

runtime_lock_projection() {
  ruby -rjson -rdigest -e '
    lock = JSON.parse(File.binread(ARGV.fetch(0)).force_encoding(Encoding::UTF_8))
    canonical = lambda do |value|
      case value
      when Hash
        value.keys.sort.to_h { |key| [key, canonical.call(value.fetch(key))] }
      when Array
        value.map { |item| canonical.call(item) }
      else
        value
      end
    end
    paths = %w[
      build_inputs.cmake
      build_inputs.boost_headers
      sources.librime
      downstream_patches
    ]
    projection = paths.to_h do |path|
      value = path.split(".").reduce(lock) { |node, key| node.fetch(key) }
      [path, value]
    end
    puts Digest::SHA256.hexdigest(JSON.generate(canonical.call(projection)))
  ' "${lock_file}"
}

runtime_patch_paths() {
  ruby -rjson -e '
    patches = JSON.parse(
      File.binread(ARGV.fetch(0)).force_encoding(Encoding::UTF_8)
    ).fetch("downstream_patches")
    puts patches.values.map { |item| item.fetch("path") }.sort
  ' "${lock_file}"
}

lua_embedding_inputs="$("${lua_embedding_generator}" --print-inputs)" ||
  fail "Lua embedding input inventory is unavailable"
lua_embedding_input_count="$(printf '%s\n' "${lua_embedding_inputs}" |
  awk 'NF { count += 1 } END { print count + 0 }')"
lua_embedding_unique_count="$(printf '%s\n' "${lua_embedding_inputs}" |
  awk 'NF' | LC_ALL=C sort -u | wc -l | tr -d ' ')"
[[ "${lua_embedding_input_count}" -eq 11 &&
   "${lua_embedding_unique_count}" -eq 11 ]] ||
  fail "Lua embedding input inventory must contain exactly 11 unique files"
while IFS= read -r relative_path; do
  [[ "${relative_path}" =~ ^[A-Za-z0-9._/-]+$ &&
     "${relative_path}" != /* && "${relative_path}" != *..* ]] ||
    fail "unsafe Lua embedding input path"
  [[ -f "${repo_root}/${relative_path}" &&
     ! -L "${repo_root}/${relative_path}" ]] ||
    fail "Lua embedding input is missing or unsafe"
done <<< "${lua_embedding_inputs}"

compute_runtime_fingerprint() {
  {
    printf '%s\n' 'linnet-runtime-fingerprint-v3-embedded-lua'
    runtime_lock_projection
    while IFS= read -r relative_path; do
      printf '%s\t%s\n' "${relative_path}" \
        "$(content_sha256 "${repo_root}/${relative_path}")"
    done < <(runtime_patch_paths)
    printf '%s\t%s\n' scripts/build-rime-runtime \
      "$(content_sha256 "${repo_root}/scripts/build-rime-runtime")"
    printf '%s\t%s\n' scripts/generate-linnet-lua-embedding \
      "$(content_sha256 "${lua_embedding_generator}")"
    while IFS= read -r relative_path; do
      printf '%s\t%s\n' "${relative_path}" \
        "$(content_sha256 "${repo_root}/${relative_path}")"
    done <<< "${lua_embedding_inputs}"
  } | shasum -a 256 | awk '{print $1}'
}
runtime_fingerprint="$(compute_runtime_fingerprint)"
dist_target="${repo_root}/librime/dist"
opencc_target="${repo_root}/librime/share/opencc"
boost_target="${repo_root}/build/dependencies/boost"
runtime_cache_target="${repo_root}/build/rime-runtime-cache"
runtime_cache_format="linnet-rime-runtime-cache-v2"
runtime_transient_roots=()

is_safe_runtime_transient() {
  case "$1" in
    "${repo_root}/build/.rime-runtime-cache."??????|\
    "${repo_root}/build/.rime-runtime-cache."??????.previous|\
    "${repo_root}/build/.rime-runtime-restore."??????|\
    "${repo_root}/build/.rime-runtime-publish."??????)
      [[ -d "$1" && ! -L "$1" ]]
      ;;
    *) return 1 ;;
  esac
}

cleanup_runtime_transients() {
  local transient
  [[ "${#runtime_transient_roots[@]}" -gt 0 ]] || return 0
  for transient in "${runtime_transient_roots[@]}"; do
    [[ ! -e "${transient}" && ! -L "${transient}" ]] && continue
    is_safe_runtime_transient "${transient}" || return 1
    rm -rf -- "${transient}"
  done
}

runtime_paths_share_device() {
  local expected path
  expected="$(stat -f %d "${repo_root}/build")" || return 1
  for path in "$@"; do
    [[ "$(stat -f %d "${path}")" == "${expected}" ]] || return 1
  done
}

# A prior SIGKILL cannot retain authority. The process lock proves none of
# these strictly named work roots belongs to a live sibling invocation.
shopt -s nullglob
stale_runtime_roots=(
  "${repo_root}"/build/.rime-runtime-cache.??????
  "${repo_root}"/build/.rime-runtime-cache.??????.previous
  "${repo_root}"/build/.rime-runtime-restore.??????
  "${repo_root}"/build/.rime-runtime-publish.??????
)
shopt -u nullglob
runtime_transient_roots=()
if [[ "${#stale_runtime_roots[@]}" -gt 0 ]]; then
  runtime_transient_roots=("${stale_runtime_roots[@]}")
fi
cleanup_runtime_transients || fail "unsafe native runtime residue"
runtime_transient_roots=()
trap cleanup_runtime_transients EXIT

runtime_outputs_complete() {
  local runtime_output
  [[ -d "${dist_target}" && ! -L "${dist_target}" &&
     -d "${opencc_target}" && ! -L "${opencc_target}" &&
     -d "${boost_target}/boost" && ! -L "${boost_target}" ]] || return 1
  for runtime_output in \
      "${dist_target}/lib/rime-plugins/librime-predict.dylib" \
      "${dist_target}/bin/rime_deployer" \
      "${dist_target}/share/linnet-licenses"; do
    [[ -e "${runtime_output}" ]] || return 1
  done
  compgen -G "${dist_target}/lib/librime.*.dylib" >/dev/null || return 1
  [[ "$(find "${dist_target}/share/linnet-licenses" \
      -mindepth 1 -maxdepth 1 -type f 2>/dev/null | wc -l | tr -d ' ')" == 12 ]]
}

# The cache inventory is a deterministic contract over every directory, file,
# mode, byte count, digest and symlink target. Cached paths are data, never
# source authority, so reject anything outside the generated runtime alphabet.
runtime_tree_inventory() {
  ruby -rdigest -rfind -rpathname -e '
    base = File.realpath(ARGV.fetch(0))
    roots = ARGV.drop(1)
    abort unless !roots.empty? && roots.uniq.size == roots.size &&
      roots.all? { |root| root.match?(/\A[A-Za-z0-9._+@-]+\z/) } &&
      Dir.children(base).sort == roots.sort
    rows = []
    roots.each do |root_name|
      root = File.join(base, root_name)
      Find.find(root) do |entry|
        relative = Pathname.new(entry).relative_path_from(Pathname.new(base)).to_s
        encoded = relative.dup.force_encoding("UTF-8")
        parts = encoded.split("/", -1)
        abort unless encoded.valid_encoding? && parts.all? { |part|
          !part.empty? && part != "." && part != ".." &&
            part.match?(/\A[A-Za-z0-9._+@-]+\z/)
        }
        stat = File.lstat(entry)
        mode = format("%04o", stat.mode & 0o7777)
        if stat.directory?
          kind, size, digest = "directory", 0, "-"
        elsif stat.file?
          kind = "file"
          size = stat.size
          digest = Digest::SHA256.file(entry).hexdigest
        elsif stat.symlink?
          target = File.readlink(entry)
          abort unless target.match?(/\A[A-Za-z0-9._+@-]+\z/)
          kind = "symlink"
          size = target.bytesize
          digest = Digest::SHA256.hexdigest(target)
        else
          abort
        end
        rows << [relative, kind, mode, size, digest].join("\t")
      end
    end
    puts rows.sort.join("\n")
  ' "$@"
}

runtime_cache_is_valid() {
  local cache_root="$1"
  local actual_inventory actual_boost_inventory expected_inventory
  local expected_boost_inventory expected_digest expected_boost_digest
  [[ -d "${cache_root}" && ! -L "${cache_root}" ]] || return 1
  ruby -e '
    expected = %w[
      boost.inventory boost.inventory.sha256 fingerprint format
      inventory inventory.sha256 payload
    ]
    abort unless Dir.children(ARGV.fetch(0)).sort == expected
  ' "${cache_root}" 2>/dev/null || return 1
  [[ -f "${cache_root}/boost.inventory" && ! -L "${cache_root}/boost.inventory" &&
     -f "${cache_root}/boost.inventory.sha256" &&
       ! -L "${cache_root}/boost.inventory.sha256" &&
     -f "${cache_root}/format" && ! -L "${cache_root}/format" &&
     -f "${cache_root}/fingerprint" && ! -L "${cache_root}/fingerprint" &&
     -f "${cache_root}/inventory" && ! -L "${cache_root}/inventory" &&
     -f "${cache_root}/inventory.sha256" &&
       ! -L "${cache_root}/inventory.sha256" &&
     -d "${cache_root}/payload" && ! -L "${cache_root}/payload" ]] || return 1
  [[ "$(<"${cache_root}/format")" == "${runtime_cache_format}" &&
     "$(<"${cache_root}/fingerprint")" == "${runtime_fingerprint}" ]] || return 1
  expected_digest="$(<"${cache_root}/inventory.sha256")"
  expected_boost_digest="$(<"${cache_root}/boost.inventory.sha256")"
  [[ "${expected_digest}" =~ ^[0-9a-f]{64}$ &&
     "${expected_boost_digest}" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$(content_sha256 "${cache_root}/inventory")" == "${expected_digest}" ]] ||
    return 1
  [[ "$(content_sha256 "${cache_root}/boost.inventory")" == \
     "${expected_boost_digest}" ]] || return 1
  expected_inventory="$(<"${cache_root}/inventory")"
  expected_boost_inventory="$(<"${cache_root}/boost.inventory")"
  actual_inventory="$(runtime_tree_inventory \
    "${cache_root}/payload" dist opencc 2>/dev/null)" || return 1
  actual_boost_inventory="$(runtime_tree_inventory \
    "${boost_target}" boost LICENSE_1_0.txt 2>/dev/null)" ||
    return 1
  [[ -n "${expected_inventory}" &&
     "${actual_inventory}" == "${expected_inventory}" &&
     -n "${expected_boost_inventory}" &&
     "${actual_boost_inventory}" == "${expected_boost_inventory}" ]]
}

restore_runtime_cache() {
  local restore_root restore_payload restored_inventory
  restore_root="$(mktemp -d "${repo_root}/build/.rime-runtime-restore.XXXXXX")"
  is_safe_runtime_transient "${restore_root}" || return 1
  runtime_transient_roots+=("${restore_root}")
  restore_payload="${restore_root}/payload"
  mkdir -p "${restore_payload}"
  if ! cp -R -X "${runtime_cache_target}/payload/." "${restore_payload}/"; then
    rm -rf -- "${restore_root}"
    return 1
  fi
  restored_inventory="$(runtime_tree_inventory \
    "${restore_payload}" dist opencc 2>/dev/null)" || {
    rm -rf -- "${restore_root}"
    return 1
  }
  if [[ "${restored_inventory}" != "$(<"${runtime_cache_target}/inventory")" ]]; then
    rm -rf -- "${restore_root}"
    return 1
  fi
  if [[ -e "${dist_target}" || -L "${dist_target}" ||
        -e "${opencc_target}" || -L "${opencc_target}" ]]; then
    rm -rf -- "${restore_root}"
    return 1
  fi
  mkdir -p "$(dirname "${dist_target}")" "$(dirname "${opencc_target}")"
  runtime_paths_share_device \
    "$(dirname "${dist_target}")" "$(dirname "${opencc_target}")" || {
    rm -rf -- "${restore_root}"
    return 1
  }
  if ! ruby -e 'File.rename(ARGV.fetch(0), ARGV.fetch(1))' \
      "${restore_payload}/dist" "${dist_target}"; then
    rm -rf -- "${restore_root}"
    return 1
  fi
  if ! ruby -e 'File.rename(ARGV.fetch(0), ARGV.fetch(1))' \
      "${restore_payload}/opencc" "${opencc_target}"; then
    ruby -e 'File.rename(ARGV.fetch(0), ARGV.fetch(1))' \
      "${dist_target}" "${restore_payload}/dist" ||
      fail "runtime cache restore rollback failed"
    rm -rf -- "${restore_root}"
    return 1
  fi
  rm -rf -- "${restore_root}"
  if ! runtime_outputs_complete; then
    rm -rf -- "${dist_target}" "${opencc_target}"
    return 1
  fi
  printf '%s\n' "${runtime_fingerprint}" > "${runtime_fingerprint_stamp}.tmp"
  mv "${runtime_fingerprint_stamp}.tmp" "${runtime_fingerprint_stamp}"
}

refresh_runtime_cache() {
  local cache_parent cache_stage cache_backup
  cache_parent="${repo_root}/build"
  mkdir -p "${cache_parent}"
  cache_stage="$(mktemp -d "${cache_parent}/.rime-runtime-cache.XXXXXX")"
  is_safe_runtime_transient "${cache_stage}" || return 1
  runtime_transient_roots+=("${cache_stage}")
  mkdir -p "${cache_stage}/payload"
  if ! cp -R -X "${dist_target}" "${cache_stage}/payload/dist" ||
      ! cp -R -X "${opencc_target}" "${cache_stage}/payload/opencc"; then
    rm -rf -- "${cache_stage}"
    return 1
  fi
  printf '%s\n' "${runtime_cache_format}" > "${cache_stage}/format"
  printf '%s\n' "${runtime_fingerprint}" > "${cache_stage}/fingerprint"
  if ! runtime_tree_inventory "${cache_stage}/payload" dist opencc \
      > "${cache_stage}/inventory" ||
      ! runtime_tree_inventory "${boost_target}" boost LICENSE_1_0.txt \
      > "${cache_stage}/boost.inventory"; then
    rm -rf -- "${cache_stage}"
    return 1
  fi
  content_sha256 "${cache_stage}/inventory" > "${cache_stage}/inventory.sha256"
  content_sha256 "${cache_stage}/boost.inventory" \
    > "${cache_stage}/boost.inventory.sha256"
  runtime_cache_is_valid "${cache_stage}" || {
    rm -rf -- "${cache_stage}"
    return 1
  }
  cache_backup="${cache_stage}.previous"
  runtime_transient_roots+=("${cache_backup}")
  [[ ! -e "${cache_backup}" && ! -L "${cache_backup}" ]] || {
    rm -rf -- "${cache_stage}"
    return 1
  }
  if [[ -e "${runtime_cache_target}" || -L "${runtime_cache_target}" ]]; then
    [[ -d "${runtime_cache_target}" && ! -L "${runtime_cache_target}" ]] || {
      rm -rf -- "${cache_stage}"
      return 1
    }
    mv "${runtime_cache_target}" "${cache_backup}"
  fi
  if ! mv "${cache_stage}" "${runtime_cache_target}"; then
    [[ ! -e "${cache_backup}" ]] || mv "${cache_backup}" "${runtime_cache_target}"
    return 1
  fi
  if ! runtime_cache_is_valid "${runtime_cache_target}"; then
    mv "${runtime_cache_target}" "${cache_stage}" || return 1
    [[ ! -e "${cache_backup}" ]] || mv "${cache_backup}" "${runtime_cache_target}"
    return 1
  fi
  [[ ! -e "${cache_backup}" ]] || rm -rf -- "${cache_backup}"
}

# Restore only into a genuinely empty live boundary. A half-present runtime is
# evidence for a cold rebuild, never permission to merge cached and live bytes.
if [[ ! -e "${dist_target}" && ! -L "${dist_target}" &&
      ! -e "${opencc_target}" && ! -L "${opencc_target}" &&
      -d "${boost_target}/boost" ]] &&
    runtime_cache_is_valid "${runtime_cache_target}" &&
    restore_runtime_cache; then
  echo "build-rime-runtime: RESTORE (verified locked runtime cache)"
  exit 0
fi

if [[ -f "${runtime_fingerprint_stamp}" &&
      "$(<"${runtime_fingerprint_stamp}")" == "${runtime_fingerprint}" ]] &&
    runtime_outputs_complete && runtime_cache_is_valid "${runtime_cache_target}"; then
  echo "build-rime-runtime: SKIP (locked inputs unchanged; runtime artifacts present)"
  exit 0
fi

is_safe_runtime_work_root() {
  local candidate="$1"
  [[ "${candidate}" == /private/tmp/linnet-rime-runtime.?????? &&
    -d "${candidate}" && ! -L "${candidate}" ]]
}

work_root="$(mktemp -d /private/tmp/linnet-rime-runtime.XXXXXX)"
is_safe_runtime_work_root "${work_root}" || fail "unsafe runtime work root"
publishing=0
new_dist=0
new_opencc=0
new_boost=0
had_dist=0
had_opencc=0
had_boost=0
dist_backup="${work_root}/previous-dist"
opencc_backup="${work_root}/previous-opencc"
boost_backup="${work_root}/previous-boost"

cleanup() {
  local status=$?
  trap - EXIT
  if ! is_safe_runtime_work_root "${work_root}"; then
    echo "build-rime-runtime: refusing unsafe runtime cleanup" >&2
    exit 1
  fi
  if [[ "${status}" -ne 0 && "${publishing}" -eq 1 ]]; then
    [[ "${new_boost}" -eq 0 ]] || rm -rf -- "${boost_target}"
    [[ "${had_boost}" -eq 0 ]] || mv "${boost_backup}" "${boost_target}"
    [[ "${new_opencc}" -eq 0 ]] || rm -rf -- "${opencc_target}"
    [[ "${had_opencc}" -eq 0 ]] || mv "${opencc_backup}" "${opencc_target}"
    [[ "${new_dist}" -eq 0 ]] || rm -rf -- "${dist_target}"
    [[ "${had_dist}" -eq 0 ]] || mv "${dist_backup}" "${dist_target}"
  fi
  cleanup_runtime_transients || status=1
  rm -rf -- "${work_root}"
  exit "${status}"
}
trap cleanup EXIT

verify_archive() {
  local archive="$1"
  local expected="$2"
  local actual
  [[ -f "${archive}" ]] || return 1
  actual="$(capture shasum -a 256 "${archive}" | awk '{print $1}')"
  [[ "${actual}" == "${expected}" ]]
}

materialize_archive() {
  local label="$1"
  local url="$2"
  local expected="$3"
  local archive="${archive_root}/${label}-${expected}.tar.gz"
  local partial="${archive}.partial"
  require_sha256 "${expected}"
  [[ "${url}" == https://* ]] || fail "archive URL must use HTTPS"

  if ! verify_archive "${archive}" "${expected}"; then
    [[ "${offline}" -eq 0 ]] || fail "offline archive input is missing or invalid"
    run curl --fail --location --output "${partial}" "${url}"
    verify_archive "${partial}" "${expected}" || fail "downloaded archive digest mismatch"
    mv "${partial}" "${archive}"
  fi
  printf '%s' "${archive}"
}

verify_clean_checkout() {
  local directory="$1"
  local expected="$2"
  local actual dirty
  actual="$(capture git -C "${directory}" rev-parse HEAD)"
  [[ "${actual}" == "${expected}" ]] || fail "source checkout differs from lock"
  dirty="$(capture git -C "${directory}" status --porcelain --untracked-files=all)"
  [[ -z "${dirty}" ]] || fail "source checkout is dirty"
}

materialize_git() {
  local label="$1"
  local repository="$2"
  local commit="$3"
  local directory="${git_root}/${label}"
  local configured_url=""
  require_sha1 "${commit}"
  [[ "${repository}" == https://github.com/*.git ]] || fail "source URL must be an HTTPS GitHub Git URL"

  if [[ ! -d "${directory}/.git" ]]; then
    [[ "${offline}" -eq 0 ]] || fail "offline source cache is missing"
    mkdir -p "${directory}"
    run git -C "${directory}" init --quiet
    run git -C "${directory}" remote add origin "${repository}"
  fi
  configured_url="$(capture git -C "${directory}" remote get-url origin)"
  [[ "${configured_url}" == "${repository}" ]] || fail "cached source URL differs from lock"

  if ! git -C "${directory}" cat-file -e "${commit}^{commit}" 2>/dev/null; then
    [[ "${offline}" -eq 0 ]] || fail "offline source cache is missing the locked commit"
    run git -C "${directory}" fetch --no-tags --depth=1 origin "${commit}"
  fi
  git -C "${directory}" cat-file -e "${commit}^{commit}" || fail "locked source commit is unavailable"
  local dirty
  dirty="$(capture git -C "${directory}" status --porcelain --untracked-files=all)"
  [[ -z "${dirty}" ]] || fail "cached source checkout is dirty"
  run git -C "${directory}" checkout --quiet --detach --force "${commit}"
  verify_clean_checkout "${directory}" "${commit}"
  printf '%s' "${directory}"
}

archive_checkout() {
  local checkout="$1"
  local commit="$2"
  local destination="$3"
  mkdir -p "${destination}"
  git -C "${checkout}" archive "${commit}" | tar -x -C "${destination}"
}

apply_downstream_patch() {
  local target="$1"
  local relative_path="$2"
  local expected="$3"
  local patch_path="${repo_root}/${relative_path}"
  local actual
  require_sha256 "${expected}"
  [[ -d "${target}" ]] || fail "downstream patch target is missing"
  [[ -f "${patch_path}" && ! -L "${patch_path}" ]] ||
    fail "downstream patch input is missing or unsafe"
  if rg -n '(^\*\*\* |^--- /|^\+\+\+ /|/(U[s]ers|h[o]me)/)' \
      "${patch_path}" >/dev/null; then
    fail "downstream patch contains an invalid directive or private absolute path"
  fi
  actual="$(capture shasum -a 256 "${patch_path}" | awk '{print $1}')"
  [[ "${actual}" == "${expected}" ]] || fail "downstream patch digest mismatch"
  run env GIT_CEILING_DIRECTORIES="${repo_root}" \
    git -C "${target}" apply --no-index --check "${patch_path}"
  run env GIT_CEILING_DIRECTORIES="${repo_root}" \
    git -C "${target}" apply --no-index "${patch_path}"
  run env GIT_CEILING_DIRECTORIES="${repo_root}" \
    git -C "${target}" apply --no-index --reverse --check "${patch_path}"
}

verify_locked_file() {
  local source="$1"
  local expected="$2"
  local label="$3"
  local actual
  require_sha256 "${expected}"
  [[ -f "${source}" && ! -L "${source}" ]] ||
    fail "${label} is missing or unsafe"
  actual="$(capture shasum -a 256 "${source}" | awk '{print $1}')"
  [[ "${actual}" == "${expected}" ]] || fail "${label} differs from the lock"
}

project_runtime_license() {
  local source="$1"
  local expected="$2"
  local output="$3"
  local label="$4"
  verify_locked_file "${source}" "${expected}" "${label}"
  [[ "${output}" == "${runtime_license_stage}/"* &&
     "${output#"${runtime_license_stage}/"}" =~ ^[A-Za-z0-9._-]+$ ]] ||
    fail "unsafe runtime license output"
  cp "${source}" "${output}"
}

cmake_version="$(lock_value build_inputs.cmake.version)"
cmake_url="$(lock_value build_inputs.cmake.url)"
cmake_sha="$(lock_value build_inputs.cmake.sha256)"
cmake_archive_root="$(lock_value build_inputs.cmake.archive_root)"
cmake_relative_exec="$(lock_value build_inputs.cmake.executable)"
boost_url="$(lock_value build_inputs.boost_headers.url)"
boost_sha="$(lock_value build_inputs.boost_headers.sha256)"
boost_archive_root="$(lock_value build_inputs.boost_headers.archive_root)"
librime_commit="$(lock_value sources.librime.commit)"
librime_version="$(lock_value sources.librime.tag)"
core_patch_target="$(lock_value downstream_patches.librime_core_interactions.target)"
core_patch_path="$(lock_value downstream_patches.librime_core_interactions.path)"
core_patch_sha="$(lock_value downstream_patches.librime_core_interactions.sha256)"
lua_patch_target="$(lock_value downstream_patches.librime_lua_state_lifetime.target)"
lua_patch_path="$(lock_value downstream_patches.librime_lua_state_lifetime.path)"
lua_patch_sha="$(lock_value downstream_patches.librime_lua_state_lifetime.sha256)"
predict_patch_target="$(lock_value downstream_patches.librime_predict_session_state.target)"
predict_patch_path="$(lock_value downstream_patches.librime_predict_session_state.path)"
predict_patch_sha="$(lock_value downstream_patches.librime_predict_session_state.sha256)"
require_sha1 "${librime_commit}"
[[ "${librime_version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
  fail "invalid locked librime version"

[[ "${core_patch_target}" == "sources.librime" ]] ||
  fail "unexpected core interaction downstream patch target"
[[ "${core_patch_path}" == \
   "patches/librime-linnet-core-interactions.patch" ]] ||
  fail "unexpected core interaction downstream patch path"
[[ "${lua_patch_target}" == "sources.librime.bundled_plugins.lua" ]] ||
  fail "unexpected lua downstream patch target"
[[ "${lua_patch_path}" == "patches/librime-lua-linnet-state-lifetime.patch" ]] ||
  fail "unexpected lua downstream patch path"
[[ "${predict_patch_target}" == "sources.librime.bundled_plugins.predict" ]] ||
  fail "unexpected predict downstream patch target"
[[ "${predict_patch_path}" == "patches/librime-predict-linnet-session-state.patch" ]] ||
  fail "unexpected predict downstream patch path"

[[ "${cmake_archive_root}" != /* && "${cmake_archive_root}" != *..* ]] || fail "unsafe CMake archive root"
[[ "${cmake_relative_exec}" != /* && "${cmake_relative_exec}" != *..* ]] || fail "unsafe CMake executable"
[[ "${boost_archive_root}" != /* && "${boost_archive_root}" != *..* ]] || fail "unsafe Boost archive root"

cmake_archive="$(materialize_archive cmake "${cmake_url}" "${cmake_sha}")"
boost_archive="$(materialize_archive boost "${boost_url}" "${boost_sha}")"

cmake_extract="${work_root}/cmake"
mkdir -p "${cmake_extract}"
run tar -xzf "${cmake_archive}" -C "${cmake_extract}"
cmake_top="${cmake_archive_root%%/*}"
[[ -x "${cmake_extract}/${cmake_archive_root}/${cmake_relative_exec}" ]] || fail "CMake archive layout differs from lock"
cmake_target="${tools_root}/${cmake_top}"
[[ ! -e "${cmake_target}" || ! -L "${cmake_target}" ]] || fail "CMake tool target must not be a symlink"
if [[ -e "${cmake_target}" ]]; then
  mv "${cmake_target}" "${work_root}/previous-cmake"
fi
mv "${cmake_extract}/${cmake_top}" "${cmake_target}"
cmake="${cmake_target}/${cmake_archive_root#*/}/${cmake_relative_exec}"
cmake_report="$(capture "${cmake}" --version | head -n 1)"
[[ "${cmake_report}" == "cmake version ${cmake_version}" ]] || fail "CMake version differs from lock"

librime_checkout="${repo_root}/librime"
[[ -d "${librime_checkout}/.git" || -f "${librime_checkout}/.git" ]] || fail "librime checkout is missing"
verify_clean_checkout "${librime_checkout}" "${librime_commit}"

source_root="${work_root}/source"
archive_checkout "${librime_checkout}" "${librime_commit}" "${source_root}"
apply_downstream_patch \
  "${source_root}" "${core_patch_path}" "${core_patch_sha}"

deps=(glog leveldb marisa-trie opencc yaml-cpp)
for dependency in "${deps[@]}"; do
  dependency_url="$(capture git -C "${librime_checkout}" config -f .gitmodules --get "submodule.${dependency}.url")"
  dependency_commit="$(capture git -C "${librime_checkout}" ls-tree "${librime_commit}" -- "deps/${dependency}" | awk '{print $3}')"
  require_sha1 "${dependency_commit}"
  dependency_cache="$(materialize_git "librime-deps/${dependency}" "${dependency_url}" "${dependency_commit}")"
  archive_checkout "${dependency_cache}" "${dependency_commit}" "${source_root}/deps/${dependency}"
done

plugins=(lua octagram predict)
for plugin in "${plugins[@]}"; do
  plugin_url="$(lock_value "sources.librime.bundled_plugins.${plugin}.repository")"
  plugin_commit="$(lock_value "sources.librime.bundled_plugins.${plugin}.commit")"
  plugin_dir="$(lock_value "sources.librime.bundled_plugins.${plugin}.source_dir")"
  require_relative_component "${plugin_dir}"
  [[ "${plugin_dir}" == "${plugin}" ]] || fail "plugin source directory differs from canonical layout"
  plugin_cache="$(materialize_git "plugins/${plugin}" "${plugin_url}" "${plugin_commit}")"
  archive_checkout "${plugin_cache}" "${plugin_commit}" "${source_root}/plugins/${plugin_dir}"
done
apply_downstream_patch "${source_root}/plugins/lua" "${lua_patch_path}" "${lua_patch_sha}"
lua_modules="${source_root}/plugins/lua/src/modules.cc"
lua_state="${source_root}/plugins/lua/src/lib/lua.cc"
if rg -n 'dladdr|dli_fname|lstat|LUA_DIRSEP|get_(user|shared)_data_dir|rime\.lua|luaL_dofile|file_exists' \
    "${lua_modules}" "${lua_state}"; then
  fail "patched Lua loader retains a filesystem execution path"
fi
rg -Fq '#include "linnet_embedded_lua.h"' "${lua_modules}" ||
  fail "patched Lua loader does not consume the generated embedding"
rg -Fq 'LUA_PRELOAD_TABLE' "${lua_modules}" ||
  fail "patched Lua loader does not own package.preload"
rg -Fq '"LUA_NOENV"' "${lua_state}" ||
  fail "patched Lua state does not disable environment loaders"
run "${lua_embedding_generator}" \
  "${source_root}/plugins/lua/src/linnet_embedded_lua.h"
apply_downstream_patch \
  "${source_root}/plugins/predict" "${predict_patch_path}" "${predict_patch_sha}"

lua_thirdparty_url="$(lock_value sources.librime.bundled_plugins.lua.thirdparty.repository)"
lua_thirdparty_commit="$(lock_value sources.librime.bundled_plugins.lua.thirdparty.commit)"
lua_thirdparty_dir="$(lock_value sources.librime.bundled_plugins.lua.thirdparty.source_dir)"
require_relative_component "${lua_thirdparty_dir}"
[[ "${lua_thirdparty_dir}" == "thirdparty" ]] || fail "Lua third-party source directory differs from canonical layout"
lua_thirdparty_cache="$(materialize_git plugins/lua-thirdparty "${lua_thirdparty_url}" "${lua_thirdparty_commit}")"
archive_checkout "${lua_thirdparty_cache}" "${lua_thirdparty_commit}" "${source_root}/plugins/lua/${lua_thirdparty_dir}"

boost_root="${work_root}/boost"
mkdir -p "${boost_root}"
run tar -xzf "${boost_archive}" -C "${boost_root}" \
  "${boost_archive_root}/boost" "${boost_archive_root}/LICENSE_1_0.txt"
[[ -f "${boost_root}/${boost_archive_root}/boost/signals2/signal.hpp" ]] || fail "Boost archive layout differs from lock"

# Release legal metadata consumes this exact build output rather than mutable
# source caches.  Each file is first verified against the sole lock owner.
runtime_license_stage="${work_root}/runtime-licenses"
mkdir -p "${runtime_license_stage}"
project_runtime_license \
  "${source_root}/$(lock_value sources.librime.license_path)" \
  "$(lock_value sources.librime.license_sha256)" \
  "${runtime_license_stage}/librime-BSD-3-Clause.txt" "librime license"
project_runtime_license \
  "${source_root}/plugins/lua/$(lock_value sources.librime.bundled_plugins.lua.license_path)" \
  "$(lock_value sources.librime.bundled_plugins.lua.license_sha256)" \
  "${runtime_license_stage}/librime-lua-BSD-3-Clause.txt" "librime-lua license"
verify_locked_file \
  "${source_root}/plugins/octagram/$(lock_value sources.librime.bundled_plugins.octagram.license_path)" \
  "$(lock_value sources.librime.bundled_plugins.octagram.license_sha256)" \
  "librime-octagram license"
project_runtime_license \
  "${source_root}/plugins/predict/$(lock_value sources.librime.bundled_plugins.predict.license_path)" \
  "$(lock_value sources.librime.bundled_plugins.predict.license_sha256)" \
  "${runtime_license_stage}/librime-predict-BSD-3-Clause.txt" \
  "librime-predict license"
while IFS=$'\t' read -r notice_path notice_sha; do
  verify_locked_file "${source_root}/plugins/lua/${notice_path}" "${notice_sha}" \
    "librime-lua embedded MIT source"
done < <(ruby -rjson -e '
  lua = JSON.parse(File.binread(ARGV.fetch(0)).force_encoding(Encoding::UTF_8)).dig(
    "sources", "librime", "bundled_plugins", "lua"
  )
  sources = lua.fetch("embedded_mit_notice").fetch("sources")
  sources.keys.sort.each do |name|
    item = sources.fetch(name)
    puts [item.fetch("path"), item.fetch("sha256")].join("\t")
  end
  thirdparty = lua.fetch("thirdparty")
  puts [File.join("thirdparty", thirdparty.fetch("source_path")),
        thirdparty.fetch("source_sha256")].join("\t")
' "${lock_file}")
project_runtime_license \
  "${repo_root}/$(lock_value sources.librime.bundled_plugins.lua.embedded_mit_notice.path)" \
  "$(lock_value sources.librime.bundled_plugins.lua.embedded_mit_notice.sha256)" \
  "${runtime_license_stage}/librime-lua-embedded-MIT.txt" \
  "librime-lua embedded MIT notice"
project_runtime_license \
  "${source_root}/deps/glog/$(lock_value sources.librime.static_dependencies.glog.license_path)" \
  "$(lock_value sources.librime.static_dependencies.glog.license_sha256)" \
  "${runtime_license_stage}/glog-BSD-3-Clause.txt" "glog license"
