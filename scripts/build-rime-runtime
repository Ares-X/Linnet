  "${source_root}/deps/opencc/$(lock_value sources.librime.static_dependencies.opencc.embedded_components.rapidjson.source_path)" \
  "$(lock_value sources.librime.static_dependencies.opencc.embedded_components.rapidjson.source_sha256)" \
  "OpenCC vendored RapidJSON source"
