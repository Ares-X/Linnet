  "${repo_root}/$(lock_value sources.librime.static_dependencies.opencc.embedded_components.rapidjson.license_path)" \
  "$(lock_value sources.librime.static_dependencies.opencc.embedded_components.rapidjson.license_sha256)" \
  "${runtime_license_stage}/RapidJSON-1.1.0.txt" "RapidJSON license"
[[ "$(find "${runtime_license_stage}" -mindepth 1 -maxdepth 1 -type f | wc -l | tr -d ' ')" == 12 ]] ||
  fail "runtime license projection has an unexpected inventory"

sdk="$(capture xcrun --sdk macosx --show-sdk-path)"
[[ "${sdk}" == /* && -d "${sdk}" ]] || fail "macOS SDK is unavailable"
source_epoch="$(capture git -C "${librime_checkout}" show -s --format=%ct "${librime_commit}")"
[[ "${source_epoch}" =~ ^[0-9]+$ ]] || fail "invalid source epoch"
export SOURCE_DATE_EPOCH="${source_epoch}" MACOSX_DEPLOYMENT_TARGET=13.0
jobs="$(sysctl -n hw.ncpu 2>/dev/null || true)"
[[ "${jobs}" =~ ^[1-9][0-9]*$ ]] || jobs=8
export CMAKE_BUILD_PARALLEL_LEVEL="${jobs}"

# macOS exposes the same temporary filesystem through /tmp and /private/tmp.
# CMake may spell compiler inputs with the other alias after the shell has
# established canonical roots, so map both exact spellings before accepting a
# generated runtime. The generic maps remain defense in depth for unrelated
# temporary inputs; exact roots prevent their private suffixes from surviving.
repo_root_alias="${repo_root}"
work_root_alias="${work_root}"
case "${repo_root}" in
  /private/tmp/*) repo_root_alias="/tmp/${repo_root#/private/tmp/}" ;;
  /tmp/*) repo_root_alias="/private/tmp/${repo_root#/tmp/}" ;;
esac
case "${work_root}" in
  /private/tmp/*) work_root_alias="/tmp/${work_root#/private/tmp/}" ;;
  /tmp/*) work_root_alias="/private/tmp/${work_root#/tmp/}" ;;
esac
map_flags="-ffile-prefix-map=/tmp=Linnet/Temp -fmacro-prefix-map=/tmp=Linnet/Temp -fdebug-prefix-map=/tmp=Linnet/Temp"
map_flags+=" -ffile-prefix-map=/private/tmp=Linnet/Temp -fmacro-prefix-map=/private/tmp=Linnet/Temp -fdebug-prefix-map=/private/tmp=Linnet/Temp"
map_flags+=" -ffile-prefix-map=${sdk}=Linnet/SDK -fmacro-prefix-map=${sdk}=Linnet/SDK -fdebug-prefix-map=${sdk}=Linnet/SDK"
map_flags+=" -ffile-prefix-map=${repo_root}=Linnet/Workspace -fmacro-prefix-map=${repo_root}=Linnet/Workspace -fdebug-prefix-map=${repo_root}=Linnet/Workspace"
map_flags+=" -ffile-prefix-map=${repo_root_alias}=Linnet/Workspace -fmacro-prefix-map=${repo_root_alias}=Linnet/Workspace -fdebug-prefix-map=${repo_root_alias}=Linnet/Workspace"
map_flags+=" -ffile-prefix-map=${work_root}=Linnet/Source -fmacro-prefix-map=${work_root}=Linnet/Source -fdebug-prefix-map=${work_root}=Linnet/Source"
map_flags+=" -ffile-prefix-map=${work_root_alias}=Linnet/Source -fmacro-prefix-map=${work_root_alias}=Linnet/Source -fdebug-prefix-map=${work_root_alias}=Linnet/Source"
map_flags+=" -fdebug-compilation-dir=."

deps_stage="${work_root}/deps-stage"
common_cmake=(
  -DCMAKE_BUILD_TYPE=Release
  -DCMAKE_INSTALL_PREFIX=/Linnet
  -DCMAKE_OSX_ARCHITECTURES=arm64
  -DCMAKE_OSX_DEPLOYMENT_TARGET=13.0
  "-DCMAKE_OSX_SYSROOT=${sdk}"
  "-DCMAKE_C_FLAGS=${map_flags}"
  "-DCMAKE_CXX_FLAGS=${map_flags}"
  -DCMAKE_POSITION_INDEPENDENT_CODE=ON
)

build_dependency() {
  local dependency="$1"
  shift
  local build_dir="${work_root}/build-deps/${dependency}"
  run "${cmake}" -S "${source_root}/deps/${dependency}" -B "${build_dir}" \
    "${common_cmake[@]}" "$@"
  run env DESTDIR="${deps_stage}" "${cmake}" --build "${build_dir}" --target install
}

echo "build-rime-runtime: building pinned arm64 dependencies"
build_dependency glog -DBUILD_SHARED_LIBS=OFF -DBUILD_TESTING=OFF -DWITH_GFLAGS=OFF
build_dependency leveldb -DLEVELDB_BUILD_BENCHMARKS=OFF -DLEVELDB_BUILD_TESTS=OFF
build_dependency marisa-trie -DBUILD_TESTING=OFF -DENABLE_TOOLS=OFF
build_dependency opencc \
  -DBUILD_SHARED_LIBS=OFF -DBUILD_TESTING=OFF -DENABLE_GTEST=OFF \
  -DENABLE_BENCHMARK=OFF -DBUILD_PYTHON=OFF -DUSE_SYSTEM_MARISA=ON \
  -DENABLE_DARTS=OFF \
  "-DLIBMARISA:FILEPATH=${deps_stage}/Linnet/lib/libmarisa.a" \
  "-DCMAKE_CXX_FLAGS=${map_flags} -I${deps_stage}/Linnet/include -L${deps_stage}/Linnet/lib"
opencc_cache="${work_root}/build-deps/opencc/CMakeCache.txt"
rg -Fxq "LIBMARISA:FILEPATH=${deps_stage}/Linnet/lib/libmarisa.a" \
  "${opencc_cache}" || fail "OpenCC did not bind the locked standalone marisa"
rg -Fxq 'USE_SYSTEM_MARISA:BOOL=ON' "${opencc_cache}" ||
  fail "OpenCC enabled its second vendored marisa implementation"
rg -Fxq 'ENABLE_DARTS:BOOL=OFF' "${opencc_cache}" ||
  fail "OpenCC enabled its second embedded Darts implementation"
build_dependency yaml-cpp -DYAML_CPP_BUILD_CONTRIB=OFF -DYAML_CPP_BUILD_TESTS=OFF -DYAML_CPP_BUILD_TOOLS=OFF

runtime_stage="${work_root}/runtime-stage"
runtime_build="${work_root}/build-runtime"
export RIME_PLUGINS='hchunhui/librime-lua lotem/librime-octagram rime/librime-predict'
echo "build-rime-runtime: building librime and pinned plugins"
run "${cmake}" -S "${source_root}" -B "${runtime_build}" \
  "${common_cmake[@]}" \
  "-DCMAKE_PREFIX_PATH=${deps_stage}/Linnet" \
  "-DBoost_ROOT=${boost_root}/${boost_archive_root}" \
  -DBoost_NO_SYSTEM_PATHS=TRUE \
  -DBUILD_SHARED_LIBS=ON -DBUILD_STATIC=OFF \
  -DBUILD_MERGED_PLUGINS=OFF -DENABLE_EXTERNAL_PLUGINS=ON \
  -DBUILD_TEST=OFF -DBUILD_TOOLS=OFF -DLINNET_BUILD_PREDICT_TOOL=ON \
  -DBUILD_DATA=OFF -DBUILD_SAMPLE=OFF \
  -DENABLE_TIMESTAMP=OFF
run "${cmake}" --build "${runtime_build}"
run env DESTDIR="${runtime_stage}" "${cmake}" --install "${runtime_build}"

runtime_prefix="${runtime_stage}/Linnet"
mkdir -p "${runtime_prefix}/share/linnet-licenses"
cp -R -X "${runtime_license_stage}/." \
  "${runtime_prefix}/share/linnet-licenses/"
build_predict_source="${runtime_build}/linnet-tools/build_predict"
[[ -x "${build_predict_source}" ]] || fail "patched build_predict output is missing"
mkdir -p "${runtime_prefix}/bin"
cp "${build_predict_source}" "${runtime_prefix}/bin/build_predict"

mkdir -p "${runtime_prefix}/include/rime"
while IFS= read -r -d '' header; do
  relative="${header#"${source_root}/src/"}"
  mkdir -p "${runtime_prefix}/include/$(dirname "${relative}")"
  cp "${header}" "${runtime_prefix}/include/${relative}"
done < <(find "${source_root}/src/rime" -type f \( -name '*.h' -o -name '*.hpp' \) -print0)
cp "${runtime_build}/src/rime/build_config.h" "${runtime_prefix}/include/rime/build_config.h"
cp -R "${source_root}/include/." "${runtime_prefix}/include/"
cp "${deps_stage}/Linnet/include/marisa.h" "${runtime_prefix}/include/marisa.h"
cp -R "${deps_stage}/Linnet/include/marisa" "${runtime_prefix}/include/marisa"
cp -R "${deps_stage}/Linnet/include/glog" "${runtime_prefix}/include/glog"
mkdir -p "${runtime_prefix}/include/rime/predict"
cp \
  "${source_root}/plugins/predict/src/predict_db.h" \
  "${source_root}/plugins/predict/src/predict_engine.h" \
  "${runtime_prefix}/include/rime/predict/"
/usr/bin/grep -Fq 'RIME_DLL bool Resolve(Context* ctx) const;' \
  "${runtime_prefix}/include/rime/predict/predict_engine.h" ||
  fail "patched predict SDK contract is missing"

expected_macho=(
  bin/build_predict bin/rime_deployer bin/rime_dict_manager bin/rime_patch bin/rime_table_decompiler
  lib/librime.${librime_version}.dylib
  lib/rime-plugins/librime-lua.dylib
  lib/rime-plugins/librime-octagram.dylib
  lib/rime-plugins/librime-predict.dylib
)
for relative in "${expected_macho[@]}"; do
  binary="${runtime_prefix}/${relative}"
  [[ -f "${binary}" ]] || fail "expected runtime artifact is missing"
  description="$(capture file "${binary}")"
  [[ "${description}" == *"Mach-O 64-bit"*" arm64"* && "${description}" != *universal* && "${description}" != *x86_64* ]] ||
    fail "runtime artifact is not thin arm64"
  while IFS= read -r dependency; do
    case "${dependency}" in
      @rpath/*|/usr/lib/*|/System/Library/Frameworks/*) ;;
      *) fail "runtime artifact has an unreviewed load path" ;;
    esac
  done < <(otool -L "${binary}" | tail -n +2 | awk '{print $1}')
done

build_predict_rpaths="$(otool -l "${runtime_prefix}/bin/build_predict" | awk '
  $1 == "cmd" && $2 == "LC_RPATH" { in_rpath = 1; next }
  in_rpath && $1 == "path" { print $2; in_rpath = 0 }
')"
[[ "${build_predict_rpaths}" == '@executable_path/../lib' ]] ||
  fail "build_predict runtime search path differs from contract"
predict_symbols="$(nm -gU "${runtime_prefix}/lib/rime-plugins/librime-predict.dylib" | c++filt)"
for symbol in \
  'rime::PredictEngine::Resolve(' \
  'rime::PredictEngine::LookupCopy(' \
  'rime::PredictEngineComponent::Shared('; do
  [[ "${predict_symbols}" == *"${symbol}"* ]] ||
    fail "patched predict runtime contract is missing"
done
smoke_input="${work_root}/build-predict-smoke.tsv"
smoke_database="${work_root}/build-predict-smoke.db"
printf 'hello\thello\t1\np/test\tfirst\t64\np/test\tsecond\t63\n' > "${smoke_input}"
run "${runtime_prefix}/bin/build_predict" "${smoke_database}" < "${smoke_input}"
[[ -s "${smoke_database}" ]] || fail "build_predict smoke failed"
ruby -e '
  header = File.binread(ARGV.fetch(0), 32).delete("\0")
  abort "unexpected predict database format" unless header == "Rime::Predict/2.0"
' "${smoke_database}" || fail "build_predict format contract failed"
invalid_pinyin_input="${work_root}/build-predict-invalid-pinyin.tsv"
invalid_pinyin_database="${work_root}/build-predict-invalid-pinyin.db"
printf 'p/test\tinvalid\t63\n' > "${invalid_pinyin_input}"
if "${runtime_prefix}/bin/build_predict" "${invalid_pinyin_database}" \
    < "${invalid_pinyin_input}" >/dev/null 2>&1; then
  fail "build_predict accepted an invalid compact pinyin rank"
fi

[[ -f "${runtime_prefix}/include/rime_api.h" &&
   -f "${runtime_prefix}/include/rime/engine.h" &&
   -f "${runtime_prefix}/include/glog/logging.h" &&
   -f "${runtime_prefix}/include/marisa.h" &&
   -f "${runtime_prefix}/include/marisa/stdio.h" &&
   -f "${runtime_prefix}/include/rime/predict/predict_engine.h" &&
   -f "${runtime_prefix}/include/rime/predict/predict_db.h" ]] ||
  fail "runtime SDK headers are incomplete"
[[ -d "${deps_stage}/Linnet/share/opencc" ]] || fail "OpenCC runtime data is missing"

publish_root="$(mktemp -d "${repo_root}/build/.rime-runtime-publish.XXXXXX")"
is_safe_runtime_transient "${publish_root}" || fail "unsafe runtime publish root"
runtime_transient_roots+=("${publish_root}")
mkdir -p "${publish_root}/dist" "${publish_root}/opencc" "${publish_root}/boost"
# Materialize the publication boundary without copying any build-machine
# extended attributes. The final App scan validates the shipped result.
run cp -R -X "${runtime_prefix}/." "${publish_root}/dist"
run cp -R -X "${deps_stage}/Linnet/share/opencc/." "${publish_root}/opencc"
run cp -R -X "${boost_root}/${boost_archive_root}/." "${publish_root}/boost"
[[ -d "${publish_root}/boost/boost" && -f "${publish_root}/boost/LICENSE_1_0.txt" ]] ||
  fail "Boost SDK tree is incomplete"
[[ "$(find "${publish_root}/boost" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')" == 2 ]] ||
  fail "Boost SDK tree has an unexpected top-level entry"
[[ -z "$(find "${publish_root}/boost" -type l -print -quit)" ]] ||
  fail "Boost SDK tree contains a symlink"
# Boost is a hash-locked upstream source input, not a shipped product artifact.
# Its source text may legitimately contain generic path examples. Compiled
# bytes remain covered by the final App artifact scan.

[[ ! -L "${dist_target}" && ! -L "${opencc_target}" && ! -L "${boost_target}" ]] ||
  fail "generated runtime target must not be a symlink"
mkdir -p "$(dirname "${dist_target}")" "$(dirname "${opencc_target}")" "$(dirname "${boost_target}")"
runtime_paths_share_device "$(dirname "${dist_target}")" \
  "$(dirname "${opencc_target}")" "$(dirname "${boost_target}")" ||
  fail "generated runtime targets cross a filesystem boundary"
publishing=1
if [[ -e "${dist_target}" ]]; then mv "${dist_target}" "${dist_backup}"; had_dist=1; fi
mv "${publish_root}/dist" "${dist_target}"
new_dist=1
if [[ -e "${opencc_target}" ]]; then mv "${opencc_target}" "${opencc_backup}"; had_opencc=1; fi
mv "${publish_root}/opencc" "${opencc_target}"
new_opencc=1
if [[ -e "${boost_target}" ]]; then mv "${boost_target}" "${boost_backup}"; had_boost=1; fi
mv "${publish_root}/boost" "${boost_target}"
new_boost=1
publishing=0

refresh_runtime_cache || fail "verified runtime cache refresh failed"
mkdir -p "$(dirname "${runtime_fingerprint_stamp}")"
printf '%s\n' "${runtime_fingerprint}" > "${runtime_fingerprint_stamp}.tmp"
mv "${runtime_fingerprint_stamp}.tmp" "${runtime_fingerprint_stamp}"

echo "build-rime-runtime: PASS (locked core/lua/predict patches; arm64 runtime)"
