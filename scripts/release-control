#!/usr/bin/env bash

# SPDX-License-Identifier: GPL-3.0-or-later

# Candidate tags request an Action build of a committed revision. Preview and
# publication tags authorize exact artifact bytes; tests remain explicit commands.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
repository="Ares-X/Linnet"
command_name="${1:-}"
release_dir="${2:-}"

fail() {
  echo "release-control: $*" >&2
  exit 1
}

usage() {
  echo "usage: scripts/release-control authorize ABSOLUTE_RELEASE_DIRECTORY" >&2
  echo "usage: scripts/release-control preview ABSOLUTE_RELEASE_DIRECTORY" >&2
  echo "       scripts/release-control {verify-local|verify-settings-ui|candidate}" >&2
  echo "       scripts/release-control verify-source CANDIDATE_REF COMMIT [--release]" >&2
  exit 64
}
case "${command_name}" in
  verify-local|verify-settings-ui|candidate) [[ "$#" -eq 1 ]] || usage ;;
  verify-source) [[ "$#" -eq 3 || ( "$#" -eq 4 && "$4" == --release ) ]] || usage ;;
  authorize|preview) [[ "$#" -eq 2 ]] || usage ;;
  *) usage ;;
esac

verify_source_tag() {
  local reference="$1" expected_revision="$2"
  [[ "${expected_revision}" =~ ^[0-9a-f]{40}$ &&
    "${reference}" =~ ^refs/tags/linnet-candidate/v[0-9]+\.[0-9]+\.[0-9]+-${expected_revision}$ ]] ||
    fail "invalid candidate reference"
  [[ "$(git -C "${repo_root}" rev-parse --verify "${reference}^{commit}")" == "${expected_revision}" &&
    "$(git -C "${repo_root}" rev-parse --verify HEAD^{commit})" == "${expected_revision}" ]] ||
    fail "candidate tag does not name the checked-out commit"
}

if [[ "${command_name}" == verify-source ]]; then
  verify_source_tag "$2" "$3"
  exit
fi

if [[ "${command_name}" == verify-settings-ui ]]; then
  cd "${repo_root}"
  echo "Settings UI automation controls the current desktop. Use a dedicated test session."
  exec tests/verify_visible_settings_fixture.sh --ui-test
fi

if [[ "${command_name}" == verify-local ]]; then
  cd "${repo_root}"
  ./action-build.sh release
  scripts/run_swiftlint.sh
  tests/verify_publication_owner.sh
  tests/verify_development.sh all
  exit
fi

if [[ "${command_name}" == authorize || "${command_name}" == preview ]]; then
  [[ "${release_dir}" == /* && -d "${release_dir}" && ! -L "${release_dir}" ]] ||
    fail "release directory is unsafe"
  release_dir="$(cd "${release_dir}" && pwd -P)"
fi

for required_command in git ruby; do
  command -v "${required_command}" >/dev/null 2>&1 ||
    fail "${required_command} is unavailable"
done
[[ "$(git -C "${repo_root}" remote get-url origin)" == \
  git@github.com:Ares-X/Linnet.git ]] || fail "origin is not Ares-X/Linnet over SSH"

revision="$(git -C "${repo_root}" rev-parse --verify HEAD^{commit})"
[[ "${revision}" =~ ^[0-9a-f]{40}$ ]] || fail "candidate revision is invalid"
version="$(sed -n \
  's/^MARKETING_VERSION = \([^[:space:]]*\)$/\1/p' \
  "${repo_root}/config/LinnetProduct.xcconfig")"
[[ "${version}" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] ||
  fail "product version is invalid"

if [[ "${command_name}" == authorize ]]; then
  verify_source_tag "refs/tags/linnet-candidate/v${version}-${revision}" "${revision}" >/dev/null
fi

if [[ "${command_name}" == candidate ]]; then
  candidate_ref="refs/tags/linnet-candidate/v${version}-${revision}"
  existing="$(git -C "${repo_root}" ls-remote origin "${candidate_ref}")" ||
    fail "candidate request lookup failed"
  if [[ -z "${existing}" ]]; then
    git -C "${repo_root}" push origin "${revision}:${candidate_ref}"
  elif [[ "${existing}" != "${revision}"$'\t'"${candidate_ref}" ]]; then
    fail "candidate request already names another object"
  fi
  echo "Action candidate requested for committed source ${revision}"
  exit
fi

for required_command in gh make; do
  command -v "${required_command}" >/dev/null 2>&1 ||
    fail "${required_command} is unavailable"
done
catalog_sequence="$("${repo_root}/package/data_release_metadata" \
  get-catalog-sequence "${repo_root}/config/linnet-data-releases.json")"

release_tool="${repo_root}/build/linnet-pack"
make -C "${repo_root}" --no-print-directory linnet-pack-tool
[[ -x "${release_tool}" && ! -L "${release_tool}" ]] ||
  fail "verified pack CLI was not produced"

LINNET_RELEASE_TOOL="${release_tool}" \
  "${repo_root}/package/verify_publication_artifacts" \
    "${release_dir}" "${version}" "${revision}"
candidate_identity="$("${repo_root}/package/release_candidate_identity" \
  "${release_dir}" "${version}" "${catalog_sequence}")"
[[ "${candidate_identity}" =~ ^sha256:([0-9a-f]{64})$ ]] ||
  fail "candidate archive identity is invalid"
candidate_digest="${BASH_REMATCH[1]}"
if [[ "${command_name}" == preview ]]; then
  authorization_tag="linnet-preview/v${version}-${revision}-h${candidate_digest}"
else
  authorization_tag="linnet-publication/v${version}-${revision}-h${candidate_digest}"
fi
authorization_ref="refs/tags/${authorization_tag}"

gh auth status --hostname github.com >/dev/null
# Authorization never uploads or repairs bytes after acceptance. It
# proves that all three Action-staged drafts still contain the accepted
# manifest-owned set, then creates an immutable Preview or stable publication
# tag consumed by release-ci.yml.
for channel in core data public; do
  GITHUB_REPOSITORY="${repository}" \
    "${repo_root}/package/stage_github_release" verify \
      "${channel}" "${release_dir}" "${version}" "${catalog_sequence}" \
      "${revision}"
done

existing="$(git -C "${repo_root}" ls-remote origin "${authorization_ref}")" ||
  fail "publication authorization lookup failed"
if [[ -z "${existing}" ]]; then
  git -C "${repo_root}" push origin "${revision}:${authorization_ref}"
elif [[ "${existing}" != "${revision}"$'\t'"${authorization_ref}" ]]; then
  fail "publication authorization already names another revision"
fi

echo "Linnet ${version} GitHub Action ${command_name} authorized from ${candidate_identity}"
