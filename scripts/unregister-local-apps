#!/usr/bin/env bash

set -euo pipefail

fail() {
  echo "unregister-local-apps: FAIL: $*" >&2
  exit 1
}

(( $# >= 2 )) || fail "usage: unregister-local-apps <Build/Products> <App>..."

products_root="${1%/}"
shift
[[ "${products_root}" == /*/Build/Products && "${products_root}" != *$'\n'* ]] ||
  fail "the products root is not an absolute Xcode Build/Products directory"

apps=("$@")
bundle_ids=()
for app in "${apps[@]}"; do
  [[ "${app}" == "${products_root}/"*.app && "${app}" != *$'\n'* ]] ||
    fail "an App is outside the declared products root: ${app}"
  relative="${app#"${products_root}/"}"
  [[ "/${relative}/" != *"/../"* && "/${relative}/" != *"/./"* ]] ||
    fail "an App path contains a traversal component: ${app}"
  info="${app}/Contents/Info.plist"
  if [[ -f "${info}" && ! -L "${info}" ]]; then
    bundle_id="$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "${info}")" ||
      fail "an App has no bundle identifier: ${app}"
    [[ "${bundle_id}" =~ ^[A-Za-z0-9.-]+$ ]] ||
      fail "an App has an invalid bundle identifier: ${app}"
    bundle_ids+=("${bundle_id}")
  fi
done

lsregister="/System/Library/Frameworks/CoreServices.framework/Versions/Current/Frameworks/LaunchServices.framework/Versions/Current/Support/lsregister"
[[ -x "${lsregister}" ]] || fail "LaunchServices registration tool is unavailable"

installed_app_path="${HOME}/Library/Input Methods/Linnet.app"
installed_settings_path="${installed_app_path}/Contents/Applications/Settings.app"

registered_paths_for_bundle_identifiers() {
  (( ${#bundle_ids[@]} > 0 )) || return 0
  /usr/bin/ruby -e '
    identifiers = ARGV
    STDIN.read.split(/^[-]{40,}\s*$/).each do |record|
      identifier = record[/^identifier:\s+([^\n]+)/, 1]&.strip
      next unless identifiers.include?(identifier)
      path = record[/^path:\s+(.+?)(?:\s+\(0x[0-9a-f]+\))?\s*$/i, 1]&.strip
      puts(path) if path
    end
  ' "${bundle_ids[@]}"
}

append_unregister_path() {
  local path="$1" existing
  case "${path}" in
    "${installed_app_path}"|"${installed_settings_path}") return 0 ;;
  esac
  [[ "${path}" == /*.app && "${path}" != / ]] ||
    fail "LaunchServices returned an unsafe App path: ${path}"
  for existing in "${unregister_paths[@]:-}"; do
    [[ "${existing}" != "${path}" ]] || return 0
  done
  unregister_paths+=("${path}")
}

unregister_paths=()
for app in "${apps[@]}"; do
  append_unregister_path "${app}"
done
while IFS= read -r registered_path; do
  [[ -n "${registered_path}" ]] && append_unregister_path "${registered_path}"
done < <("${lsregister}" -dump 2>/dev/null |
  registered_paths_for_bundle_identifiers | LC_ALL=C sort -u)

# Xcode's recursive registration can publish embedded Apps after the outer
# build command returns. Retire the complete observed set twice around that one
# queue, rather than sleeping once for every App.
for pass in 1 2; do
  for path in "${unregister_paths[@]}"; do
    "${lsregister}" -u -R "${path}" >/dev/null 2>&1 || true
  done
  [[ "${pass}" -eq 2 ]] || sleep 1
done

registry_dump="$("${lsregister}" -dump 2>/dev/null)" ||
  fail "LaunchServices registry could not be inspected"
registry_paths="$(
  printf '%s\n' "${registry_dump}" |
    sed -n 's/^path:[[:space:]]*//p' |
    sed -E 's/[[:space:]]+\(0x[0-9a-f]+\)$//'
)" || fail "LaunchServices registry could not be inspected"
for app in "${apps[@]}"; do
  if grep -Fqx -- "${app}" <<<"${registry_paths}"; then
    fail "local App remains registered: ${app}"
  fi
done
while IFS= read -r registered_path; do
  case "${registered_path}" in
    "${installed_app_path}"|"${installed_settings_path}") ;;
    *) fail "same-identity local App remains registered: ${registered_path}" ;;
  esac
done < <(printf '%s\n' "${registry_dump}" |
  registered_paths_for_bundle_identifiers | LC_ALL=C sort -u)

echo "Local App registration cleanup: PASS (${#apps[@]} exact paths)"
