+bool IsPinyinKey(const string& key) {
+  if (key.size() <= 2 || key[0] != 'p' || key[1] != '/')
+    return false;
+  return std::all_of(key.begin() + 2, key.end(),
+                     [](char ch) { return ch >= 'a' && ch <= 'z'; });
+}
+
+bool HasPinyinPrefix(const string& key) {
+  return key.size() >= 2 && key[0] == 'p' && key[1] == '/';
+}
