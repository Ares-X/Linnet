+bool IsValidRawField(const string& input) {
+  if (input.empty())
+    return false;
+  for (char ch : input) {
+    if (ch == '\0' || ch == '\t' || ch == '\r' || ch == '\n')
+      return false;
+  }
+  return true;
+}
+
+bool ParseWeight(const string& input, double* weight) {
+  if (!weight || input.empty())
+    return false;
+  const auto consume_digits = [&input](size_t* index) {
+    const size_t begin = *index;
+    while (*index < input.size() && input[*index] >= '0' &&
+           input[*index] <= '9') {
+      ++*index;
+    }
+    return *index > begin;
+  };
+  size_t index = 0;
+  if (!consume_digits(&index))
+    return false;
+  if (index < input.size() && input[index] == '.') {
+    ++index;
+    if (!consume_digits(&index))
+      return false;
+  }
+  if (index < input.size() &&
+      (input[index] == 'e' || input[index] == 'E')) {
+    ++index;
+    if (index < input.size() &&
+        (input[index] == '+' || input[index] == '-')) {
+      ++index;
+    }
+    if (!consume_digits(&index))
+      return false;
+  }
+  if (index != input.size())
+    return false;
+  errno = 0;
+  char* end = nullptr;
+  const double parsed = std::strtod(input.c_str(), &end);
+  if (errno == ERANGE || end != input.c_str() + input.size() ||
+      !std::isfinite(parsed) || parsed <= 0.0) {
+    return false;
+  }
+  *weight = parsed;
+  return true;
+}
+
+bool ParseInput(predict::RawData* data) {
+  if (!data)
+    return false;
+  const string input{std::istreambuf_iterator<char>(std::cin),
+                     std::istreambuf_iterator<char>()};
+  if (std::cin.bad() || input.empty() || input.back() != '\n' ||
+      input.find('\r') != string::npos || input.find('\0') != string::npos ||
+      !utf8::is_valid(input.begin(), input.end())) {
+    std::cerr << "input must be UTF-8 LF-terminated data without CR or NUL\n";
+    return false;
+  }
+  set<pair<string, string>> seen;
+  size_t line_number = 0;
+  size_t line_start = 0;
+  while (line_start < input.size()) {
+    ++line_number;
+    const size_t line_end = input.find('\n', line_start);
+    const string line = input.substr(line_start, line_end - line_start);
+    line_start = line_end + 1;
+    const size_t first_tab = line.find('\t');
+    const size_t second_tab = first_tab == string::npos
+                                  ? string::npos
+                                  : line.find('\t', first_tab + 1);
+    if (first_tab == string::npos || second_tab == string::npos ||
+        line.find('\t', second_tab + 1) != string::npos) {
+      std::cerr << "invalid input at line " << line_number
+                << ": expected exactly three TAB-separated fields\n";
+      return false;
+    }
+    const string key = line.substr(0, first_tab);
+    const string text = line.substr(first_tab + 1, second_tab - first_tab - 1);
+    const string weight_text = line.substr(second_tab + 1);
+    predict::RawEntry entry;
+    if (!IsValidRawField(key) || !IsValidRawField(text) ||
+        !ParseWeight(weight_text, &entry.weight)) {
+      std::cerr << "invalid input at line " << line_number
+                << ": raw key/text and positive finite weight are required\n";
+      return false;
+    }
+    if (!seen.emplace(key, text).second) {
+      std::cerr << "duplicate key/candidate at line " << line_number << "\n";
+      return false;
+    }
+    entry.text = text;
+    (*data)[key].push_back(std::move(entry));
+  }
