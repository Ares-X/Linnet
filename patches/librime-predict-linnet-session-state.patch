+vector<string> PredictionKeys(const string& context_query) {
+  if (context_query.empty() || context_query.front() == ' ' ||
+      context_query.back() == ' ')
+    return {};
+  vector<string> words;
+  size_t start = 0;
+  while (start < context_query.size()) {
+    const size_t end = context_query.find(' ', start);
+    const string word = context_query.substr(start, end - start);
+    size_t index = !word.empty() && word.front() == '\'' ? 1 : 0;
+    if (index == word.size())
+      return {};
+    for (; index < word.size(); ++index) {
+      const unsigned char ch = word[index];
+      if (ch < 'a' || ch > 'z')
+        return {};
+    }
+    words.push_back(word);
+    if (words.size() > 4)
+      return {};
+    if (end == string::npos)
+      break;
+    start = end + 1;
+  }
+
+  vector<string> keys;
+  const size_t max_words = (std::min)(size_t{4}, words.size());
+  for (size_t count = max_words; count > 0; --count) {
+    string key = "n/";
+    const size_t first = words.size() - count;
+    for (size_t i = first; i < words.size(); ++i) {
+      if (i != first)
+        key.push_back(' ');
+      key += words[i];
+    }
+    keys.push_back(std::move(key));
+  }
+  return keys;
+}
