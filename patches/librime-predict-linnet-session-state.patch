+}  // namespace
+
+bool PredictDb::InRange(const void* pointer, size_t bytes) const {
+  if (!pointer || !IsOpen())
+    return false;
+  const uintptr_t base = reinterpret_cast<uintptr_t>(address());
+  const uintptr_t value = reinterpret_cast<uintptr_t>(pointer);
+  return value >= base && value - base <= file_size() &&
+         bytes <= file_size() - (value - base);
+}
 
