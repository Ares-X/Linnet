+    return constraints;
+  for (const auto& start : graph.edges) {
+    for (const auto& end : start.second) {
+      for (const auto& spelling : end.second) {
+        if (spelling.second.type != kNormalSpelling)
+          continue;
+        const string text =
+            dict->primary_table()->GetSyllableById(spelling.first);
+        if (is_uppercase_entity(text)) {
+          constraints[start.first][end.first].insert(text);
+        }
+      }
+    }
+  }
+  return constraints;
+}
