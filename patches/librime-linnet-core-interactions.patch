+Context* Session::PrepareCompositionExit() {
+  if (!engine_)
+    return nullptr;
+  Engine* active_engine = engine_->active_engine();
+  if (active_engine != engine_.get()) {
+    auto* switcher = dynamic_cast<Switcher*>(active_engine);
+    if (!switcher)
+      return nullptr;
+    switcher->Deactivate();
+  }
+  return engine_->context();
+}
+
+bool Session::HasPendingClientState() const {
+  if (!commit_text_.empty())
+    return true;
+  if (!engine_)
+    return false;
+  if (!engine_->context()->input().empty())
+    return true;
+  Engine* active_engine = engine_->active_engine();
+  return active_engine != engine_.get() &&
+         !active_engine->context()->input().empty();
+}
