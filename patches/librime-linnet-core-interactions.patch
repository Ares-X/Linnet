+size_t ScriptSyllabifier::BuildMixedGraph(Dictionary* chinese, Dictionary* english,
+                                         const SyllableGraph& canonical) {
+  EdgeMap extra;
+  string lower = input_;
+  for (char& c : lower) if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+  for (size_t begin = 0; begin < lower.size(); ++begin) {
+    vector<Prism::Match> matches;
+    english->prism()->CommonPrefixSearch(lower.substr(begin), &matches);
+    for (const auto& match : matches) {
+      if (!match.length || (begin == 0 && match.length == lower.size())) continue;
+      const size_t end = begin + match.length;
+      const string key = lower.substr(begin, match.length);
+      if (!std::all_of(key.begin(), key.end(), [](char c) { return c >= 'a' && c <= 'z'; })) continue;
+      string stored_code = key;
+      for (char& c : stored_code) c += 'A' - 'a';
+      // Existing entity spellings already have a native Chinese dictionary
+      // entry and score. Do not create a second, differently weighted CPU/cpu.
+      const auto canonical_start = canonical.edges.find(begin);
+      if (canonical_start != canonical.edges.end()) {
+        const auto canonical_end = canonical_start->second.find(end);
+        if (canonical_end != canonical_start->second.end() &&
+            std::any_of(canonical_end->second.begin(), canonical_end->second.end(),
+                        [&](const auto& spelling) {
+          return chinese->primary_table()->GetSyllableById(spelling.first) == stored_code;
+        })) continue;
+      }
+      DictEntryIterator entries;
+      english->LookupWords(&entries, key, false);
+      while (!entries.exhausted()) {
+        const auto item = entries.Peek();
+        string word = item->text;
+        for (char& c : word) if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+        if (word == key && !translator_->blacklist().count(item->text) &&
+            item->code.size() == 1 &&
+            (key.size() > 1 || item->text == "a" || item->text == "I")) {
+          auto entry = New<DictEntry>(*item);
+          entry->weight += translator_->sentence_dictionary_weight();
+          entry->code[0] -= std::numeric_limits<SyllableId>::max();
+          syllable_graph_.syllable_codes[entry->code[0]] = stored_code;
+          entry->custom_code = stored_code + ' ';
+          const string typed = input_.substr(begin, match.length);
+          if (typed != key) entry->text = typed;
+          english_words_[begin][end].push_back(entry);
+          EdgeProperties props;
+          props.type = kNormalSpelling;
+          props.end_pos = end;
+          extra[begin][end][entry->code[0]] = props;
+        }
+        entries.Next();
+      }
+    }
+  }
+  if (extra.empty()) return 0;
+  Syllabifier mixed(translator_->delimiters(), false, true);
+  return mixed.BuildSyllableGraph(input_, *chinese->prism(), &syllable_graph_, &extra);
+}
