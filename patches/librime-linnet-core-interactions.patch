+    if (!records->GetNextRecord(&key, &value)) break;
+    // A strict lower bound skips every obsolete version of the last consumed
+    // key. Reads and drain share this durable range, not a tombstone scan.
+    next.cursor = key.substr(kMergeRecords.size()) + '\0';
+    if (merge_phase() == UserDbMergePhase::active) {
+      key.erase(0, kMergeRecords.size());
+      if (!Fetch(key, &value) || !Update(key, value)) return false;
+    } else if (!Erase(key)) return false;  // Unactivated staging has no effect.
+    if (std::chrono::steady_clock::now() >= deadline) break;
+  }
+  if (records->exhausted()) next = {};
+  return StoreUserDbMergeState(next) && CommitTransaction();
+}
