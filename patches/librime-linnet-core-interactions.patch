+    }
+    if (sentences_.size() == existing_count) {
+      leading_single_syllable_collision = single_syllable_collision;
+    }
+    sentence->Offset(start_);
+    sentence->set_preedit(mixed->GetPreeditString(*sentence));
+    if (auto dictionary = translator_->user_dict()) {
+      string code;
+      if (dictionary->TranslateCodeToString(sentence->code(), &code, &syllables.syllable_codes)) {
+        sentence->set_custom_code(code);
+      }
+    }
+    sentence->set_syllabifier(mixed);
+    sentences_.push_back(sentence);
+  }
+  // Keep each search's order, including lexical alternatives. An existing
+  // acronym sentence competes by its leading grammar score: CPU must not lose
+  // to CPU + zhan, while the weaker re + GI + on cannot displace region.
+  bool prefer_existing = prefer_chinese;
+  if (prefer_existing && !leading_single_syllable_collision &&
+      preserve_original_reading_ &&
+      existing_count < sentences_.size() &&
+      sentences_[existing_count]->weight() >= *baseline_weight) {
+    prefer_existing = false;
+  }
+  // Relaxing recall must not also relax the original first-choice score.
+  // A newly recovered path can remain useful without overtaking a Chinese
+  // guess while the user is still typing an ambiguous spelling.
+  // One ordinary Chinese syllable is also a complete interpretation of a
+  // short Latin word. Keep it first during continuous Chinese input; the
+  // alternative remains selectable and a learned choice retains priority.
+  if (prefer_existing && !leading_single_syllable_collision &&
+      existing_count < sentences_.size() &&
+      (!baseline_weight || sentences_[existing_count]->weight() >= *baseline_weight)) {
+    // A completed Chinese word after the last English span supplies a right
+    // boundary. Until then, preserve the normal Chinese path: "she" may still
+    // be the unfinished input for 设计, rather than an intended English word.
+    const auto& components = sentences_[existing_count]->components();
+    for (auto it = components.rbegin(); it != components.rend(); ++it) {
+      if (std::any_of(it->code.begin(), it->code.end(),
+                      [](SyllableId id) { return id < 0; })) break;
+      if (it->code.size() > 1) {
+        prefer_existing = false;
+        break;
+      }
+    }
+  }
+  if (!prefer_existing && baseline_weight && existing_count < sentences_.size() &&
+      *baseline_weight >= sentences_[existing_count]->weight()) {
+    prefer_existing = has_english(sentences_.front()->entry());
+  }
+  if (!prefer_existing && !chinese_completion) {
+    std::rotate(sentences_.begin(), std::next(sentences_.begin(), existing_count),
+                sentences_.end());
+  }
+  // Keep the independently supported English alternatives selectable. When Chinese
+  // remains preferred, give its partial phrase the next slot before each
+  // mixed sentence. Complete Chinese phrases retain their original priority.
+  mixed_follows_completions_ = chinese_completion;
+  mixed_interleaves_ = prefer_existing ||
+      (prefer_chinese && preserve_original_reading_);
