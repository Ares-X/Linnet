+
+bool LevelDb::StoreUserDbMergeState(const UserDbMergeState& state) {
+  if (!in_transaction()) return false;
+  if (state.phase == UserDbMergePhase::none) {
+    if (!Erase(kMergeHeader)) return false;
+  } else {
+    std::ostringstream header;
+    header << (state.phase == UserDbMergePhase::staging ? "staging " : "active ")
+           << state.remote_tick << ' ';
+    if (state.phase == UserDbMergePhase::active) header << state.local_tick << ' ';
+    header << std::quoted(state.cursor);
+    if (!Update(kMergeHeader, header.str())) return false;
+  }
+  db_->next_merge = state;
+  return true;
+}
+
+bool LevelDb::StageUserDbMerge(const string& key, const string& value) {
+  return in_transaction() && merge_phase() == UserDbMergePhase::staging &&
+         key >= " " && Update(kMergeRecords + key, value);
+}
+
+bool LevelDb::ActivateUserDbMerge() {
+  if (!in_transaction() || merge_phase() != UserDbMergePhase::staging) return false;
+  auto records = Query(kMergeRecords);
+  if (!records) return false;
+  string first, value;
+  if (!records->GetNextRecord(&first, &value)) return StoreUserDbMergeState({});
+  const auto local_tick = UserDbMerger::ReadTick(this);
+  const auto remote_tick = db_->merge.remote_tick;
+  if (!MetaUpdate("/tick", std::to_string((std::max)(local_tick, remote_tick))) ||
+      !MetaUpdate("/user_id", Service::instance().deployer().user_id)) return false;
+  return StoreUserDbMergeState({UserDbMergePhase::active, local_tick, remote_tick,
+                               first.substr(kMergeRecords.size())});
+}
+
+bool LevelDb::DrainUserDbMerge(std::chrono::steady_clock::time_point deadline) {
+  if (in_transaction() || merge_phase() == UserDbMergePhase::none ||
+      !BeginTransaction()) return false;
+  BOOST_SCOPE_EXIT(this_) {
+    if (this_->in_transaction()) this_->AbortTransaction();
+  } BOOST_SCOPE_EXIT_END
+  auto records = Query(kMergeRecords);
+  if (!records) return false;
+  auto next = db_->merge;
+  string key, value;
+  for (size_t count = 0; count < 64; ++count) {
+    if (!records->GetNextRecord(&key, &value)) break;
+    // A strict lower bound skips every obsolete version of the last consumed
+    // key. Reads and drain share this durable range, not a tombstone scan.
+    next.cursor = key.substr(kMergeRecords.size()) + '\0';
+    if (merge_phase() == UserDbMergePhase::active) {
