+bool Context::DeleteCandidate(size_t index) {
+  if (composition_.empty())
+    return false;
+  Segment& seg(composition_.back());
+  auto previous = seg.GetSelectedCandidate();
+  const size_t previous_index = seg.selected_index;
+  const size_t prepared = seg.menu ? seg.menu->candidate_count() : 0;
+  auto target = seg.menu ? seg.menu->GetCandidateAt(index) : nullptr;
+  if (!target)
+    return false;
+  seg.selected_index = index;
+  DLOG(INFO) << "Deleting candidate: " << target->text();
+  delete_notifier_(this);
+  // A pointer action on another candidate must not move keyboard focus.
+  // Refind the original text in the already-browsed window after reordering.
+  // Deleting the current selection retains Rime's normal successor behavior.
+  if (index != previous_index && previous && !composition_.empty()) {
+    auto menu = composition_.back().menu;
+    if (menu) {
+      const size_t count = menu->Prepare(prepared);
+      for (size_t next = 0; next < count; ++next) {
+        auto candidate = menu->GetCandidateAt(next);
+        if (candidate && candidate->text() == previous->text() &&
+            candidate->start() == previous->start() &&
+            candidate->end() == previous->end()) {
+          Highlight(next);
+          break;
+        }
+      }
+    }
+  }
+  return true;  // CAVEAT: this doesn't mean anything is deleted for sure
+}
 
