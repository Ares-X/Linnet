+bool Context::CommitRawInput() {
+  if (input_.empty()) {
+    AbortComposition();
+    return false;
+  }
+  // The live composition may cover only the text before an edited caret.
+  // Lifecycle exit owns the complete raw buffer, while retaining any explicit
+  // selection that is still valid for its prefix.
+  composition_.Reset(input_);
+  ClearNonConfirmedComposition();
+  // Switcher uses `dumb` to suppress committing its own display context.
+  // Lifecycle exit targets this root context's raw buffer, so that display
+  // option must not silently erase it. Avoid option notifications and restore
+  // the caller-owned state after the synchronous commit.
+  const bool restore_dumb = get_option("dumb");
+  if (restore_dumb)
+    options_["dumb"] = false;
+  const bool committed = Commit();
+  if (restore_dumb)
+    options_["dumb"] = true;
+  return committed;
+}
+
 string Context::GetCommitText() const {
   if (get_option("dumb"))
     return string();
