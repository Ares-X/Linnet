+namespace {
+namespace fs = std::filesystem;
+using Clock = std::chrono::steady_clock;
+
+// An isolated upstream-format snapshot, never a second live database.
+class SyncSnapshot : public UserDbWrapper<TextDb> {
+ public:
+  explicit SyncSnapshot(const string& name) : UserDbWrapper<TextDb>({}, name) {
+    loaded_ = true;
+  }
+  ~SyncSnapshot() { loaded_ = modified_ = false; }
+  bool Update(const string& key, const string& value) override {
+    UserDbValue entry;
+    return entry.Unpack(value) && TextDb::Update(key, value);
+  }
+  bool Equals(const SyncSnapshot& other) const {
+    return metadata_ == other.metadata_ && data_ == other.data_;
+  }
+};
+
+struct SyncIO {
+  enum class Work { waiting, publish, cancel };
+  path directory;
+  string user_id;
+  vector<string> names;
+  vector<an<SyncSnapshot>> incoming;
+  vector<an<SyncSnapshot>> outgoing;
+  std::mutex mutex;
+  std::condition_variable ready;
+  std::thread worker;
+  Work work = Work::waiting;
+  // 0=snapshots ready, 1=I/O pending, 2=worker finished, -1=failed.
+  std::atomic<int> result{1};
+  // 0=active, 1=publication committed, 2=cancelled. Cancellation cannot
+  // retract a rename that has already won this commit point.
+  std::atomic<int> publication{0};
+  void Request(Work next) {
+    { std::lock_guard<std::mutex> lock(mutex); work = next; }
+    ready.notify_one();
+  }
+  void Join() {
+    if (worker.joinable()) worker.join();
+  }
+  ~SyncIO() { Join(); }
+  void ReleaseSnapshots() { incoming.clear(); outgoing.clear(); names.clear(); }
+};
+
+an<SyncSnapshot> ReadSnapshot(const path& file, const string& name) {
+  if (!fs::is_regular_file(fs::symlink_status(file)))
+    throw std::runtime_error("invalid learning snapshot file");
+  auto snapshot = New<SyncSnapshot>(name);
+  UserDbHelper helper(snapshot);
+  if (!helper.UniformRestore(file, true) || !helper.IsUserDb() ||
+      helper.GetDbName() != name)
+    throw std::runtime_error("invalid learning snapshot identity");
+  return snapshot;
+}
+
+void ReadCloud(SyncIO& io) {
+  if (!fs::is_directory(io.directory))
+    throw std::runtime_error("learning sync directory is unavailable");
+  for (const auto& peer : fs::directory_iterator(io.directory)) {
+    if (!peer.is_directory() || peer.is_symlink() ||
+        peer.path().filename() == io.user_id) continue;
+    for (const auto& name : io.names) {
+      if (io.publication == 2) return;
+      const auto file = peer.path() / (name + UserDb::snapshot_extension());
+      if (!fs::exists(file)) continue;
+      io.incoming.push_back(ReadSnapshot(file, name));
+    }
+  }
+}
+
+void WriteCloud(SyncIO& io) {
+  const auto directory = io.directory / io.user_id;
+  if (io.publication == 2) return;
+  fs::create_directories(directory);
+  for (const auto& snapshot : io.outgoing) {
+    if (io.publication == 2) return;
+    const auto target = directory / (snapshot->name() + UserDb::snapshot_extension());
+    if (fs::exists(target) && snapshot->Equals(*ReadSnapshot(target, snapshot->name())))
+      continue;  // No changed learning: no cloud-file rewrite.
+    const auto temporary = directory / ("." + snapshot->name() + ".pending");
+    try {
+      if (!snapshot->Backup(temporary))
+        throw std::runtime_error("learning snapshot write failed");
+      int expected = 0;
+      if (!io.publication.compare_exchange_strong(expected, 1)) {
+        fs::remove(temporary);
+        return;
+      }
+      fs::rename(temporary, target);
+      expected = 1;
+      io.publication.compare_exchange_strong(expected, 0);
+    } catch (...) {
+      std::error_code ignored;
+      fs::remove(temporary, ignored);
+      throw;
+    }
+  }
+}
+
+void StartIO(const an<SyncIO>& io) {
+  try {
+    io->worker = std::thread([state = io.get()] {
+    int result = 2;
+    try {
+      ReadCloud(*state);
+      state->result.store(0, std::memory_order_release);
+      std::unique_lock<std::mutex> lock(state->mutex);
+      state->ready.wait(lock, [&] { return state->work != SyncIO::Work::waiting; });
+      const bool publish = state->work == SyncIO::Work::publish;
+      lock.unlock();
+      if (publish) WriteCloud(*state);
+    } catch (const std::exception& error) {
+      LOG(ERROR) << "learning sync: " << error.what();
+      result = -1;
+    }
+    state->ReleaseSnapshots();
+    state->result.store(result, std::memory_order_release);
+    });
+  } catch (...) {
+    io->result.store(-1, std::memory_order_release);
+    throw;
+  }
+}
+
+struct LiveSync {
+  an<SyncIO> io;
+  // Borrow the same canonical instances as input sessions. Holding them for
+  // the cycle makes synchronization independent of schema/client lifetimes.
+  map<string, an<Db>> databases;
+  size_t prepared = 0;
+  size_t imported = 0;
+  size_t exported = 0;
+  the<DbSource> source;  // Only a worker-owned in-memory incoming snapshot.
+  bool source_complete = false;
+  an<SyncSnapshot> snapshot;
+  uint64_t snapshot_revision = 0;
+  an<DbAccessor> records;
+  bool writing = false;
+  bool deferred = false;
+
+  int Step() {
+    const int result = io->result.load(std::memory_order_acquire);
+    if (result == -1) return result;
+    if (result == 1) return 3;
+    if (writing) return result == 2 ? (deferred ? 2 : 0) : 3;
+    const auto deadline = Clock::now() + std::chrono::milliseconds(1);
+    auto* component = dynamic_cast<UserDictionaryComponent*>(
+        UserDictionary::Require("user_dictionary"));
+    if (!component) return -1;
+    if (prepared < io->names.size()) {
+      const auto& name = io->names[prepared];
+      an<Db> database;
+      if (!component->PrepareDb(name, &database)) return 3;
+      if (!database || !dynamic_cast<LevelDb*>(database.get()) ||
+          database->disabled() || !database->loaded()) return -1;
+      databases.emplace(name, std::move(database));
+      ++prepared;
+      return 1;
+    }
+    // A committed word remains reversible for three seconds. Idle input must
+    // not leave that expired learning transaction blocking synchronization.
+    for (const auto& item : databases) {
+      auto* transaction = dynamic_cast<Transactional*>(item.second.get());
+      if (transaction->transaction_expired() && !transaction->CommitTransaction())
+        return -1;
+    }
+    string key, value;
+    if (imported < io->incoming.size()) {
+      const auto& incoming = io->incoming[imported];
+      const auto& database = databases.at(incoming->name());
+      auto* level = dynamic_cast<LevelDb*>(database.get());
+      if (level->in_transaction()) return 1;  // Preserve local undo.
+      if (!source && level->merge_phase() != UserDbMergePhase::none)
+        return level->DrainUserDbMerge(deadline) ? 1 : -1;
+      if (!level->BeginTransaction()) return -1;
+      BOOST_SCOPE_EXIT(level) {
+        if (level->in_transaction()) level->AbortTransaction();
+      } BOOST_SCOPE_EXIT_END
+      if (!source) {
+        if (!level->StartUserDbMerge(UserDbMerger::ReadTick(incoming.get(), 0)) ||
+            !level->CommitTransaction()) return -1;
+        source = std::make_unique<DbSource>(incoming.get());
+        source_complete = false;
+        return 1;
+      }
+      if (source_complete) {
+        if (!level->ActivateUserDbMerge() || !level->CommitTransaction()) return -1;
+        source.reset(); ++imported;
+        return 1;
+      }
+      for (size_t count = 0; count < 64; ++count) {
+        if (!source->Get(&key, &value)) { source_complete = true; break; }
+        if (!level->StageUserDbMerge(key, value)) return -1;
+        if (Clock::now() >= deadline) break;
+      }
+      return level->CommitTransaction() ? 1 : -1;
+    }
+    if (exported < io->names.size()) {
+      const auto& name = io->names[exported];
+      const auto& database = databases.at(name);
+      auto* level = dynamic_cast<LevelDb*>(database.get());
+      if (level->merge_phase() != UserDbMergePhase::none) {
+        if (level->in_transaction()) return 1;
+        return level->DrainUserDbMerge(deadline) ? 1 : -1;
+      }
+      if (snapshot && snapshot_revision != level->write_revision()) {
+        deferred = true;
+        snapshot.reset();
+        records.reset(); ++exported;
+        return 1;
+      }
+      if (!snapshot) {
+        if (level->in_transaction()) return 1;
+        snapshot = New<SyncSnapshot>(name);
+        snapshot_revision = level->write_revision();
+        DbSource metadata(database.get());
+        while (metadata.MetaGet(&key, &value)) snapshot->MetaUpdate(key, value);
+        snapshot->MetaUpdate("/user_id", io->user_id);
+        records = database->QueryAll();
+      }
+      if (!records) return -1;
+      for (size_t count = 0; count < 64; ++count) {
+        if (!records->GetNextRecord(&key, &value)) {
+          io->outgoing.push_back(std::move(snapshot));
+          records.reset(); ++exported;
+          break;
+        }
+        if (!snapshot->Update(key, value)) return -1;
+        if (Clock::now() >= deadline) break;
+      }
+      return 1;
+    }
+    writing = true;
+    io->result.store(1, std::memory_order_release);
+    io->Request(SyncIO::Work::publish);
+    return 1;
+  }
+};
+
+the<LiveSync> live_sync;
+// The next cycle cannot overtake an already-committed old publication.
+an<SyncIO> outstanding_io;
+}  // namespace
+
+int UserDictManager::SynchronizeIncrementally(
+    const char* sync_directory, const char* const* dictionary_names) {
+  if (!sync_directory) {
+    if (outstanding_io) outstanding_io->publication.exchange(2);
+    live_sync.reset();
+    if (outstanding_io) outstanding_io->Request(SyncIO::Work::cancel);
+    return 0;
+  }
+  try {
+    if (!live_sync) {
+      if (outstanding_io) {
+        const int pending = outstanding_io->result.load(std::memory_order_acquire);
+        if (pending == 0 || pending == 1) return 3;
+      }
+      auto io = New<SyncIO>();
+      const auto& deployer = Service::instance().deployer();
+      io->directory = path(sync_directory);
+      if (!dictionary_names || !*dictionary_names) return -1;
+      for (auto name = dictionary_names; *name; ++name)
+        io->names.emplace_back(*name);
+      io->user_id = deployer.user_id;
+      if (io->user_id.empty() || path(io->user_id).filename() != path(io->user_id) ||
+          io->user_id == "." || io->user_id == "..") return -1;
+      live_sync = std::make_unique<LiveSync>();
+      live_sync->io = outstanding_io = io;
+      StartIO(io);
+      return 3;
+    }
+    const int result = live_sync->Step();
+    if (result != 1 && result != 3) SynchronizeIncrementally(nullptr);
+    return result;
+  } catch (const std::exception& error) {
+    LOG(ERROR) << "learning sync: " << error.what();
+    SynchronizeIncrementally(nullptr);
+    return -1;
+  }
+}
+
+void UserDictManager::CancelAndWaitForIncrementalSynchronization() {
+  SynchronizeIncrementally(nullptr);
+  if (outstanding_io) {
+    outstanding_io->Join();
+    outstanding_io.reset();
+  }
+  auto* component = dynamic_cast<UserDictionaryComponent*>(
+      UserDictionary::Require("user_dictionary"));
+  if (component) component->WaitForPendingDbOpens();
+}
+}  // namespace rime
