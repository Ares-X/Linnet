+static bool is_uppercase_entity(const string& text) {
+  return text.size() >= 2 && text.size() <= 6 &&
+         std::all_of(text.begin(), text.end(), [](char byte) {
+           return byte >= 'A' && byte <= 'Z';
+         });
+}
+
+static EntityConstraints find_entity_constraints(const SyllableGraph& graph,
+                                                  Dictionary* dict) {
+  EntityConstraints constraints;
+  if (!dict || !dict->primary_table())
+    return constraints;
+  for (const auto& start : graph.edges) {
+    for (const auto& end : start.second) {
+      for (const auto& spelling : end.second) {
+        if (spelling.first == kExplicitEntitySyllable)
+          continue;
+        if (spelling.second.type != kNormalSpelling)
+          continue;
+        const string text =
+            dict->primary_table()->GetSyllableById(spelling.first);
+        if (is_uppercase_entity(text)) {
+          constraints[start.first][end.first].insert(text);
+        }
+      }
+    }
+  }
+  return constraints;
+}
